/-! ## 1. Primary parts and divisibility depth -/

/-- The `p`-primary part `G[p^∞] = {x | ∃ k, p ^ k • x = 0}` of an additive commutative group. -/
def primaryPart (G : Type*) [AddCommGroup G] (p : ℕ) : AddSubgroup G where
  carrier := {x | ∃ k : ℕ, p ^ k • x = 0}
  zero_mem' := ⟨0, by simp⟩
  add_mem' := by
    rintro x y ⟨a, ha⟩ ⟨b, hb⟩
    refine ⟨a + b, ?_⟩
    have h1 : p ^ (a + b) • x = 0 := by
      rw [pow_add, mul_comm, mul_smul, ha, smul_zero]
    have h2 : p ^ (a + b) • y = 0 := by
      rw [pow_add, mul_smul, hb, smul_zero]
    rw [smul_add, h1, h2, add_zero]
  neg_mem' := by
    rintro x ⟨k, hk⟩
    exact ⟨k, by rw [smul_neg, hk, neg_zero]⟩

/-- `t` is divisible by `p ^ j`, i.e. `t ∈ p^j • M`. -/
def PDvd {M : Type*} [AddCommGroup M] (p j : ℕ) (t : M) : Prop :=
  ∃ y : M, p ^ j • y = t

/-- Codex's divisibility depth `depth_M(t) = max {j ≥ 0 : t ∈ p^j M}`.
It is only meaningful for `t ≠ 0` in a module killed by some power of `p` (see the target
`depth_spec`). For `t = 0` the set is unbounded and `sSup` returns the junk value `0`:
**never use `depth` of the zero element** (Codex: "Do not assign a finite truncated depth to the
zero element"). The definitions below only ever apply `depth` to nonzero witnesses. -/
noncomputable def depth {M : Type*} [AddCommGroup M] (p : ℕ) (t : M) : ℕ :=
  sSup {j : ℕ | PDvd p j t}

/-! ## 2. The witness ideal `J_E` -/

/-- The primes outside a finite exceptional set `S0` (Codex's `P`). -/
def primesOutside (S0 : Finset ℕ) : Set ℕ := {p | p.Prime ∧ p ∉ S0}

/-- Codex's `h_p = min {depth(t(p,S)) : t(p,S) ≠ 0}`, with value `⊤ = ∞` if no witness is nonzero.
`W p` indexes the admissible conductors `S` at `p`; `t p S` is the degree-two witness. -/
noncomputable def hInf {W : ℕ → Type*} {M : (p : ℕ) → W p → Type*} [∀ p S, AddCommGroup (M p S)]
    (t : ∀ p S, M p S) (p : ℕ) : ℕ∞ :=
  ⨅ (S : W p) (_ : t p S ≠ 0), ((depth p (t p S) : ℕ) : ℕ∞)

/-- `v_p(a)` with the convention `v_p(0) = ∞`. -/
noncomputable def vInf (p : ℕ) (a : ℤ) : ℕ∞ :=
  if a = 0 then ⊤ else ((padicValInt p a : ℕ) : ℕ∞)

/-- Codex's witness ideal `J_E = {a ∈ ℤ : v_p(a) ≥ h_p for every p ∈ P}` (as a set). -/
def JE {W : ℕ → Type*} {M : (p : ℕ) → W p → Type*} [∀ p S, AddCommGroup (M p S)]
    (t : ∀ p S, M p S) (P : Set ℕ) : Set ℤ :=
  {a | ∀ p ∈ P, hInf t p ≤ vInf p a}

/-! ## 3. Group rings, augmentation ideals, graded pieces -/

/-- The augmentation `R[G] → R`, `∑ a_g g ↦ ∑ a_g` (induced by the trivial character). -/
noncomputable def augHom (R : Type*) [CommRing R] (G : Type*) [CommGroup G] :
    MonoidAlgebra R G →ₐ[R] R :=
  MonoidAlgebra.lift R R G 1

/-- The augmentation ideal `I ⊆ R[G]` (commutative `G`; Ota's `G_S` is abelian). -/
noncomputable def augIdeal (R : Type*) [CommRing R] (G : Type*) [CommGroup G] : Ideal (MonoidAlgebra R G) :=
  RingHom.ker (augHom R G)

/-- The graded piece `I^r / I^(r+1)`. -/
abbrev gr (R : Type*) [CommRing R] (G : Type*) [CommGroup G] (r : ℕ) : Type _ :=
  ↥((augIdeal R G) ^ r) ⧸ Submodule.comap ((augIdeal R G) ^ r).subtype ((augIdeal R G) ^ (r + 1))

/-- The degree-two class of `θ` in `I²/I³` (Codex's `t(p,S)`), defined as `0` when `θ ∉ I²`
(that case never occurs under the imported Ota input; the junk value only makes the map total). -/
noncomputable def cls2 {R : Type*} [CommRing R] {G : Type*} [CommGroup G]
    (θ : MonoidAlgebra R G) : gr R G 2 := by
  classical
  exact if h : θ ∈ (augIdeal R G) ^ 2 then Submodule.Quotient.mk ⟨θ, h⟩ else 0

/-! ## 4. General (not necessarily commutative) augmentation, as a ℤ-submodule (stretch target) -/

/-- The augmentation ideal of `ℤ[G]` for an arbitrary group, as a ℤ-submodule
(powers are then products of ℤ-submodules of the ℤ-algebra `ℤ[G]`). -/
noncomputable def augSubZ (G : Type*) [Group G] : Submodule ℤ (MonoidAlgebra ℤ G) :=
  LinearMap.ker (MonoidAlgebra.lift ℤ ℤ G 1).toLinearMap

