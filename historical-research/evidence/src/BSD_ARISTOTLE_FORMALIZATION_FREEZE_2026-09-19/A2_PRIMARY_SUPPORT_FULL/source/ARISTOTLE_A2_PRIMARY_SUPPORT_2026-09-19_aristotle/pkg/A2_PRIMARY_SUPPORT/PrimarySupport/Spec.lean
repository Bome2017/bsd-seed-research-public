import PrimarySupport.Defs

/-!
# A2 — frozen target statements

Every target of package A2 is a `Prop` defined here; `Targets.lean` must prove each with exactly
this statement. FROZEN (SHA-256 in `ACCEPTANCE_TESTS.md`).

All statements are abstract group theory / elementary number theory. Arithmetic inputs about the
elliptic curve (e.g. Cassels–Tate) appear only as explicit hypotheses and are never proved here.
Proving these statements proves NOTHING about FIN or FORMULA for any curve.

WARNING. Formalizing WC proves only the implication from the stated witness-content antecedent.
It does not establish that the antecedent is easier than FIN or that FIN has been reduced.
(This package formalizes the support/assembly infrastructure used by WC; the same caveat applies.)
-/

namespace PrimarySupport
namespace Spec

/-! ## P. Primary parts and assembly (Codex `FORMALIZABLE_GAPS.md` B3) -/

/-- P1. A group without `p`-torsion has trivial `p`-primary part. -/
def Primary_zero_of_torsionfree : Prop :=
  ∀ (G : Type) [AddCommGroup G] (p : ℕ), p.Prime →
    (∀ x : G, p • x = 0 → x = 0) → primaryPart G p = ⊥

/-- P2. Every element of a torsion group is a finite sum of elements of primary parts. -/
def Torsion_decomposition : Prop :=
  ∀ (G : Type) [AddCommGroup G], AddMonoid.IsTorsion G →
    ∀ x : G, ∃ (T : Finset ℕ) (f : ℕ → G),
      (∀ p ∈ T, p.Prime ∧ f p ∈ primaryPart G p) ∧ x = ∑ p ∈ T, f p

/-- P3. Assembly: torsion + zero primary parts outside a finite set `T` + finite primary parts on `T`
⇒ finite. -/
def Assembly : Prop :=
  ∀ (G : Type) [AddCommGroup G] (T : Finset ℕ), AddMonoid.IsTorsion G →
    (∀ p, p.Prime → p ∉ T → primaryPart G p = ⊥) →
    (∀ p ∈ T, (primaryPart G p : Set G).Finite) → Finite G

/-- P4. Assembly in exactly the shape of WC (3): zero `p`-part for good `p ∤ A`, finite `p`-part for
good `p ∣ A`, finite `p`-parts on the exceptional set `S0` ⇒ finite. -/
def Assembly_WC_shape : Prop :=
  ∀ (G : Type) [AddCommGroup G] (S0 : Finset ℕ) (A : ℤ), AddMonoid.IsTorsion G → A ≠ 0 →
    (∀ p ∈ primesOutside S0, ¬ (p : ℤ) ∣ A → primaryPart G p = ⊥) →
    (∀ p ∈ primesOutside S0, (primaryPart G p : Set G).Finite) →
    (∀ p ∈ S0, p.Prime → (primaryPart G p : Set G).Finite) → Finite G

/-- P5. Exact separation: for a torsion group, finiteness is equivalent to the CONJUNCTION of
"every primary part is finite" and "only finitely many primary parts are nonzero". -/
def Finite_iff_local_and_support : Prop :=
  ∀ (G : Type) [AddCommGroup G], AddMonoid.IsTorsion G →
    (Finite G ↔ (∀ p, p.Prime → (primaryPart G p : Set G).Finite) ∧
                {p | p.Prime ∧ primaryPart G p ≠ ⊥}.Finite)

/-! ## CM. Countermodels: neither conjunct of P5 implies the other or finiteness. -/

/-- CM1. Every primary part is finite, infinitely many are nonzero, and the group is infinite:
`⨁_p ZMod p`. -/
def CM_each_local_finite : Prop :=
  AddMonoid.IsTorsion (Π₀ p : Nat.Primes, ZMod (p : ℕ)) ∧
  (∀ p : ℕ, p.Prime →
    (primaryPart (Π₀ q : Nat.Primes, ZMod (q : ℕ)) p : Set (Π₀ q : Nat.Primes, ZMod (q : ℕ))).Finite) ∧
  {p : ℕ | p.Prime ∧ primaryPart (Π₀ q : Nat.Primes, ZMod (q : ℕ)) p ≠ ⊥}.Infinite ∧
  ¬ Finite (Π₀ p : Nat.Primes, ZMod (p : ℕ))

/-- CM1'. Finite prime support without finite primary parts: `ℕ →₀ ZMod 2`. -/
def CM_finite_support : Prop :=
  AddMonoid.IsTorsion (ℕ →₀ ZMod 2) ∧
  {p | p.Prime ∧ primaryPart (ℕ →₀ ZMod 2) p ≠ ⊥}.Finite ∧
  ¬ Finite (ℕ →₀ ZMod 2)

/-! ## J. The depth ideal and finite prime support (Codex `WITNESS_CONTENT_THEOREM.md` §1) -/

/-- J1. `J(P, h)` is an ideal of `ℤ`. -/
def JOf_ideal : Prop :=
  ∀ (P : Set ℕ) (h : ℕ → ℕ∞), (∀ p ∈ P, p.Prime) →
    (0 : ℤ) ∈ JOf P h ∧ (∀ a b, a ∈ JOf P h → b ∈ JOf P h → a + b ∈ JOf P h) ∧
    (∀ c a, a ∈ JOf P h → c * a ∈ JOf P h)

/-- J2. `J(P, h)` is nonzero exactly when every `h p` is finite and only finitely many are positive. -/
def JOf_ne_zero_iff : Prop :=
  ∀ (P : Set ℕ) (h : ℕ → ℕ∞), (∀ p ∈ P, p.Prime) →
    ((∃ a ∈ JOf P h, a ≠ 0) ↔ (∀ p ∈ P, h p ≠ ⊤) ∧ (posSupport P h).Finite)

/-- J3. In that case `J(P, h)` is generated by `∏ p ^ h(p)` over the positive support. -/
def JOf_generator : Prop :=
  ∀ (P : Set ℕ) (h : ℕ → ℕ∞), (∀ p ∈ P, p.Prime) → (∀ p ∈ P, h p ≠ ⊤) →
    ∀ hfin : (posSupport P h).Finite,
      JOf P h = {a | (∏ p ∈ hfin.toFinset, (p : ℤ) ^ (h p).toNat) ∣ a}

/-- J4. A fixed nonzero `A ∈ J(P, h)`: only primes dividing `A` can have positive depth; hence the
positive support is finite. -/
def Positive_depth_divides : Prop :=
  ∀ (P : Set ℕ) (h : ℕ → ℕ∞) (A : ℤ), (∀ p ∈ P, p.Prime) → A ≠ 0 → A ∈ JOf P h →
    posSupport P h ⊆ {p | (p : ℤ) ∣ A} ∧ (posSupport P h).Finite ∧ (∀ p ∈ P, h p ≠ ⊤)

/-- CM2. Nonzero local witnesses at every prime do NOT give finite support: the witness
`p² ∈ ZMod (p³)` is nonzero but divisible by `p` at every prime, and the constant depth function 2
cuts out `J = {0}`. -/
def CM_nonzero_everywhere : Prop :=
  (∀ p : ℕ, p.Prime →
    ((p : ZMod (p ^ 3)) ^ 2 ≠ 0 ∧ ∃ y : ZMod (p ^ 3), p • y = (p : ZMod (p ^ 3)) ^ 2)) ∧
  JOf {p | p.Prime} (fun _ => 2) = {0}

/-! ## L. Finite free lattice content (Codex `FORMALIZABLE_GAPS.md` A3; WC §4 "Descent to ℤ") -/

/-- L1. `z ∈ m·ℤ^n` iff `m` divides the content. -/
def Content_dvd_iff : Prop :=
  ∀ (n : ℕ) (z : Fin n → ℤ) (m : ℤ), (∃ y : Fin n → ℤ, z = m • y) ↔ m ∣ content z

/-- L2. The content is nonnegative and vanishes only at `z = 0`. -/
def Content_basic : Prop :=
  ∀ (n : ℕ) (z : Fin n → ℤ), 0 ≤ content z ∧ (content z = 0 ↔ z = 0)

/-- L3. The content is invariant under unimodular change of basis. -/
def Content_unimodular : Prop :=
  ∀ (n : ℕ) (U : Matrix (Fin n) (Fin n) ℤ), IsUnit U.det →
    ∀ z : Fin n → ℤ, content (U.mulVec z) = content z

/-- L4. `z = c · z₀` with `z₀` primitive (content 1). -/
def Exists_primitive : Prop :=
  ∀ (n : ℕ) (z : Fin n → ℤ), z ≠ 0 → ∃ z₀ : Fin n → ℤ, content z₀ = 1 ∧ z = content z • z₀

/-- L5. `p`-adic form: for `z ≠ 0`, `z ∈ p^j ℤ^n` iff `j ≤ v_p(content z)`. -/
def Content_padic : Prop :=
  ∀ (n : ℕ) (z : Fin n → ℤ) (p j : ℕ), p.Prime → z ≠ 0 →
    ((∃ y : Fin n → ℤ, z = ((p : ℤ) ^ j) • y) ↔ j ≤ padicValInt p (content z))

/-- L6. Finite version over `ZMod (p^k)` with the truncation case explicit: the reduction of `z`
lies in `p^j·(ZMod p^k)^n` iff `p^(min j k)` divides the content. -/
def Content_mod_pk : Prop :=
  ∀ (n : ℕ) (z : Fin n → ℤ) (p j k : ℕ), p.Prime →
    ((∃ y : Fin n → ZMod (p ^ k), reduceMod (p ^ k) z = (p ^ j) • y) ↔
      ((p : ℤ) ^ (min j k)) ∣ content z)

/-- L7. Descent to ℤ with a primitive comparison (Codex WC §4): if outside an explicit finite set `B`
the depth is bounded by the content valuation of a fixed nonzero lattice vector, and the depth is
finite on `B`, then `J(P, h)` contains a nonzero integer. -/
def Content_bounds_J : Prop :=
  ∀ (P : Set ℕ) (h : ℕ → ℕ∞) (B : Finset ℕ) (n : ℕ) (z : Fin n → ℤ),
    (∀ p ∈ P, p.Prime) → z ≠ 0 →
    (∀ p ∈ P, p ∉ B → h p ≤ (padicValInt p (content z) : ℕ)) →
    (∀ p ∈ P, p ∈ B → h p ≠ ⊤) →
    ∃ A : ℤ, A ≠ 0 ∧ A ∈ JOf P h

/-! ## B. Global lattice descent vs local finiteness (Codex `ALGEBRAIC_REDUCTION_LEMMAS.md` §B),
valuation model: `d_p ∈ Z_p \ {0}` is recorded by `v p = v_p(d_p)`, since `d_p Z_p = p^(v_p d_p) Z_p`. -/

/-- B1. (1) ⟺ (2): a nonzero integer lies in every local ideal iff only finitely many are proper. -/
def LemmaB_valuation : Prop :=
  ∀ v : ℕ → ℕ,
    (∃ A : ℤ, A ≠ 0 ∧ ∀ p : ℕ, p.Prime → (p : ℤ) ^ v p ∣ A) ↔ {p | p.Prime ∧ v p ≠ 0}.Finite

/-- B2. (1) ⟺ (3): the product of the local cokernels is finite iff only finitely many are nonzero. -/
def LemmaB_cokernel : Prop :=
  ∀ v : ℕ → ℕ,
    Finite (∀ p : Nat.Primes, ZMod ((p : ℕ) ^ v p)) ↔ {p | p.Prime ∧ v p ≠ 0}.Finite

/-- CM3. Codex's profinite example (`d_2 = d_5 = 1`, `d_3 = 9`, `d_p = p²` for `p ≥ 7`): every local
cokernel is finite, their product is infinite, and no nonzero integer lies in every local ideal. -/
def CM_profinite_perfectness : Prop :=
  let v : ℕ → ℕ := fun p => if p = 2 ∨ p = 5 then 0 else 2
  (∀ p : Nat.Primes, Finite (ZMod ((p : ℕ) ^ v p))) ∧
  ¬ Finite (∀ p : Nat.Primes, ZMod ((p : ℕ) ^ v p)) ∧
  (∀ A : ℤ, (∀ p : ℕ, p.Prime → (p : ℤ) ^ v p ∣ A) → A = 0)

/-! ## H. FIN does not determine the order (Codex `ALGEBRAIC_REDUCTION_LEMMAS.md` §H) -/

/-- H0. A finite abelian group is the product of its primary parts (cardinality form). -/
def Card_eq_prod_primary : Prop :=
  ∀ (G : Type) [AddCommGroup G] [Finite G],
    Nat.card G = ∏ p ∈ (Nat.card G).primeFactors, Nat.card (primaryPart G p)

/-- H2. The abstract order consequence. The square hypothesis is the IMPORTED Cassels–Tate input
(alternating nondegenerate pairing on finite Sha); the 2-, 3-, 5-parts are the retained seed data.
Conclusion: `#G = 9 t²` with `gcd(t, 30) = 1` — and NOT `#G = 9` (see CM4). -/
def Order_nine_t_sq : Prop :=
  ∀ (G : Type) [AddCommGroup G] [Finite G],
    Nat.card (primaryPart G 2) = 1 → Nat.card (primaryPart G 3) = 9 →
    Nat.card (primaryPart G 5) = 1 →
    (∀ p, p.Prime → p ≠ 2 → IsSquare (Nat.card (primaryPart G p))) →
    ∃ t : ℕ, Nat.card G = 9 * t ^ 2 ∧ Nat.Coprime t 30

/-- CM4. `(ZMod 3)² × (ZMod 7)²` satisfies every hypothesis of H2 and has order 441 ≠ 9: FIN-type
data does not force `#Sha = 9`. -/
def CM_order_441 : Prop :=
  Nat.card (primaryPart ((ZMod 3 × ZMod 3) × (ZMod 7 × ZMod 7)) 2) = 1 ∧
  Nat.card (primaryPart ((ZMod 3 × ZMod 3) × (ZMod 7 × ZMod 7)) 3) = 9 ∧
  Nat.card (primaryPart ((ZMod 3 × ZMod 3) × (ZMod 7 × ZMod 7)) 5) = 1 ∧
  (∀ p, p.Prime → p ≠ 2 →
    IsSquare (Nat.card (primaryPart ((ZMod 3 × ZMod 3) × (ZMod 7 × ZMod 7)) p))) ∧
  Nat.card ((ZMod 3 × ZMod 3) × (ZMod 7 × ZMod 7)) = 441

/-! ## Stretch targets (not required for A2_FULL) -/

/-- S1. Abstract Cassels–Tate consequence: a finite abelian group with a nondegenerate alternating
biadditive pairing into a CYCLIC group `ZMod N` has square order. (The target must be cyclic — S2.) -/
def Alternating_square : Prop :=
  ∀ (G : Type) [AddCommGroup G] [Finite G] (N : ℕ) (β : G →+ G →+ ZMod N),
    (∀ x, β x x = 0) → (∀ x, (∀ y, β x y = 0) → x = 0) → IsSquare (Nat.card G)

/-- S2. Trap: with a NON-cyclic target the conclusion of S1 fails (cross product on `(ZMod 2)^3`,
order 8). -/
def CM_noncyclic_target : Prop :=
  ∃ β : (Fin 3 → ZMod 2) →+ (Fin 3 → ZMod 2) →+ (Fin 3 → ZMod 2),
    (∀ x, β x x = 0) ∧ (∀ x, (∀ y, β x y = 0) → x = 0) ∧ ¬ IsSquare (Nat.card (Fin 3 → ZMod 2))

/-- S3. Codex's exact torsion example (`WITNESS_CONTENT_THEOREM.md` §4): `⨁_{p ≠ 2,5} (ZMod p)²` has
zero 2- and 5-parts, 3-part of order 9, every primary part finite of square order, and infinitely many
nonzero primary parts; it is infinite. -/
def CM_codex_torsion_example : Prop :=
  let G := Π₀ p : {p : ℕ // p.Prime ∧ p ≠ 2 ∧ p ≠ 5}, ZMod p.1 × ZMod p.1
  AddMonoid.IsTorsion G ∧ primaryPart G 2 = ⊥ ∧ primaryPart G 5 = ⊥ ∧
  Nat.card (primaryPart G 3) = 9 ∧
  (∀ p, p.Prime → (primaryPart G p : Set G).Finite ∧ IsSquare (Nat.card (primaryPart G p))) ∧
  {p | p.Prime ∧ primaryPart G p ≠ ⊥}.Infinite ∧ ¬ Finite G

