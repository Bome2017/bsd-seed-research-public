namespace GateRFinite

open SDyadic P01 R1

/-! ### Private scaffolding

Nothing below is exported except `h41_finite`.  The certified inputs used are

* `R1.h41_multiplicative_duplication_height`  (duplication height inequality),
* `GateR.halving_representatives`             (every point is `2Q + eT`, `e ≤ 1`),
* `GateR.height_sublevels`                    (height sublevel sets are finite),
* `GateR.every_point_torsion`                 (every rational point is torsion),

together with `GateR.translateMax`, `R1.height`, `R1.one_le_height` and
`P01.Ecurve_two_torsion`.  None of them is reproved here.
-/

section Scaffolding

variable {ε : ℤ} {m q : ℕ} [Fact (Nat.Prime q)]

/-- The `T`-translated height of a point, `max (H P) (H (P + T))`, built from the frozen
`GateR.translateMax` and the frozen `R1.height`. -/
private noncomputable def tmax (hP : Params ε m q) :
    (Ecurve ε m q).toAffine.Point → ℕ :=
  GateR.translateMax (P01.Tpt hP) R1.height

private theorem tmax_apply (hP : Params ε m q) (P : (Ecurve ε m q).toAffine.Point) :
    tmax hP P = max (R1.height P) (R1.height (P + P01.Tpt hP)) := rfl

private theorem one_le_tmax (hP : Params ε m q) (P : (Ecurve ε m q).toAffine.Point) :
    1 ≤ tmax hP P :=
  le_trans (R1.one_le_height P) (le_max_left _ _)

/-- Sublevel sets of `tmax` are finite, because they sit inside the frozen height
sublevel sets. -/
private theorem finite_tmax_le (hP : Params ε m q) (n : ℕ) :
    {P : (Ecurve ε m q).toAffine.Point | tmax hP P ≤ n}.Finite := by
  refine Set.Finite.subset (GateR.height_sublevels ε m q n) ?_
  intro P hp
  simp only [Set.mem_setOf_eq, tmax_apply] at hp ⊢
  exact le_trans (le_max_left _ _) hp

/-- The two doubles occurring in a halving both equal `Q + Q`, since `T` is 2-torsion. -/
private theorem double_add_T (hP : Params ε m q) (Q : (Ecurve ε m q).toAffine.Point) :
    (Q + P01.Tpt hP) + (Q + P01.Tpt hP) = Q + Q := by
  have hTT : P01.Tpt hP + P01.Tpt hP = 0 :=
    (P01.Ecurve_two_torsion hP _).mpr (Or.inr rfl)
  rw [show Q + P01.Tpt hP + (Q + P01.Tpt hP) = Q + Q + (P01.Tpt hP + P01.Tpt hP) by abel,
    hTT, add_zero]

/-- **Strict descent step.**  Combining the frozen duplication inequality with the frozen
halving representatives: every point is `2Q + eT` with `tmax Q ^ 4 ≤ C * tmax P`. -/
private theorem strict_halving (hP : Params ε m q) (hH : H41 ε m) :
    ∃ C : ℕ, 1 ≤ C ∧ ∀ P : (Ecurve ε m q).toAffine.Point,
      ∃ Q : (Ecurve ε m q).toAffine.Point, ∃ e : ℕ,
        e ≤ 1 ∧ P = Q + Q + e • P01.Tpt hP ∧ tmax hP Q ^ 4 ≤ C * tmax hP P := by
  obtain ⟨C, hC1, hCdup⟩ := R1.h41_multiplicative_duplication_height ε m q hP hH
  refine ⟨C, hC1, ?_⟩
  intro P
  obtain ⟨Q, e, he, hPQ⟩ := GateR.halving_representatives ε m q hP hH P
  refine ⟨Q, e, he, hPQ, ?_⟩
  have hTT : P01.Tpt hP + P01.Tpt hP = 0 :=
    (P01.Ecurve_two_torsion hP _).mpr (Or.inr rfl)
  -- the double of `Q` is either `P` or `P + T`
  have hdbl : R1.height (Q + Q) ≤ tmax hP P := by
    interval_cases e
    · have : Q + Q = P := by rw [hPQ]; simp
      rw [this, tmax_apply]
      exact le_max_left _ _
    · have : Q + Q = P + P01.Tpt hP := by
        rw [hPQ, one_nsmul,
          show Q + Q + P01.Tpt hP + P01.Tpt hP = Q + Q + (P01.Tpt hP + P01.Tpt hP) by abel,
          hTT, add_zero]
      rw [this, tmax_apply]
      exact le_max_right _ _
  have h1 := hCdup Q
  have h2 := hCdup (Q + P01.Tpt hP)
  rw [double_add_T hP Q] at h2
  have hmax : max (R1.height Q) (R1.height (Q + P01.Tpt hP)) ^ 4 ≤ C * R1.height (Q + Q) := by
    rcases max_cases (R1.height Q) (R1.height (Q + P01.Tpt hP)) with ⟨hm, -⟩ | ⟨hm, -⟩ <;> rw [hm]
    · exact h1
    · exact h2
  rw [tmax_apply]
  exact le_trans hmax (Nat.mul_le_mul_left _ hdbl)

/-- **Infinite descent.**  Every point lies in the subgroup generated by the points of
bounded `tmax` together with `T`. -/
private theorem mem_closure_of_strict_halving (hP : Params ε m q) (C : ℕ)
    (hdesc : ∀ P : (Ecurve ε m q).toAffine.Point,
      ∃ Q : (Ecurve ε m q).toAffine.Point, ∃ e : ℕ,
        e ≤ 1 ∧ P = Q + Q + e • P01.Tpt hP ∧ tmax hP Q ^ 4 ≤ C * tmax hP P)
    (P : (Ecurve ε m q).toAffine.Point) :
    P ∈ AddSubgroup.closure
      ({R : (Ecurve ε m q).toAffine.Point | tmax hP R ≤ C} ∪ {P01.Tpt hP}) := by
  set K := AddSubgroup.closure
    ({R : (Ecurve ε m q).toAffine.Point | tmax hP R ≤ C} ∪ {P01.Tpt hP}) with hK
  have hTK : P01.Tpt hP ∈ K := AddSubgroup.subset_closure (Or.inr rfl)
  have key : ∀ n : ℕ, ∀ R : (Ecurve ε m q).toAffine.Point, tmax hP R ≤ n → R ∈ K := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
        intro R hRn
        obtain ⟨Q, e, -, hRQ, hQ4⟩ := hdesc R
        have hQK : Q ∈ K := by
          by_cases hQle : tmax hP Q ≤ C
          · exact AddSubgroup.subset_closure (Or.inl hQle)
          · push_neg at hQle
            have h1Q : 1 ≤ tmax hP Q := one_le_tmax hP Q
            have hlt : tmax hP Q < tmax hP R := by
              by_contra hcon
              push_neg at hcon
              have hstep : tmax hP Q ^ 4 ≤ C * tmax hP Q :=
                le_trans hQ4 (Nat.mul_le_mul_left _ hcon)
              have hsq : tmax hP Q ^ 2 ≤ tmax hP Q ^ 4 :=
                Nat.pow_le_pow_right h1Q (by norm_num)
              have hsq' : tmax hP Q ^ 2 = tmax hP Q * tmax hP Q := by ring
              nlinarith [hstep, hsq, hsq', hQle, h1Q]
            exact ih (tmax hP Q) (lt_of_lt_of_le hlt hRn) Q le_rfl
        rw [hRQ]
        exact AddSubgroup.add_mem _ (AddSubgroup.add_mem _ hQK hQK)
          (AddSubgroup.nsmul_mem _ hTK e)
  exact key (tmax hP P) P le_rfl

end Scaffolding

/-- THE ONLY AUTHORISED OUTPUT.  `Finite` here is mathlib's finiteness of the actual
rational point group of the actual curve — not finiteness of a height sublevel set,
not a `Fintype` you construct by hand, and not a statement about any other group. -/
theorem h41_finite (ε : ℤ) (m q : ℕ) [Fact (Nat.Prime q)]
    (hP : SDyadic.Params ε m q) (hH : SDyadic.H41 ε m) :
    Finite ((P01.Ecurve ε m q).toAffine.Point) := by
  classical
  obtain ⟨C, -, hdesc⟩ := strict_halving hP hH
  -- the generating set: bounded `tmax` together with the marked 2-torsion point
  have hgen : AddSubgroup.closure
      ({R : (P01.Ecurve ε m q).toAffine.Point | tmax hP R ≤ C} ∪ {P01.Tpt hP}) = ⊤ := by
    refine eq_top_iff.mpr ?_
    intro P _
    exact mem_closure_of_strict_halving hP C hdesc P
  have hfin : ({R : (P01.Ecurve ε m q).toAffine.Point | tmax hP R ≤ C} ∪
      {P01.Tpt hP}).Finite :=
    (finite_tmax_le hP C).union (Set.finite_singleton _)
  haveI : AddGroup.FG ((P01.Ecurve ε m q).toAffine.Point) :=
    AddGroup.fg_iff.mpr ⟨_, hgen, hfin⟩
  -- and every point is torsion, by the frozen Gate-R theorem
  have htors : AddMonoid.IsTorsion ((P01.Ecurve ε m q).toAffine.Point) := by
    intro P
    exact isOfFinAddOrder_iff_nsmul_eq_zero.mpr (GateR.every_point_torsion ε m q hP hH P)
  exact AddCommGroup.finite_of_fg_torsion _ htors

end GateRFinite
