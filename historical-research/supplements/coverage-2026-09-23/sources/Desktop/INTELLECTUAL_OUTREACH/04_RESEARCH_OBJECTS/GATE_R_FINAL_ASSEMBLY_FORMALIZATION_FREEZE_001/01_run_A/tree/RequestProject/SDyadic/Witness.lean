/-
`S_dyadic` — explicit rational witnesses and the structure of the explicit descent quotient.

Two independent ingredients of the target theorem live here.

*Rational witnesses.*  For the four `φ` classes `1`, `D`, `q`, `D q` and for the dual class `1`
we exhibit honest rational points on the quartic coverings `Cov ℚ`.  The `q` and `D q` witnesses
use the normalisation identity `1 − 2A + D = 0`.

*Square-class group structure.*  Purely group-theoretic lemmas about `ℚ*/ℚ*²` (an abelian group of
exponent two) plus the two non-squareness facts `q ∉ (ℚ*)²`, `D q ∉ (ℚ*)²`, which together give the
index-two statement for `⟨[D]⟩ ≤ ⟨[D],[q]⟩`.

Nothing here refers to any answer set:  the quotient is an **explicit descent quotient** of square
classes, not a cohomological object.
-/
import RequestProject.SDyadic.Structure

open Pointwise

namespace SDyadic

open Run013

variable {ε : ℤ} {m q : ℕ}

/-! ## Generic group theory: closures in a group of exponent two -/

/-- In any group, the cyclic subgroup generated by an involution has at most two elements. -/
theorem mem_closure_singleton_of_sq_eq_one {G : Type*} [Group G] {x y : G} (hx : x ^ 2 = 1)
    (hy : y ∈ Subgroup.closure ({x} : Set G)) : y = 1 ∨ y = x := by
  rw [← Subgroup.zpowers_eq_closure, Subgroup.mem_zpowers_iff] at hy
  obtain ⟨n, rfl⟩ := hy
  have hx' : x ^ (2 : ℤ) = 1 := by
    rw [show ((2 : ℤ)) = ((2 : ℕ) : ℤ) from rfl, zpow_natCast, hx]
  rcases Int.even_or_odd n with ⟨k, hk⟩ | ⟨k, hk⟩
  · left; subst hk; rw [show k + k = 2 * k by ring, zpow_mul, hx', one_zpow]
  · right; subst hk; rw [zpow_add, zpow_mul, hx', one_zpow, one_mul, zpow_one]

/-- If `b` is an involution of an abelian group and `b ∉ ⟨a⟩`, then `⟨a⟩` has index two
in `⟨a, b⟩`. -/
theorem index_two_of_closure_pair {G : Type*} [CommGroup G] {a b : G}
    (hb2 : b ^ 2 = 1) (hbK : b ∉ Subgroup.closure ({a} : Set G)) :
    ((Subgroup.closure ({a} : Set G)).subgroupOf
      (Subgroup.closure ({a, b} : Set G))).index = 2 := by
  set K := Subgroup.closure ({a} : Set G) with hK
  set G' := Subgroup.closure ({a, b} : Set G) with hG'
  have hbG : b ∈ G' := Subgroup.subset_closure (by simp)
  have hsup : G' = K ⊔ Subgroup.closure ({b} : Set G) := by
    rw [hG', hK, ← Subgroup.closure_union, Set.singleton_union]
  have hmul : (↑(K ⊔ Subgroup.closure ({b} : Set G)) : Set G)
      = (↑K : Set G) * (↑(Subgroup.closure ({b} : Set G)) : Set G) :=
    Subgroup.mul_normal _ _
  have key : ∀ g ∈ G', g ∈ K ∨ g * b ∈ K := by
    intro g hg
    rw [hsup] at hg
    have hg' : g ∈ (↑K : Set G) * (↑(Subgroup.closure ({b} : Set G)) : Set G) := hmul ▸ hg
    obtain ⟨k, hk, z, hz, rfl⟩ := hg'
    have hkK : k ∈ K := hk
    rcases mem_closure_singleton_of_sq_eq_one hb2 hz with h1 | h1
    · left; rw [h1]; show k * 1 ∈ K; rw [mul_one]; exact hkK
    · right; rw [h1]; show k * b * b ∈ K; rw [mul_assoc, ← sq, hb2, mul_one]; exact hkK
  rw [Subgroup.index_eq_two_iff]
  refine ⟨⟨b, hbG⟩, ?_⟩
  rintro ⟨g, hg⟩
  by_cases hgK : g ∈ K
  · refine Or.inr ⟨by simpa [Subgroup.mem_subgroupOf] using hgK, ?_⟩
    simp only [Subgroup.mem_subgroupOf]
    intro hc
    have hmem := K.mul_mem (K.inv_mem hgK) (show g * b ∈ K by simpa using hc)
    rw [inv_mul_cancel_left] at hmem
    exact hbK hmem
  · refine Or.inl ⟨?_, by simpa [Subgroup.mem_subgroupOf] using hgK⟩
    simpa [Subgroup.mem_subgroupOf] using (key g hg).resolve_left hgK

/-! ## `ℚ*/ℚ*²` has exponent two -/

/-- Every square class squares to the trivial class. -/
theorem qsq_sq_eq_one (x : Qsq) : x ^ 2 = 1 := by
  obtain ⟨y, rfl⟩ := qcl_surjective x
  have : (qcl y) ^ 2 = qcl (y ^ 2) := rfl
  rw [this, qcl, QuotientGroup.eq_one_iff, mem_sqSubgroup]
  exact ⟨y, rfl⟩

/-! ## Non-squares -/

/-- An integer divisible exactly once by a prime is not a square. -/
theorem not_isSquare_of_prime_dvd_once {n p : ℤ} (hp : Prime p) (h1 : p ∣ n)
    (h2 : ¬ p ^ 2 ∣ n) : ¬ IsSquare n := by
  rintro ⟨r, rfl⟩
  have hr : p ∣ r := (hp.dvd_mul.mp h1).elim id id
  obtain ⟨s, rfl⟩ := hr
  exact h2 ⟨s * s, by ring⟩

/-- A nonzero integer that is not a square has nontrivial class in `ℚ*/ℚ*²`. -/
theorem cls_ne_one_of_not_isSquare {n : ℤ} (hn : n ≠ 0) (h : ¬ IsSquare n) :
    cls ((n : ℤ) : ℚ) ≠ 1 := by
  have hnQ : ((n : ℤ) : ℚ) ≠ 0 := Int.cast_ne_zero.mpr hn
  rw [cls_of_ne hnQ]
  intro hc
  have hc' : qcl (Units.mk0 ((n : ℤ) : ℚ) hnQ) = qcl 1 := by
    rw [hc]; rfl
  obtain ⟨t, ht⟩ := qcl_eq_qcl.mp hc'
  have ht' : (1 : ℚ) = ((n : ℤ) : ℚ) * (t : ℚ) ^ 2 := by
    have h0 := congrArg (fun x : ℚˣ => (x : ℚ)) ht
    simpa using h0
  have htne : (t : ℚ) ≠ 0 := t.ne_zero
  refine h (Rat.isSquare_intCast_iff.mp ⟨((t : ℚ))⁻¹, ?_⟩)
  field_simp
  linear_combination -ht'

/-- Two nonzero integers whose product is not a square have distinct classes in `ℚ*/ℚ*²`. -/
theorem cls_ne_cls_of_not_isSquare_mul {n k : ℤ} (hn : n ≠ 0) (hk : k ≠ 0)
    (h : ¬ IsSquare (n * k)) : cls ((n : ℤ) : ℚ) ≠ cls ((k : ℤ) : ℚ) := by
  have hnQ : ((n : ℤ) : ℚ) ≠ 0 := Int.cast_ne_zero.mpr hn
  have hkQ : ((k : ℤ) : ℚ) ≠ 0 := Int.cast_ne_zero.mpr hk
  rw [cls_of_ne hnQ, cls_of_ne hkQ]
  intro hc
  obtain ⟨t, ht⟩ := qcl_eq_qcl.mp hc
  have ht' : ((k : ℤ) : ℚ) = ((n : ℤ) : ℚ) * (t : ℚ) ^ 2 := by
    have h0 := congrArg (fun x : ℚˣ => (x : ℚ)) ht
    simpa using h0
  refine h (Rat.isSquare_intCast_iff.mp ⟨((n : ℤ) : ℚ) * (t : ℚ), ?_⟩)
  push_cast
  rw [ht']
  ring

/-! ## The explicit rational covering witnesses -/

/-- `d = 1`, witness `(u,v,n) = (1,0,1)`. -/
theorem cov_phi_one (ε : ℤ) (m q : ℕ) : Cov ℚ (phiA ε m q) (phiB ε m q) 1 :=
  ⟨1, 0, 1, by simp, by norm_num⟩

/-- `d = D`, witness `(u,v,n) = (0,1,q)`. -/
theorem cov_phi_D (ε : ℤ) (m q : ℕ) :
    Cov ℚ (phiA ε m q) (phiB ε m q) ((DD ε m : ℤ) : ℚ) := by
  have hD : ((DD ε m : ℤ) : ℚ) ≠ 0 := Int.cast_ne_zero.mpr (D_ne_zero ε m)
  refine ⟨0, 1, (q : ℚ), by simp, ?_⟩
  simp only [phiA, phiB]
  push_cast
  field_simp
  ring

/-- `d = q`, witness `(u,v,n) = (1,1,0)`, using `1 − 2A + D = 0`. -/
theorem cov_phi_q (ε : ℤ) (m q : ℕ) :
    Cov ℚ (phiA ε m q) (phiB ε m q) ((q : ℤ) : ℚ) := by
  have hid : (1 : ℚ) - 2 * ((AA ε m : ℤ) : ℚ) + ((DD ε m : ℤ) : ℚ) = 0 := by
    have := congrArg (fun z : ℤ => (z : ℚ)) (one_sub_two_A_add_D ε m)
    push_cast at this
    exact this
  refine ⟨1, 1, 0, by simp, ?_⟩
  simp only [phiA, phiB]
  push_cast
  field_simp
  linear_combination (-(q : ℚ)) * hid

/-- `d = D q`, witness `(u,v,n) = (1,1,0)`, using `1 − 2A + D = 0`. -/
theorem cov_phi_Dq (ε : ℤ) (m q : ℕ) :
    Cov ℚ (phiA ε m q) (phiB ε m q) ((DD ε m * (q : ℤ) : ℤ) : ℚ) := by
  have hD : ((DD ε m : ℤ) : ℚ) ≠ 0 := Int.cast_ne_zero.mpr (D_ne_zero ε m)
  have hid : (1 : ℚ) - 2 * ((AA ε m : ℤ) : ℚ) + ((DD ε m : ℤ) : ℚ) = 0 := by
    have := congrArg (fun z : ℤ => (z : ℚ)) (one_sub_two_A_add_D ε m)
    push_cast at this
    exact this
  refine ⟨1, 1, 0, by simp, ?_⟩
  simp only [phiA, phiB]
  push_cast at hD ⊢
  field_simp
  linear_combination (-(q : ℚ)) * hid

/-- `d = 1` on the dual side, witness `(u,v,n) = (1,0,1)`. -/
theorem cov_dual_one (ε : ℤ) (m q : ℕ) : Cov ℚ (dualA ε m q) (dualB ε m q) 1 :=
  ⟨1, 0, 1, by simp, by norm_num⟩

end SDyadic
