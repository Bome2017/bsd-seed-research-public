import Mathlib

/-!
# Seed curve arithmetic: exact integral data

The fixed curve of the study is

  `E : y² = x³ + a₂ x² + a₄ x`,  `a₂ = -22735`, `a₄ = 106272484`,

with claimed conductor `N = 2³ · 3 · 2243 · 4547² · 5843` and Mordell–Weil generators
`P₁ = (4547, 327384)`, `P₂ = (5184, 281520)`, torsion generated by `T = (0,0)`.

Everything in this file is an exact statement about integers, machine-checked.  It records:

* the hidden multiplicative structure of the coefficients,
  `a₂ = -(5 · 4547)` and `a₄ = 4 · 4547 · 5843`;
* the standard Weierstrass invariants `c₄`, `c₆`, `Δ` and their **complete prime factorisations**;
* the fact that `P₁`, `P₂` lie on the curve, and that `x(P₁) = 4547`, `y(P₁) = 4547 · 72`,
  `x(P₂) = 72²`, `y(P₂) = 72 · 3910`;
* the exact `4547`-adic valuations `v(c₄) = 1`, `v(c₆) = 2`, `v(Δ) = 3`, which are the numerical
  input to Tate's algorithm at `4547`.

No claim about Kodaira types, Néron models or Selmer groups is made *inside* Lean: those are
recorded, with their (standard) derivations, in `ARISTOTLE_A_RETURN.md`.  This file supplies the
arithmetic on which those derivations rest.
-/

namespace SeedBSD

/-- The `x²`-coefficient of the seed Weierstrass model. -/
def a₂ : ℤ := -22735

/-- The `x`-coefficient of the seed Weierstrass model. -/
def a₄ : ℤ := 106272484

/-- The invariant `c₄` of the seed model. -/
def c₄ : ℤ := 3169004368

/-- The invariant `c₆` of the seed model. -/
def c₆ : ℤ := 56243184546880

/-- The discriminant of the seed model. -/
def Δ : ℤ := 16586638656786071143743744

/-- The claimed conductor of the seed curve. -/
def N : ℕ := 6503188012738584

/-- Membership in the seed curve `y² = x³ + a₂x² + a₄x`. -/
def OnCurve (x y : ℤ) : Prop := y ^ 2 = x ^ 3 + a₂ * x ^ 2 + a₄ * x

/-! ## The hidden factorisation of the coefficients -/

/-- `a₂ = -(5 · 4547)`: the `x`-coordinate of `P₁` already divides the `x²`-coefficient. -/
theorem a₂_factor : a₂ = -(5 * 4547) := by norm_num [a₂]

/-- `a₄ = 4 · 4547 · 5843`.  In particular `v_{4547}(a₄) = 1`, so the reduction at `4547`
is additive with a cusp at the origin. -/
theorem a₄_factor : a₄ = 4 * 4547 * 5843 := by norm_num [a₄]

/-- The quadratic factor's discriminant `a₂² - 4a₄ = 3² · 2243 · 4547`. -/
theorem quadratic_disc_factor : a₂ ^ 2 - 4 * a₄ = 3 ^ 2 * 2243 * 4547 := by
  norm_num [a₂, a₄]

/-! ## Weierstrass invariants -/

/-- `c₄ = b₂² - 24 b₄` with `b₂ = 4a₂`, `b₄ = 2a₄`. -/
theorem c₄_eq : c₄ = (4 * a₂) ^ 2 - 24 * (2 * a₄) := by norm_num [c₄, a₂, a₄]

/-- `c₆ = -b₂³ + 36 b₂ b₄` with `b₂ = 4a₂`, `b₄ = 2a₄` (here `b₆ = 0`). -/
theorem c₆_eq : c₆ = -(4 * a₂) ^ 3 + 36 * (4 * a₂) * (2 * a₄) := by norm_num [c₆, a₂, a₄]

/-- `1728 Δ = c₄³ - c₆²`. -/
theorem disc_eq_c : 1728 * Δ = c₄ ^ 3 - c₆ ^ 2 := by norm_num [Δ, c₄, c₆]

/-- For a model `y² = x(x² + a₂x + a₄)` one has `Δ = 16 a₄² (a₂² - 4a₄)`. -/
theorem disc_eq_ab : Δ = 16 * a₄ ^ 2 * (a₂ ^ 2 - 4 * a₄) := by norm_num [Δ, a₂, a₄]

/-! ## Complete prime factorisations -/

theorem prime_2243 : Nat.Prime 2243 := by norm_num
theorem prime_4547 : Nat.Prime 4547 := by norm_num
theorem prime_5843 : Nat.Prime 5843 := by norm_num
theorem prime_8501 : Nat.Prime 8501 := by norm_num
theorem prime_1013 : Nat.Prime 1013 := by norm_num

/-- `c₄ = 2⁴ · 43 · 1013 · 4547`.  Note `v_{4547}(c₄) = 1`. -/
theorem c₄_factor : c₄ = 2 ^ 4 * 43 * 1013 * 4547 := by norm_num [c₄]

/-- `c₆ = 2⁶ · 5 · 4547² · 8501`.  Note `v_{4547}(c₆) = 2`. -/
theorem c₆_factor : c₆ = 2 ^ 6 * 5 * 4547 ^ 2 * 8501 := by norm_num [c₆]

/-- `Δ = 2⁸ · 3² · 2243 · 4547³ · 5843²`.  Note `v_{4547}(Δ) = 3`. -/
theorem disc_factor : Δ = 2 ^ 8 * 3 ^ 2 * 2243 * 4547 ^ 3 * 5843 ^ 2 := by norm_num [Δ]

/-- The claimed conductor, expanded. -/
theorem N_factor : N = 2 ^ 3 * 3 * 2243 * 4547 ^ 2 * 5843 := by norm_num [N]

/-! ## The two Mordell–Weil generators and the torsion point -/

/-- `T = (0,0)` is on the curve (the rational `2`-torsion point). -/
theorem T_on_curve : OnCurve 0 0 := by norm_num [OnCurve, a₂, a₄]

/-- `P₁ = (4547, 327384)` is on the curve. -/
theorem P₁_on_curve : OnCurve 4547 327384 := by norm_num [OnCurve, a₂, a₄]

/-- `P₂ = (5184, 281520)` is on the curve. -/
theorem P₂_on_curve : OnCurve 5184 281520 := by norm_num [OnCurve, a₂, a₄]

/-- `y(P₁) = 4547 · 72`: both coordinates of `P₁` are divisible by `4547` exactly once. -/
theorem P₁_coords : (4547 : ℤ) = 4547 ∧ (327384 : ℤ) = 4547 * 72 := by norm_num

/-- `x(P₂) = 72²` is a perfect square and `y(P₂) = 72 · 3910`.  Hence `x(P₂)` is trivial in
`ℚ*/(ℚ*)²`, i.e. `P₂` lies in the image of the dual `2`-isogeny. -/
theorem P₂_coords : (5184 : ℤ) = 72 ^ 2 ∧ (281520 : ℤ) = 72 * 3910 := by norm_num

/-! ## Exact `4547`-adic valuations (the Tate-algorithm input at `4547`) -/

theorem v4547_c₄ : (4547 : ℤ) ∣ c₄ ∧ ¬ ((4547 : ℤ) ^ 2 ∣ c₄) := by
  refine ⟨⟨2 ^ 4 * 43 * 1013, by norm_num [c₄]⟩, ?_⟩
  decide

theorem v4547_c₆ : (4547 : ℤ) ^ 2 ∣ c₆ ∧ ¬ ((4547 : ℤ) ^ 3 ∣ c₆) := by
  refine ⟨⟨2 ^ 6 * 5 * 8501, by norm_num [c₆]⟩, ?_⟩
  decide

theorem v4547_disc : (4547 : ℤ) ^ 3 ∣ Δ ∧ ¬ ((4547 : ℤ) ^ 4 ∣ Δ) := by
  refine ⟨⟨2 ^ 8 * 3 ^ 2 * 2243 * 5843 ^ 2, by norm_num [Δ]⟩, ?_⟩
  decide

/-- The model is `4547`-minimal: minimality fails only if `v(c₄) ≥ 4`, and here `v(c₄) = 1`. -/
theorem minimal_at_4547 : ¬ ((4547 : ℤ) ^ 4 ∣ c₄) := by decide

/-! ## Reduction of the rational points at `4547` -/

/-- `P₁` reduces to the singular point `(0,0)` of `E mod 4547`: both coordinates are
divisible by `4547`.  This is the exact content of the seed coincidence `x(P₁) = 4547`. -/
theorem P₁_reduces_to_cusp : (4547 : ℤ) ∣ 4547 ∧ (4547 : ℤ) ∣ 327384 := by
  exact ⟨dvd_refl _, ⟨72, by norm_num⟩⟩

/-- `P₂` does **not** reduce to the singular point: `4547 ∤ x(P₂)`. -/
theorem P₂_avoids_cusp : ¬ ((4547 : ℤ) ∣ 5184) := by decide

/-- The reduced curve at `4547` is the cuspidal cubic `y² = x³`: both `a₂` and `a₄`
are divisible by `4547`. -/
theorem reduction_at_4547_is_cuspidal : (4547 : ℤ) ∣ a₂ ∧ (4547 : ℤ) ∣ a₄ := by
  constructor
  · exact ⟨-5, by norm_num [a₂]⟩
  · exact ⟨4 * 5843, by norm_num [a₄]⟩

/-! ## Valuations at the remaining bad primes -/

/-- At `3`, `2243`, `5843` the invariant `c₄` is a unit, so the reduction is multiplicative. -/
theorem c₄_unit_at_multiplicative :
    ¬ ((3 : ℤ) ∣ c₄) ∧ ¬ ((2243 : ℤ) ∣ c₄) ∧ ¬ ((5843 : ℤ) ∣ c₄) := by
  refine ⟨by decide, by decide, by decide⟩

/-- `v₃(Δ) = 2`, `v_{2243}(Δ) = 1`, `v_{5843}(Δ) = 2`: Kodaira types `I₂`, `I₁`, `I₂`. -/
theorem multiplicative_disc_valuations :
    ((3 : ℤ) ^ 2 ∣ Δ ∧ ¬ ((3 : ℤ) ^ 3 ∣ Δ)) ∧
    ((2243 : ℤ) ∣ Δ ∧ ¬ ((2243 : ℤ) ^ 2 ∣ Δ)) ∧
    ((5843 : ℤ) ^ 2 ∣ Δ ∧ ¬ ((5843 : ℤ) ^ 3 ∣ Δ)) := by
  refine ⟨⟨⟨2 ^ 8 * 2243 * 4547 ^ 3 * 5843 ^ 2, by norm_num [Δ]⟩, by decide⟩,
    ⟨⟨2 ^ 8 * 3 ^ 2 * 4547 ^ 3 * 5843 ^ 2, by norm_num [Δ]⟩, by decide⟩,
    ⟨⟨2 ^ 8 * 3 ^ 2 * 2243 * 4547 ^ 3, by norm_num [Δ]⟩, by decide⟩⟩

/-- At `2`: `v₂(c₄) = 4`, `v₂(Δ) = 8`.  With the conductor exponent `f₂ = 3` read off from `N`,
Ogg's formula `f = v(Δ) - m + 1` forces `m = 6` components, i.e. Kodaira type `I₁*`. -/
theorem v2_data : ((2 : ℤ) ^ 4 ∣ c₄ ∧ ¬ ((2 : ℤ) ^ 5 ∣ c₄)) ∧
    ((2 : ℤ) ^ 8 ∣ Δ ∧ ¬ ((2 : ℤ) ^ 9 ∣ Δ)) := by
  refine ⟨⟨⟨43 * 1013 * 4547, by norm_num [c₄]⟩, by decide⟩,
    ⟨⟨3 ^ 2 * 2243 * 4547 ^ 3 * 5843 ^ 2, by norm_num [Δ]⟩, by decide⟩⟩

/-- Ogg's formula at `2` with `f₂ = 3` and `v₂(Δ) = 8` gives exactly `6` components. -/
theorem ogg_at_two : (8 : ℕ) - 3 + 1 = 6 := by norm_num

end SeedBSD
