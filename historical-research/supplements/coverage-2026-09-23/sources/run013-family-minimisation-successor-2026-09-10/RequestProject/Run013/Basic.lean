/-
Run013 — independent formal reconstruction of the frozen `62a1` BSD-at-2 target.

`Basic.lean`
Generic descent infrastructure:

* square classes of a field,
* the Kummer image of the `x`-coordinate map attached to a curve
  `y^2 = x^3 + a x^2 + b x` with the rational two-torsion point `(0,0)`,
* the homogeneous spaces (quartic coverings) `n^2 = d u^4 + a u^2 v^2 + (b/d) v^4`,
* the equivalence between solubility of the covering over a field `K` and membership
  of `d` in the Kummer image modulo squares (this is §2 of the frozen
  `evidence/DESCENT_DERIVATION.md`).

Nothing in this file is specific to the Run013 family.
-/
import Mathlib

namespace Run013

/-! ## Square classes -/

/-- `SqEq K d c` says that `d` and `c` define the same class in `K*/K*^2`. -/
def SqEq (K : Type*) [Field K] (d c : K) : Prop := ∃ t : K, t ≠ 0 ∧ d = c * t ^ 2

lemma SqEq.rfl' {K : Type*} [Field K] (d : K) : SqEq K d d := ⟨1, one_ne_zero, by ring⟩

lemma SqEq.symm {K : Type*} [Field K] {d c : K} (hc : c ≠ 0) (h : SqEq K d c) :
    SqEq K c d := by
  obtain ⟨t, ht, rfl⟩ := h
  exact ⟨t⁻¹, inv_ne_zero ht, by field_simp⟩

lemma SqEq.trans {K : Type*} [Field K] {d c e : K} (h₁ : SqEq K d c) (h₂ : SqEq K c e) :
    SqEq K d e := by
  obtain ⟨t, ht, rfl⟩ := h₁
  obtain ⟨s, hs, rfl⟩ := h₂
  exact ⟨s * t, mul_ne_zero hs ht, by ring⟩

lemma SqEq.ne_zero {K : Type*} [Field K] {d c : K} (h : SqEq K d c) (hc : c ≠ 0) : d ≠ 0 := by
  obtain ⟨t, ht, rfl⟩ := h
  exact mul_ne_zero hc (pow_ne_zero _ ht)

/-! ## The Kummer image -/

/-- The image of the Kummer (`x`-coordinate) map attached to the two-isogeny with kernel
generated by `(0,0)` on `A_{a,b} : y^2 = x^3 + a x^2 + b x`.  Explicitly the image consists of
the class of `1` (from the point at infinity), the class of `b` (from `(0,0)`), and the
`x`-coordinates of the remaining affine points. -/
def KummerImage (K : Type*) [Field K] (a b : K) : Set K :=
  {x : K | x = 1 ∨ x = b ∨ (x ≠ 0 ∧ ∃ y : K, y ^ 2 = x ^ 3 + a * x ^ 2 + b * x)}

/-- `d` lies in the Kummer image modulo squares. -/
def InKummer (K : Type*) [Field K] (a b d : K) : Prop :=
  ∃ c ∈ KummerImage K a b, SqEq K d c

/-! ## The homogeneous spaces -/

/-- The quartic covering `C_d : n^2 = d u^4 + a u^2 v^2 + (b/d) v^4`,
in its projective form (`(u : v)` not both zero, weights `(1,1,2)`). -/
def Cov (K : Type*) [Field K] (a b d : K) : Prop :=
  ∃ u v n : K, ¬(u = 0 ∧ v = 0) ∧ n ^ 2 = d * u ^ 4 + a * u ^ 2 * v ^ 2 + (b / d) * v ^ 4

/-- Denominator-cleared form of the covering, obtained by substituting `M = d n`. -/
def CovM (K : Type*) [Field K] (a b d : K) : Prop :=
  ∃ u v M : K, ¬(u = 0 ∧ v = 0) ∧
    M ^ 2 = d ^ 3 * u ^ 4 + a * d ^ 2 * u ^ 2 * v ^ 2 + b * d * v ^ 4

lemma cov_iff_covM {K : Type*} [Field K] {a b d : K} (hd : d ≠ 0) :
    Cov K a b d ↔ CovM K a b d := by
  constructor
  · rintro ⟨u, v, n, huv, hn⟩
    refine ⟨u, v, d * n, huv, ?_⟩
    have h2 : (d * n) ^ 2 = d ^ 2 * n ^ 2 := by ring
    rw [h2, hn]
    field_simp
  · rintro ⟨u, v, M, huv, hM⟩
    exact ⟨u, v, M / d, huv, by field_simp; linear_combination hM⟩

/-- Solubility of the covering only depends on the square class of `d`. -/
lemma cov_sqEq {K : Type*} [Field K] {a b d c : K} (hc : c ≠ 0) (h : SqEq K d c)
    (hcov : Cov K a b c) : Cov K a b d := by
  obtain ⟨t, ht, rfl⟩ := h
  obtain ⟨u, v, n, huv, hn⟩ := hcov
  have hbc : b / c * c = b := div_mul_cancel₀ b hc
  have hn' : n ^ 2 * c = c ^ 2 * u ^ 4 + a * c * u ^ 2 * v ^ 2 + b * v ^ 4 := by
    rw [hn]; linear_combination v ^ 4 * hbc
  refine ⟨u / t, v, n / t, ?_, ?_⟩
  · rintro ⟨hu, hv⟩
    refine huv ⟨?_, hv⟩
    field_simp at hu
    simpa using hu
  · field_simp
    linear_combination hn'

/-! ## The bridge: coverings compute the Kummer image -/

theorem cov_iff_inKummer {K : Type*} [Field K] {a b d : K} (hb : b ≠ 0) (hd : d ≠ 0) :
    Cov K a b d ↔ InKummer K a b d := by
  have hbd : b / d * d = b := div_mul_cancel₀ b hd
  constructor
  · rintro ⟨u, v, n, huv, hn⟩
    by_cases hv : v = 0
    · subst hv
      have hu : u ≠ 0 := fun h => huv ⟨h, rfl⟩
      have hn' : n ^ 2 = d * u ^ 4 := by rw [hn]; ring
      have hnne : n ≠ 0 := by
        intro h
        refine (mul_ne_zero hd (pow_ne_zero 4 hu)) ?_
        rw [← hn', h]; ring
      exact ⟨1, Or.inl rfl, n / u ^ 2, div_ne_zero hnne (pow_ne_zero 2 hu), by
        field_simp; linear_combination -hn'⟩
    · by_cases hu : u = 0
      · subst hu
        have hn' : n ^ 2 * d = b * v ^ 4 := by
          rw [hn]; linear_combination v ^ 4 * hbd
        have hnne : n ≠ 0 := by
          intro h
          refine (mul_ne_zero hb (pow_ne_zero 4 hv)) ?_
          rw [← hn', h]; ring
        exact ⟨b, Or.inr (Or.inl rfl), v ^ 2 / n, div_ne_zero (pow_ne_zero 2 hv) hnne, by
          field_simp; linear_combination hn'⟩
      · have hdn : n ^ 2 * d = d ^ 2 * u ^ 4 + a * d * u ^ 2 * v ^ 2 + b * v ^ 4 := by
          rw [hn]; linear_combination v ^ 4 * hbd
        refine ⟨d * u ^ 2 / v ^ 2,
          Or.inr (Or.inr ⟨div_ne_zero (mul_ne_zero hd (pow_ne_zero 2 hu)) (pow_ne_zero 2 hv),
            d * u * n / v ^ 3, by field_simp; linear_combination hdn⟩),
          v / u, div_ne_zero hv hu, by field_simp⟩
  · rintro ⟨c, hc, hsq⟩
    have hcov : Cov K a b c := by
      rcases hc with hc1 | hc2 | ⟨hx, y, hy⟩
      · subst hc1
        exact ⟨1, 0, 1, by simp, by norm_num⟩
      · subst hc2
        exact ⟨0, 1, 1, by simp, by rw [div_self hb]; ring⟩
      · exact ⟨1, 1, y / c, by simp, by field_simp; linear_combination hy⟩
    have hcne : c ≠ 0 := by
      rcases hc with hc1 | hc2 | ⟨hx, -⟩
      · exact hc1 ▸ one_ne_zero
      · exact hc2 ▸ hb
      · exact hx
    exact cov_sqEq hcne hsq hcov

end Run013
