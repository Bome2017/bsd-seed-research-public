\\ Exact integral-lattice certificate for the load-bearing Zhai base input.
\\ Requires PARI/GP 2.17.4 (or compatible exact modular-symbol routines).
\\ Deliberately does not call msfromell, lfun, ellperiods, or bestappr.

default(recover, 0);

E = ellinit([1,-1,1,-1,1]);
N = ellglobalred(E)[1];
if (N != 62, error("unexpected conductor: ", N));
if (E.disc != -496, error("unexpected discriminant: ", E.disc));
if (elltors(E)[1] != 4, error("unexpected rational torsion order"));

\\ Work in the plus part of the weight-2 modular-symbol space.  The listed
\\ Hecke eigenvalues are independently recomputed by exact point counts.
M = msinit(62, 2, 1);
New = msnew(M);
hecke_data = [[3,0], [5,-2], [7,0], [11,0]];
for (i = 1, #hecke_data, {
  p = hecke_data[i][1];
  ap = hecke_data[i][2];
  if (ellap(E,p) != ap, error("wrong a_p at p=", p));
});

\\ Isolate the 62a plus eigenline, then compute its canonical integral
\\ lattice using exact rational/integer modular-symbol operations.
H_coordinates = msfromhecke(M, hecke_data, New);
if (matsize(H_coordinates) != [3,1], error("Hecke eigenspace not one-dimensional"));
H = New[1] * H_coordinates;
if (msissymbol(M,H)[1] != 1, error("Hecke line is not a modular symbol"));
for (i = 1, #hecke_data, {
  p = hecke_data[i][1];
  ap = hecke_data[i][2];
  if (mshecke(M,p,H) != Mat(ap), error("Hecke relation failed at p=", p));
});

Lplus = mslattice(M,H);
if (matsize(Lplus) != [10,1], error("canonical plus lattice has wrong rank"));
if (msissymbol(M,Lplus)[1] != 1, error("canonical lattice vector is not a symbol"));
integral_plus_value = mseval(M,Lplus,[oo,0])[1];
if (abs(integral_plus_value) != 1/2, error("wrong canonical plus-lattice path value: ", integral_plus_value));

\\ Mathematical normalization used after this exact calculation:
\\ E has one real component (disc < 0), is optimal, and has Manin constant 1.
\\ The canonical lattice is then generated by x^+-x^- and 2*x^-; its
\\ intersection with the plus line is Z*(2*x^+).  Hence the primitive plus
\\ value above is exactly twice |L(E,1)/Omega_E^+|.
abs_Lalg = abs(integral_plus_value) / 2;
if (abs_Lalg != 1/4, error("wrong exact absolute algebraic L-value"));
if (valuation(abs_Lalg,2) != -2, error("wrong 2-adic valuation"));

print("pari_version=", version());
print("curve_ainvariants=[1,-1,1,-1,1]");
print("conductor=", N);
print("minimal_discriminant=", E.disc);
print("rational_torsion_order=", elltors(E)[1]);
print("modular_symbol_level=", msgetlevel(M));
print("modular_symbol_weight=", msgetweight(M));
print("modular_symbol_sign=", msgetsign(M));
print("new_plus_dimension=", #New[1]);
print("isolated_hecke_line_dimension=", matsize(H_coordinates)[2]);
print("hecke_data=", hecke_data);
print("canonical_plus_lattice_vector=", Lplus);
print("path=[oo,0]=[0]-[oo]");
print("canonical_plus_lattice_path_value=", integral_plus_value);
print("normalization=primitive_plus_lattice_generator_is_2*x_plus");
print("abs_L(E,1)/Omega_E_plus=", abs_Lalg);
print("v2_L_alg=", valuation(abs_Lalg,2));
print("result=PASS_EXACT_INTEGRAL_MODULAR_LATTICE");

quit;
