chunked(mp,phi,d,batch)={my(oms=mstooms(mp,phi),s=0,t);forstep(lo=1,abs(d)-1,batch,t=mschunk(mp,oms,d,lo,min(lo+batch,abs(d)));if(s==0,s=t,s[1]=lift(Mod(s[1]+t[1],5^t[3][2]))));s};

{p=5;nn=7;dd=329233;E0=ellinit([0,-1,1,-7820,-263580]);E=ellminimalmodel(elltwist(E0,dd));P=[[768989753271757/14455204,17024641241085675393245/54958685608],[1029644930091713/27164944,16034242814568548143769/141583688128]];if(!ellisoncurve(E,P[1]) || !ellisoncurve(E,P[2]),error("wrong twist model"));print("INPUT ",[E0[1..5],dd,E[1..5],P,p,nn]);print("START_NUMERATOR");gettime();[ms,phi]=msfromell(E0,1);mp=mspadicinit(ms,p,nn,0);mu=chunked(mp,phi,dd,2000);l0=mspadicL(mu,0,0);l1=mspadicL(mu,0,1);jj=mspadicL(mu,0,2)/2;if(type(jj)!="t_PADIC",error("invalid numerator"));print("NUMERATOR ",[l0,l1,jj]);ls=mspadicseries(mu);print("SERIES ",ls);writebin("outputs/combined329233_mu.bin",mu);print("NUMERATOR_TIME_MS ",gettime());rr=ellpadicregulator(E,p,nn+3,P);lg=log(1+p+O(p^(nn+5)));al=padicappr(x^2-ellap(E,p)*x+p,ellap(E,p)+O(p^(nn+5)))[1];ef=(1-al^-1)^2;qq=jj/(rr*ef)*elltors(E)[1]^2/ellglobalred(E)[3];print("VALUES ",[jj,rr,jj/lg^2,rr/lg^2,ef,qq]);print("VALUATIONS ",[valuation(jj,p),valuation(rr,p),valuation(jj/rr,p)]);print("PRECISION ",[padicprec(jj,p),padicprec(rr,p),padicprec(qq,p)]);print("DONE");}
quit;
