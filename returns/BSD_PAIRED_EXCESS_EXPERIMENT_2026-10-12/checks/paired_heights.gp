default(nbthreads,1);
lg(E,Q,p,np,pr)=ellpadiclog(E,p,pr,ellmul(E,[Q[1]+O(p^(pr+4)),Q[2]+O(p^(pr+4))],np))/np;
{A=ellinit([0,0,1,-19766893413,-1937478573143510]);F=ellinit([0,0,1,-14959712463303,-22270654620235278500]);P=[[1778638/9,1169009812/27],[6466626346478/36517849,2366996613841078836/220677361507]];Q=[[6288329,-11502941299],[8502485,21568458354]];M=[-1,3;-1,-2];ha=ellpadicheightmatrix(A,5,10,P)*[1,-ellpadics2(A,5,10)]~;hf=ellpadicheightmatrix(F,5,10,Q)*[1,-ellpadics2(F,5,10)]~;la=vector(2,i,lg(A,P[i],5,7,10)/5);lf=vector(2,i,lg(F,Q[i],5,7,10)/5);dif=M~*hf*M-5*ha;ld=lf*M-la;print("HEIGHT_A ",ha);print("HEIGHT_F ",hf);print("HEIGHT_IDENTITY_ERROR ",dif);print("LOG_IDENTITY_ERROR ",ld);print("RESIDUAL_A ",[lift(Mod(ha/5,5)),lift(Mod(la,5))]);print("RESIDUAL_F ",[lift(Mod(hf/5,5)),lift(Mod(lf,5))]);if(vecmin(vector(4,i,valuation(dif[(i+1)\2,1+(i-1)%2],5)))<10,error("height identity precision fails"));if(vecmin(vector(2,i,valuation(ld[i],5)))<8,error("log identity precision fails"));print("DONE");}
quit;
