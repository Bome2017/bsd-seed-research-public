{alarm(110);gettime();NF=read("nf.gp");FU=read("units_compact.gp");UU=FU[1];if(#UU!=14,error("expected13free+torsion"));LL=List();for(j=1,13,for(k=1,matsize(UU[j])[1],listput(LL,nfalgtobasis(NF,UU[j][k,1]))));FF=Set(Vec(LL));EX=matrix(#FF,13);for(j=1,13,for(k=1,matsize(UU[j])[1],ii=setsearch(FF,nfalgtobasis(NF,UU[j][k,1]));EX[ii,j]+=UU[j][k,2]));II=vector(#FF);PL=List();for(i=1,#FF,II[i]=idealfactor(NF,FF[i]);if(idealhnf(NF,FF[i])!=idealfactorback(NF,II[i][,1],II[i][,2]),error("literalprincipal reconstruction"));for(j=1,matsize(II[i])[1],listput(PL,idealhnf(NF,II[i][j,1]))));PP=Set(Vec(PL));DV=matrix(#PP,#FF);for(i=1,#FF,for(j=1,matsize(II[i])[1],k=setsearch(PP,idealhnf(NF,II[i][j,1]));DV[k,i]=II[i][j,2]));ZZ=DV*EX;if(ZZ!=matrix(#PP,13),error("nonunit divisor"));write("AUTHENTICATION_DATA.gp",[FF,PP,DV,EX,ZZ]);print("EXACT_FREE_UNIT_AUTHENTICATION_PASS;FREE_UNITS=13;FACTORS=",#FF,";PRIME_IDEALS=",#PP,";MS=",gettime());quit;}
