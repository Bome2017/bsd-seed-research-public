{alarm(110);gettime();C=read("field.gp");NF=read("nf.gp");SIG=C[7];OUT=List();for(i=1,3,my(l=[2,5,13][i],PR=idealprimedec(NF,l),H=vector(#PR,j,idealhnf(NF,PR[j])),P=matrix(#PR,#PR),pm=vector(#PR));for(j=1,#PR,my(h=nfgaloisapply(NF,SIG,H[j]),k=0);for(t=1,#PR,if(H[t]==h,k=t));if(k==0,error("ideal automorphism unmatched"));P[k,j]=1;pm[j]=k);if(P^4!=matid(#PR),error("prime permutation order"));my(K2=matker(Mod(P-2*matid(#PR),5)),K3=matker(Mod(P-3*matid(#PR),5)));listput(OUT,[l,vector(#PR,j,[PR[j].e,PR[j].f]),pm,P,K2,K3]);print("PRIME=",l,";EF=",vector(#PR,j,[PR[j].e,PR[j].f]),";SCALAR_PERMUTATION=",pm,";CHI2_DIM=",#K2,";CHI3_DIM=",#K3));write("divisors.gpout",Vec(OUT));print("DISCRIMINANT_FACTORIZATION=",factor(NF.disc));print("ACTUAL_DIVISOR_ACTION_PASS;MS=",gettime());quit;}
