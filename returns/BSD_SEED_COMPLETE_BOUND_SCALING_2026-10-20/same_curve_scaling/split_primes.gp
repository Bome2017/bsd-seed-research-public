{alarm(110);gettime();C=read("field.gp");F=C[4];den=denominator(lift(C[6][1]),1)*denominator(lift(C[6][2]),1)*denominator(lift(C[7]),1);OUT=List();forprime(q=7,100000,if(q%5!=1||den%q==0,next);my(rr=polrootsmod(F,q));if(#rr==24,listput(OUT,[q,lift(Vec(rr))]);if(#OUT==8,break)));write("split_primes.json",Vec(OUT));print("SPLIT_PRIME_SEARCH_COMPLETE;COUNT=",#OUT,";MS=",gettime());quit;}
