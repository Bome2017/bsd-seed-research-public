{alarm(110);C=read("field.gp");NF=read("nf.gp");E=C[1];DD=E.disc;FC=nffactor(NF,polcyclo(5,x));if(matsize(FC)[1]!=1||poldegree(FC[1,1])!=4,error("unexpected cyclotomic intersection"));OUT=[ellglobalred(E),DD,factor(DD),FC];write("source_checks.gpout",OUT);print("MODEL=",vector(5,i,E[i]),";CONDUCTOR=",ellglobalred(E)[1],";DISCRIMINANT_FACTORS=",factor(DD),";CYCLOTOMIC5_DEGREES=",vector(matsize(FC)[1],i,poldegree(FC[i,1])));print("SOURCE_CHECKS_COMPLETE");quit;}
