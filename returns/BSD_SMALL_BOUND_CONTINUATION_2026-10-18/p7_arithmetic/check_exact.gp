{alarm(58);gettime();C=read("raw_point_data.gp");E=C[1];F=C[3];T=C[6];SIG=C[7];if(poldegree(F)!=48||!polisirreducible(F),error("irreducibility"));if(elldivpol(E,7)!=C[2],error("division polynomial"));if(!ellisoncurve(E,T)||ellmul(E,T,7)!=[0],error("point"));if([subst(lift(T[1]),w,SIG),subst(lift(T[2]),w,SIG)]!=ellmul(E,T,3),error("scalarpoint"));SS=Mod(w,F);for(j=1,6,SS=subst(lift(SS),w,SIG);if((SS==Mod(w,F))!=(j==6),error("scalar exact order")));R=read("field.gp");if(subst(F,w,R[5])!=0,error("reduction"));if(R[6]!=[subst(lift(T[1]),w,R[5]),subst(lift(T[2]),w,R[5])],error("point binding"));if(subst(R[4],w,R[7])!=0,error("reduced scalarfield"));if([subst(lift(R[6][1]),w,R[7]),subst(lift(R[6][2]),w,R[7])]!=ellmul(E,R[6],3),error("reduced scalarpoint"));N=read("nf.gp");if(N.pol!=R[4]||N.sign!=[6,21]||N.disc!=-7^47*389^36,error("numberfield data"));if(E.disc!=389||ellap(E,389)!=1||ellap(E,7)!=-5,error("curve local data"));print("P7_EXACT_FIELD_POINT_SCALAR_REPLAY_PASS;MS=",gettime());quit;}
