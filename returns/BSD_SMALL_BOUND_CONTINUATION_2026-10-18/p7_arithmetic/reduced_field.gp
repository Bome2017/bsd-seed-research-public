{alarm(117);gettime();C=read("raw_point_data.gp");E=C[1];FY=C[3];RF=polredbest(FY,1);F=RF[1];Y2=RF[2];if(subst(FY,w,Y2)!=0,error("reduction binding"));T=[subst(lift(C[6][1]),w,Y2),subst(lift(C[6][2]),w,Y2)];if(!ellisoncurve(E,T)||ellmul(E,T,7)!=[0],error("actual torsion point"));write("reduced_field_rawpoint.gp",[F,Y2,T]);print("REDUCED_FIELD_AND_POINT_SAVED;MS=",gettime());NF=nfinit(F);write("nf.gp",NF);BT=matrix(48,48,i,j,polcoef(lift(Y2^(j-1)),i-1,w));ww=matsolve(BT,vector(48,i,polcoef(lift(Mod(w,F)),i-1,w))~);T3=ellmul(E,T,3);Y23=2*T3[2]+1;SIG=sum(i=1,48,ww[i]*Y23^(i-1));if(subst(F,w,SIG)!=0,error("scalar field"));if([subst(lift(T[1]),w,SIG),subst(lift(T[2]),w,SIG)]!=T3,error("scalar point"));write("field.gp",[E,C[2],FY,F,Y2,T,SIG]);print("FIELD_SIGNATURE=",NF.sign,";DISC=",NF.disc,";MS=",gettime());quit;}
