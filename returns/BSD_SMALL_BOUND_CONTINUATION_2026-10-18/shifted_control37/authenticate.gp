{alarm(30); C=read("/Users/bsm/BSD_COMPANION_CLASS_AND_CHARACTER_EXPERIMENT_2026-10-15/p5_arithmetic/control37/field.gp"); NF=read("/Users/bsm/BSD_COMPANION_CLASS_AND_CHARACTER_EXPERIMENT_2026-10-15/p5_arithmetic/control37/nf.gp");T=C[6];SIG=C[7];h=2*(T[1]+T[2]); if(norm(h)!=-2^28/5^3,error("norm wrong")); H=[h];for(i=2,4,H=concat(H,[subst(lift(H[#H]),w,SIG)])); ex=[4,2,1,3]; PR2=idealprimedec(NF,2);PR5=idealprimedec(NF,5); all=concat(PR2,PR5); V=matrix(#all,4,i,j,idealval(NF,H[j],all[i])); P=V*ex~;write("AUTHENTICATION_DATA.gp",[h,H,vector(#all,i,[all[i].p,all[i].e,all[i].f]),V,P]); print("NORM_H=",norm(h));print("LOCAL_FACTORS=",vector(#all,i,[all[i].p,all[i].e,all[i].f]));print("VALUATIONS_H_COLUMNS=",V);print("PROJECTED_VALUATIONS=",P);print("MOD5_PROJECTED_VALUATIONS=",lift(Mod(P,5)));print("AUTHENTICATION_COMPLETE");quit;}
