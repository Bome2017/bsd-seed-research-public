{alarm(15); E=ellinit([0,0,1,-1,0]);D=elldivpol(E,5);good=List();forprime(q=7,10000,if(q==37||q%5!=1,next);r=polrootsmod(D,q);if(#r!=12,next);ok=1;for(i=1,12,if(kronecker(lift(4*r[i]^3-4*r[i]+1),q)!=1,ok=0));if(!ok,next);pts=List();for(i=1,12,my(wr=sqrt(4*r[i]^3-4*r[i]+1));listput(pts,[lift(r[i]),lift((wr-1)/2)]);listput(pts,[lift(r[i]),lift((-wr-1)/2)]));listput(good,[q,Vec(pts)]);if(#good>=3,break));write("SPLIT_POINTS.json",Vec(good));print("split q=",vector(#good,i,good[i][1]));quit;}
