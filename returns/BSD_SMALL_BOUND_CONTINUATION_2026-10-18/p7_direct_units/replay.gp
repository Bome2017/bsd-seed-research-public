{alarm(20);gettime();NF=read("../p7_arithmetic/nf.gp");LS=readstr("norm_rows.gp");if(#LS!=2000,error("rowcount"));NN=0;MIN=0;for(k=1,#LS,my(r=eval(LS[k]),l=r[2],v);if(r[1]!=k,error("index"));if(l[1]=="basis",v=vector(48,j,if(j==l[2],1,0))~,if(l[1]=="shift",v=nfalgtobasis(NF,Mod(w+l[2],NF.pol)),if(l[1]=="pair",v=vector(48,j,if(j==l[2],1,if(j==l[3],l[4],0)))~,error("kind"))));my(n=nfeltnorm(NF,v));if(n!=r[3],error("norm mismatch"));if(abs(n)==1,NN++);if(k==1||abs(n)<MIN,MIN=abs(n)));if(NN!=0,error("unexpected unit"));if(nfeltnorm(NF,vector(48,j,j==2)~)!=-7^15,error("S-unit witness"));print("DIRECT_UNIT_NORM_REPLAY_PASS;ROWS=",#LS,";NORM_ONE=",NN,";MIN_ABS=",MIN,";MS=",gettime());quit;}
