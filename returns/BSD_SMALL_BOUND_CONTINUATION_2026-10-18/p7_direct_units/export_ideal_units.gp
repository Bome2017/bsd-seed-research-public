pack(a)={my(b=lift(a),den=denominator(b,1));[vector(48,i,polcoef(b*den,i-1,w)),den]};
{alarm(18);gettime();C=read("../p7_arithmetic/field.gp");NF=read("../p7_arithmetic/nf.gp");RR=readstr("ideal_unit_candidates.gp");UU=List();for(j=1,#RR,my(r=eval(RR[j]));if(idealhnf(NF,r[3])!=r[5]||idealhnf(NF,r[4])!=r[5],error("unit authentication"));listput(UU,[r[1],r[2],pack(nfbasistoalg(NF,r[3])),pack(nfbasistoalg(NF,r[4]))]));write("ideal_units_eval.json",[vector(49,i,polcoef(C[4],i-1,w)),pack(C[6][1]),pack(C[6][2]),pack(C[7]),Vec(UU)]);print("ACTUAL_IDEAL_UNIT_EXPORT_PASS;UNITS=",#RR,";MS=",gettime());quit;}
