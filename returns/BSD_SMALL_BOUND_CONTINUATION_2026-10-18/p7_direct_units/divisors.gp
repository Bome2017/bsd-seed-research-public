{alarm(28);gettime();C=read("../p7_arithmetic/field.gp");NF=read("../p7_arithmetic/nf.gp");SIG=C[7];OUT=List();for(i=1,2,my(l=[7,389][i],PR=idealprimedec(NF,l),H=vector(#PR,j,idealhnf(NF,PR[j])),P=matrix(#PR,#PR),pm=vector(#PR));for(j=1,#PR,my(h=nfgaloisapply(NF,SIG,H[j]),k=0);for(t=1,#PR,if(H[t]==h,k=t));if(k==0,error("ideal automorphism unmatched"));P[k,j]=1;pm[j]=k);if(P^6!=matid(#PR),error("prime permutation order"));my(K=matker(Mod(P-3*matid(#PR),7)));listput(OUT,[l,vector(#PR,j,[PR[j].e,PR[j].f]),pm,P,K]);print("PRIME=",l,";EF=",vector(#PR,j,[PR[j].e,PR[j].f]),";SCALAR_PERMUTATION=",pm,";CHI3_DIM=",#K));write("divisors.gpout",Vec(OUT));print("ACTUAL_DIVISOR_ACTION_PASS;MS=",gettime());quit;}
