{alarm(57);gettime();NF=read("../p7_arithmetic/nf.gp");C=read("../p7_arithmetic/field.gp");S=C[7];AM=matrix(48,48,i,j,nfalgtobasis(NF,nfgaloisapply(NF,S,NF.zk[j]))[i]);if(AM^6!=matid(48),error("automorphism basis order"));AA=[AM,AM^2,AM^3];LL=read("candidates.gp");UC=0;for(k=1,#LL,my(l=LL[k],v);if(l[1]=="shift",v=nfalgtobasis(NF,Mod(w+l[2],NF.pol)),v=vector(48,j,if(j==l[2],1,0))~;if(l[1]=="pair",v[l[3]]+=l[4]));my(ID=idealhnf(NF,v),used=0);for(j=1,3,my(vv=AA[j]*v);if(vv==v||vv==-v,next);my(JD=idealhnf(NF,vv));if(ID==JD,write("ideal_unit_candidates.gp",[k,j,v,vv,ID]);UC++;used=1;print("ACTUAL_UNIT;CANDIDATE=",k,";SCALAR_POWER=",j,";COUNT=",UC);break));write("ideal_scan_rows.gp",[k,used]);if(UC>=64,break));write("basis_scalar_matrix.gp",AM);print("IDEAL_UNIT_SCAN_COMPLETE;THROUGH=",k,";UNITS=",UC,";MS=",gettime());quit;}
