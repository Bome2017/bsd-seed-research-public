pack(a)={my(b=lift(a),den=denominator(b,1));[vector(48,i,polcoef(b*den,i-1,w)),den]};
{alarm(28);gettime();C=read("../p7_arithmetic/field.gp");NF=read("../p7_arithmetic/nf.gp");S=C[7];S2=subst(lift(S),w,S);a=nfbasistoalg(NF,vector(48,j,j==2)~);if(nfeltnorm(NF,a)!=-7^15,error("support norm"));a2=nfgaloisapply(NF,S2,a);I=idealhnf(NF,a);I2=idealhnf(NF,a2);if(I!=I2,error("ordinary unit ideal"));v=a2/a;if(nfeltnorm(NF,v)!=1,error("unit norm"));write("UNIT_AUTHENTICATION.gp",[a,a2,I,I2,v]);write("eval_data.json",[vector(49,i,polcoef(C[4],i-1,w)),pack(C[6][1]),pack(C[6][2]),pack(C[7]),pack(a)]);print("AUTHENTICATED_ORDINARY_UNIT;TRIVIAL=",v==1||v==-1,";MS=",gettime());quit;}
