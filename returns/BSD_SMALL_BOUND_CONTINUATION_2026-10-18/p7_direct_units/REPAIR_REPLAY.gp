{alarm(18);gettime();NF=read("../p7_arithmetic/nf.gp");C=read("../p7_arithmetic/field.gp");S=C[7];AM=read("basis_scalar_matrix.gp");for(j=1,48,if(AM[,j]!=nfalgtobasis(NF,nfgaloisapply(NF,S,NF.zk[j])),error("scalar basis column")));if(AM^6!=matid(48),error("order"));V=read("divisors.gpout");PR=idealprimedec(NF,7);if(V[1][3]!=[1,3,2],error("prime permutation recorded"));for(j=1,#PR,if(idealhnf(NF,nfgaloisapply(NF,S,PR[j]))!=idealhnf(NF,PR[V[1][3][j]]),error("prime permutation")));A=read("UNIT_AUTHENTICATION.gp");if(A[1]!=nfbasistoalg(NF,vector(48,j,j==2)~)||nfeltnorm(NF,A[1])!=-7^15,error("actual candidate"));if(A[2]!=nfgaloisapply(NF,subst(lift(S),w,S),A[1])||A[2]!=A[1]||A[5]!=1,error("trivial repaired unit"));print("REPAIR_REPLAY_PASS;SCALAR_COLUMNS=48;P7_PRIMES=3;CANDIDATE_UNIT=1;MS=",gettime());quit;}
