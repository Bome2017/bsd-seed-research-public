normalize(a,f)=Mod(subst(lift(a),variable(lift(a)),variable(f)),f);
{alarm(20);base="../class_map/authentication/1664n1/";C=read(Str(base,"ideal_map_certificate.gp"));D=read(Str(base,"data.gp"));BA=read(Str(base,"bnf.bin"));nf=nfinit(C[1]);E=D[1];T=D[5];gg=nfgaloisconj(nf);tau=0;for(i=1,#gg,if(nfgaloisapply(nf,gg[i],T[1])==T[1]&&nfgaloisapply(nf,gg[i],T[2])==-T[2]-E.a1*T[1]-E.a3,tau=gg[i]));if(tau==0,error("no negation"));cl=bnfisprincipal(BA,C[5],0);tc=bnfisprincipal(BA,nfgaloisapply(nf,tau,C[5]),0);for(i=1,#cl,if((tc[i]+cl[i])%BA.cyc[i],error("not faithful")));P=D[2][1];lam=(3*T[1]^2+2*E.a2*T[1]+E.a4-E.a1*T[2])/(2*T[2]+E.a1*T[1]+E.a3);fP=P[2]-lam*P[1]-(T[2]-lam*T[1]);F=idealfactor(nf,fP);J=matid(8);for(i=1,matsize(F)[1],if(F[i,2]%3,error("point nonordinary"));J=idealmul(nf,J,idealpow(nf,F[i,1],F[i,2]/3)));if(idealpow(nf,J,3)!=idealhnf(nf,fP),error("point divisor"));pc=bnfisprincipal(BA,J,0);if(pc==0*pc,error("point class zero"));print("INDEPENDENT_FAITHFUL_CLASS_AND_RATIONAL_POINT_OCCUPANCY_OK=1664n1;CLASS=",BA.cyc,";CLASS_COORD=",cl,";POINT_CLASS=",pc);quit;}
