{alarm(20);base="../class_map/authentication/1664n1/";D=read(Str(base,"data.gp"));nf=nfinit(D[3]);E=D[1];T=D[5];G=nfgaloisconj(nf);tau=0;for(i=1,#G,if(nfgaloisapply(nf,G[i],T[1])==T[1]&&nfgaloisapply(nf,G[i],T[2])==-T[2]-E.a1*T[1]-E.a3,tau=G[i]));if(!tau,error("negation"));ps=Set(concat([3],factor(abs(E.disc))[,1]~));dims=List();for(k=1,#ps,my(pr=idealprimedec(nf,ps[k]),H=vector(#pr,j,idealhnf(nf,pr[j])),A=matrix(#pr,#pr));for(j=1,#pr,my(J=idealhnf(nf,nfgaloisapply(nf,tau,pr[j])),found=0);for(i=1,#pr,if(J==H[i],A[i,j]=1;found++));if(found!=1,error("prime orbit")));if(A*A!=matid(#pr),error("involution"));my(d=#matker(Mod(A+matid(#pr),3)));listput(dims,[ps[k],#pr,d]);print("VALUATION_ACTION=",[ps[k],#pr,A,d]));if(sum(i=1,#dims,dims[i][3])!=0,error("nonzero valuation allowance"));print("INDEPENDENT_FAITHFUL_S_VALUATION_ALLOWANCE_ZERO=1664n1;S=",ps);quit;}
