normalize(a,f)=Mod(subst(lift(a),variable(lift(a)),variable(f)),f);
{alarm(30);base="../class_map/authentication/1664n1/";C=read(Str(base,"ideal_map_certificate.gp"));BA=read(Str(base,"bnf.bin"));BB=read(Str(base,"certified_target_bnf.bin"));NF=nfinit(C[1]);NB=BB.nf;UV=matrix(#BB.fu,#BA.fu);for(j=1,#BA.fu,my(u=normalize(BA.fu[j],C[1]),nu=norm(subst(lift(u),variable(C[1]),C[4])),nv=normalize(nu,NB.pol),cs=bnfisunit(BB,nv));if(#cs!=#BB.fu+1,error("not unit"));if(nu!=C[12][j],error("norm mismatch"));UV[,j]=vector(#BB.fu,i,cs[i])~;my(re=prod(i=1,#BB.fu,BB.fu[i]^cs[i])*BB.tu[2]^cs[#cs]);if(re!=nv,error("coordinate identity")));if(UV!=C[13],error("saved unit map"));if(#BA.fu!=4||#BB.fu!=4||matrank(Mod(UV,3))!=3||#select(x->x%3==0,BA.cyc)!=1||BA.tu[1]%3==0||BB.tu[1]%3==0,error("complete norm dimension hypotheses"));print("INDEPENDENT_FULL_UNIT_MAP_RANK_OK=1664n1;MATRIX=",UV,";MOD3_RANK=",matrank(Mod(UV,3)),";SOURCE_UNITS=",#BA.fu,";SOURCE_CLASS_3_DIM=1;ORDINARY_NORM_KERNEL_DIM=2");quit;}
