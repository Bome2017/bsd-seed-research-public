{alarm(20);A=read("../partial_relations/inputs/basis_scalar_matrix.gp");W=apply(eval,readstr("../partial_relations/private_pivots.gp.data"));ORB=apply(eval,readstr("../partial_relations/scalar_orbits.gp.data"));if(A^6!=matid(48)||#ORB!=80,error("order/count"));for(i=1,80,if(ORB[i][1]!=i||ORB[i][2]!=W[i][2]||#Set(ORB[i][3])!=6,error("orbit data"));for(j=1,6,if(ORB[i][3][j]!=mathnf(A^(j-1)*W[i][3]),error("orbit HNF"))));D=matrix(6,6,i,j,(i==j)-(i==1+(j+2)%6));if(matrank(D)!=3||matrank(Mod(D,7))!=3,error("rank"));v=D*[6,2,3,1,5,4]~;if(lift(Mod(v,7))!=[5,4,6,2,3,1]~,error("projection"));print("INDEPENDENT_SCALAR_ORBIT_REPLAY_OK=80;Q_AND_F7_BLOCK_RANK=3;FAITHFUL_BLOCK_NONZERO=1");quit;}
