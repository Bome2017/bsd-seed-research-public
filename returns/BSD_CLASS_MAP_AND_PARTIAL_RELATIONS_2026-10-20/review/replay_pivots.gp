{alarm(50);NF=read("../partial_relations/inputs/nf.gp.gz");A=read("../partial_relations/inputs/basis_scalar_matrix.gp");tau=A^3;R=apply(eval,readstr("../partial_relations/reconstructed.gp"));W=apply(eval,readstr("../partial_relations/private_pivots.gp.data"));if(#R!=80||#W!=80,error("length"));for(i=1,80,my(q=W[i][2],P=W[i][3],Q=W[i][4],a=R[i][3],na=nfeltnorm(NF,a));if(W[i][1]!=i||R[i][1]!=i,error("index"));if(denominator(a,1)!=1,error("nonintegral alpha"));if(na!=R[i][2][6]||valuation(abs(na),q)!=1,error("norm"));if(!isprime(q),error("not prime"));if(P!=idealadd(NF,idealhnf(NF,a),idealhnf(NF,q)),error("wrong P"));if(matdet(P)!=q||matdet(Q)!=q,error("prime norms"));if(mathnf(tau*P)!=Q||mathnf(tau*Q)!=P||P==Q,error("tau"));if(denominator(P^-1*a,1)!=1||denominator(Q^-1*a,1)==1,error("membership"));if(denominator(P^-1*(tau*a),1)==1||denominator(Q^-1*(tau*a),1)!=1,error("conjugate membership")));print("INDEPENDENT_IDEAL_PIVOT_REPLAY_OK=80");quit;}
