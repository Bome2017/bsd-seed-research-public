normalize(a,f)=Mod(subst(lift(a),variable(lift(a)),variable(f)),f);
{alarm(30);forcase=["mirror389","1664n1"];for(k=1,#forcase,my(base=Str("../class_map/authentication/",forcase[k],"/"),C=read(Str(base,"ideal_map_certificate.gp")),BA=read(Str(base,"bnf.bin")),f=C[1],g=C[2],NF=nfinit(f),NG=nfinit(g),embedding=C[4],beta=normalize(C[6],f),rho=normalize(C[9],g),vu=normalize(C[10],g),root=normalize(C[16],g),imgs=C[12],repair=1,nu,cl);if(subst(f,variable(f),embedding)!=0,error("embedding"));nu=norm(subst(lift(beta),variable(f),embedding));if(idealpow(NF,C[5],3)!=idealhnf(NF,beta),error("source ideal identity"));if(idealpow(NG,C[8],3)!=idealhnf(NG,nu),error("target ideal identity"));if(idealhnf(NG,rho)!=C[8],error("rho ideal"));if(vu!=nu/rho^3||idealhnf(NG,vu)!=matid(8),error("unit remainder"));for(j=1,#C[11],my(u=normalize(C[11][j],f),v=normalize(imgs[j],g));if(idealhnf(NF,u)!=matid(8)||norm(subst(lift(u),variable(f),embedding))!=v,error("unit norm"));repair*=v^lift(C[15][j]));if(vu!=repair*root^3,error("literal connecting repair"));cl=bnfisprincipal(BA,C[5],0);if(cl==0*cl||vector(#cl,i,(3*cl[i])%BA.cyc[i])~!=0*cl,error("nontrivial order three source"));print("INDEPENDENT_CLASS_IDEAL_AND_CONNECTING_REPLAY_OK=",forcase[k]));quit;}
