{alarm(17);AM=read("/Users/bsm/BSD_RELATIVE_UNIT_EXECUTION_2026-10-18/inputs/basis_scalar_matrix.gp");if(AM^6!=matid(48),error("scalarorder"));W=apply(eval,readstr("private_pivots.gp.data"));for(k=1,#W,my(P=W[k][3],OO=vector(6,j,mathnf(AM^(j-1)*P)));if(#Set(OO)!=6 || OO[4]!=W[k][4] || mathnf(AM*OO[6])!=P,error("orbit"));write("scalar_orbits.gp.data",[k,W[k][2],OO]));DD=matrix(6,6,i,j,(i==j)-(i==((j+2)%6+1)));weights=[6,2,3,1,5,4]~;vv=Mod(DD,7)*Mod(weights,7);SS=matrix(6,6,i,j,i==(j%6+1));if(SS*vv!=3*vv || matrank(DD)!=3 || matrank(Mod(DD,7))!=3 || vv==vector(6,i,Mod(0,7))~,error("scalar character block"));write("SCALAR_PIVOT_RESULT.gp",[#W,DD,lift(vv),matrank(DD),matrank(Mod(DD,7))]);print("SCALAR_PIVOT_COMPLETE=",[#W,lift(vv),matrank(DD),matrank(Mod(DD,7))]);quit;}
