{alarm(115);NF=read("/Users/bsm/BSD_RELATIVE_UNIT_EXECUTION_2026-10-18/inputs/nf.gp");AM=read("/Users/bsm/BSD_RELATIVE_UNIT_EXECUTION_2026-10-18/inputs/basis_scalar_matrix.gp");TA=AM^3;AR=apply(eval,readstr("reconstructed.gp"));PR=read("private.gp");OK=0;for(k=1,#AR,my(v=AR[k][3],nm=abs(AR[k][2][6]),ff=factor(PR[k]),q=0);for(i=1,matsize(ff)[1],my(t=ff[i,1]);if(valuation(nm,t)==1,q=t;break));if(!q,write("pivot_missing.gp",[k,ff]);print("NO_SIMPLE_PRIVATE_PRIME=",k);next);if(!isprime(q),error("prime proof"));my(P=idealadd(NF,idealhnf(NF,v),idealhnf(NF,q)),TP=mathnf(TA*P));if(idealnorm(NF,P)!=q,error("not degree-one prime"));if(P==TP,error("tau fixed private prime"));if(denominator(matsolve(P,v),1)!=1 || denominator(matsolve(idealmul(NF,P,P),v),1)==1 || denominator(matsolve(TP,v),1)==1,error("private valuations"));if(mathnf(TA*TP)!=P,error("tau involution"));write("private_pivots.gp.data",[k,q,P,TP]);OK++;print("PRIVATE_PIVOT_AUTH=",k,";Q=",q));write("PIVOT_GATE.gp",[#AR,OK]);print("PRIVATE_PIVOT_COMPLETE=",[#AR,OK]);quit;}
