{alarm(115);default(realprecision,180);NF=read("/Users/bsm/BSD_RELATIVE_UNIT_EXECUTION_2026-10-18/inputs/nf.gp");C=read("/Users/bsm/BSD_RELATIVE_UNIT_EXECUTION_2026-10-18/inputs/field.gp");AM=read("/Users/bsm/BSD_RELATIVE_UNIT_EXECUTION_2026-10-18/inputs/basis_scalar_matrix.gp");TA=AM^3;SU=read("/Users/bsm/BSD_RELATIVE_UNIT_EXECUTION_2026-10-18/source/setup.gp");IDS=SU[2];DD=read("/Users/bsm/BSD_RELATIVE_UNIT_EXECUTION_2026-10-18/source/WEIGHT_DIRECTIONS.gp")[2];MM=precision(NF[5][1],180);r1=NF.sign[1];r2=NF.sign[2];GG=matrix(48,48,i,j,if(i<=r1,real(MM[i,j]),if((i-r1)%2,sqrt(2)*real(MM[r1+(i-r1+1)/2,j]),sqrt(2)*imag(MM[r1+(i-r1)/2,j]))));levels=[2,4,8,16,32,64];SR=read("selected.gp");CACHE=Map();for(k=1,#SR,my(z=SR[k],stage=z[1],lev=z[2],d=z[3],id=z[4],c=z[5],BB);if(!mapisdefined(CACHE,stage,&BB),my(ww=levels[lev]*DD[d],WG=matrix(48,48,i,j,2^ww[if(i<=r1,i,r1+(i-r1+1)\2)]*GG[i,j]),TT=qflll(round(2^192*WG)*IDS[id][2]));if(abs(matdet(TT))!=1,error("LLL non-unimodular"));BB=IDS[id][2]*TT;mapput(CACHE,stage,BB));my(L=List());for(i=1,12,listput(L,BB[,i]));for(i=2,4,for(j=1,i-1,listput(L,BB[,i]+BB[,j]);listput(L,BB[,i]-BB[,j])));my(v=L[c],tv=TA*v,nm=nfeltnorm(NF,v));if(nm!=z[6],error("reconstruction norm mismatch"));if(v==tv || v==-tv,error("not mixed"));write("reconstructed.gp",[k,z,v]);print("RECONSTRUCTED=",k));print("RECONSTRUCTION_COMPLETE");quit;}
