{alarm(18);gettime();C=read("../small_conductor7/field.gp");NF=read("../small_conductor7/nf.gp");E=C[1];SIG=C[7];A=read("ACTUAL_DIVISORS.json");if(E.disc!=-11^5||E.c4!=496||ellap(E,7)!=-2,error("curve data"));for(k=1,#A,my(PR=idealprimedec(NF,A[k][1]));if(vector(#PR,j,[PR[j].e,PR[j].f])!=A[k][2],error("ef"));for(j=1,#PR,if(idealhnf(NF,nfgaloisapply(NF,SIG,PR[j]))!=idealhnf(NF,PR[A[k][3][j]]),error("scalarideal"))));if(Mod(5,11)^2!=3,error("split tangent"));print("ACTUAL_LOCAL_REPLAY_PASS;PLACES=2;MONODROMY=5;MS=",gettime());quit;}
