{alarm(28);gettime();C=read("../small_conductor7/field.gp");NF=read("../small_conductor7/nf.gp");SIG=C[7];E=C[1];if(E.disc!=-11^5||ellap(E,11)!=1||ellap(E,7)!=-2,error("local seed data"));OUT=List();for(i=1,2,my(l=[7,11][i],PR=idealprimedec(NF,l),H=vector(#PR,j,idealhnf(NF,PR[j])),P=matrix(#PR,#PR),pm=vector(#PR));for(j=1,#PR,my(h=nfgaloisapply(NF,SIG,H[j]),k=0);for(t=1,#PR,if(H[t]==h,k=t));if(k==0,error("ideal automorphism unmatched"));P[k,j]=1;pm[j]=k);if(P^6!=matid(#PR),error("prime permutation order"));my(K3=matker(Mod(P-3*matid(#PR),7)),K5=matker(Mod(P-5*matid(#PR),7)));listput(OUT,[l,vector(#PR,j,[PR[j].e,PR[j].f]),pm,vector(#K3,j,Vec(lift(K3[,j]))),vector(#K5,j,Vec(lift(K5[,j])))]);print("PRIME=",l,";EF=",vector(#PR,j,[PR[j].e,PR[j].f]),";SCALAR_PERMUTATION=",pm,";CHI3_DIM=",#K3,";CHI5_DIM=",#K5));write("ACTUAL_DIVISORS.json",Vec(OUT));print("ACTUAL_DIVISOR_ACTION_PASS;MS=",gettime());quit;}
