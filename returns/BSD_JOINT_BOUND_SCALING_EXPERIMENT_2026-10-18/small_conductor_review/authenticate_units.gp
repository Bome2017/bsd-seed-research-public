{alarm(108);gettime();NF=read("../small_conductor7/nf.gp");FU=read("../small_conductor7/units_compact.gp");UU=FU[1];if(#UU!=27,error("expected26free+torsion"));LL=List();for(j=1,26,for(k=1,matsize(UU[j])[1],listput(LL,nfalgtobasis(NF,UU[j][k,1]))));FF=Set(Vec(LL));EX=matrix(#FF,26);for(j=1,26,for(k=1,matsize(UU[j])[1],ii=setsearch(FF,nfalgtobasis(NF,UU[j][k,1]));EX[ii,j]+=UU[j][k,2]));II=vector(#FF);PL=List();print("UNIQUE_FACTORS=",#FF);for(i=1,#FF,II[i]=idealfactor(NF,FF[i]);if(idealhnf(NF,FF[i])!=idealfactorback(NF,II[i][,1],II[i][,2]),error("principal reconstruction"));for(j=1,matsize(II[i])[1],listput(PL,idealhnf(NF,II[i][j,1]))));PP=Set(Vec(PL));DV=matrix(#PP,#FF);for(i=1,#FF,for(j=1,matsize(II[i])[1],k=setsearch(PP,idealhnf(NF,II[i][j,1]));DV[k,i]=II[i][j,2]));ZZ=DV*EX;if(ZZ!=matrix(#PP,26),error("nonunit divisor"));write("AUTHENTICATION_DATA.gp",[FF,PP,DV,EX,ZZ]);write("UNIT_DIVISOR_MATRIX.json",[vector(matsize(DV)[1],i,Vec(DV[i,])),vector(matsize(EX)[1],i,Vec(EX[i,]))]);print("EXACT_FREE_UNIT_AUTHENTICATION_PASS;FREE_UNITS=26;FACTORS=",#FF,";PRIME_IDEALS=",#PP,";MS=",gettime());quit;}
