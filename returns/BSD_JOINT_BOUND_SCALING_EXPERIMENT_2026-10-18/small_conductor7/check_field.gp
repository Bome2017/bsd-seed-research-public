{alarm(27);C=read("field.gp");NF=read("nf.gp");E=ellinit([0,-1,1,-10,-20]);F=C[4];T=C[6];s=C[7];if(NF.pol!=F||poldegree(F)!=48||!polisirreducible(F),error("field"));if(E.disc!=-11^5||ellap(E,7)!=-2||ellap(E,11)!=1,error("curve"));if(NF.sign!=[6,21]||NF.disc!=-7^47*11^36,error("field invariants"));if(!ellisoncurve(E,T)||ellmul(E,T,7)!=[0],error("universal point"));if([subst(lift(T[1]),w,s),subst(lift(T[2]),w,s)]!=ellmul(E,T,3),error("scalar"));a=Mod(w,F);for(j=1,6,a=subst(lift(a),w,s);if(j<6&&a==Mod(w,F),error("short scalar orbit")));if(a!=Mod(w,F),error("scalar order6"));if(subst(C[3],w,C[5])!=0,error("raw-reduced binding"));print("INDEPENDENT_FIELD_POINT_SCALAR_CHECK_PASS");quit;}
