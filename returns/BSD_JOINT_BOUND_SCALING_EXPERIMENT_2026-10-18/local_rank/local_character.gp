packelt(v,F)={Mod(Polrev(v[1],w)/v[2],F)};
{alarm(28);gettime();NF=read("/Users/bsm/BSD_SMALL_BOUND_CONTINUATION_2026-10-18/p7_arithmetic/nf.gp");C=read("compact_units_batch1.json");F=Polrev(C[1],w);SIG=packelt(C[4],F);PR=idealprimedec(NF,7);P=PR[1];if(P.e!=6||P.f!=1,error("wrong prime"));bid=idealstar(NF,idealpow(NF,P,8),2,7);G=bid.gen;d=#G;ACT=matrix(d,d);for(j=1,d,ACT[,j]=ideallog(NF,nfgaloisapply(NF,SIG,G[j]),bid));ACT=Mod(ACT,7);if(ACT^6!=matid(d),error("local action order"));W=[6,2,3,1,5,4];PC=sum(j=0,5,W[j+1]*ACT^j);if(PC^2!=PC||ACT*PC!=3*PC,error("projector"));write("local_character.json",[bid.cyc,vector(d,i,Vec(lift(ACT[i,]))),vector(d,i,Vec(lift(PC[i,]))),matrank(PC)]);print("LOCAL_CHARACTER_COMPLETE;DIM=",d,";CHI_DIM=",matrank(PC),";MS=",gettime());quit;}
