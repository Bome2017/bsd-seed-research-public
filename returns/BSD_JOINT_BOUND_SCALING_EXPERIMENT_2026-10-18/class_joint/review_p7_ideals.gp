{alarm(110);gettime();NF=read("/Users/bsm/BSD_SMALL_BOUND_CONTINUATION_2026-10-18/p7_arithmetic/nf.gp");AM=read("/Users/bsm/BSD_SMALL_BOUND_CONTINUATION_2026-10-18/p7_direct_units/basis_scalar_matrix.gp");FR=apply(eval,readstr("../p7_new_source/factor_records.gp"));OLD=read("../p7_new_source/DIVISOR_RELATIONS.gp");L=List();PSET=List();for(k=1,#FR,my(v=FR[k][3]);for(j=0,5,my(FAC=idealfactor(NF,v),II=vector(matsize(FAC)[1],h,idealhnf(NF,FAC[h,1])),ee=Vec(FAC[,2]));if(idealhnf(NF,v)!=idealfactorback(NF,II,ee),error("fresh factor reconstruction"));my(col=(k-1)*6+j+1,old=OLD[4][col]);if(idealhnf(NF,v)!=idealfactorback(NF,old[3],old[4]),error("producer orbit binding"));listput(L,[II,ee]);for(h=1,#II,listput(PSET,II[h]));v=AM*v));PS=Set(Vec(PSET));L=Vec(L);D=matrix(#PS,#L);for(j=1,#L,for(h=1,#L[j][1],D[setsearch(PS,L[j][1][h]),j]+=L[j][2][h]));if(PS!=OLD[1]||D!=OLD[2],error("independent divisor matrix differs"));K=OLD[3];if(D*K!=matrix(#PS,matsize(K)[2]),error("not actual integer relations"));write("DIVISOR_KERNEL_REVIEW.json",[vector(matsize(D)[1],i,Vec(D[i,])),vector(matsize(K)[1],i,Vec(K[i,]))]);print("P7_IDEAL_REVIEW_PASS;FRESH_FACTORIZATIONS=",#L,";PRIME_ROWS=",#PS,";INTEGER_RELATIONS=",matsize(K)[2],";MS=",gettime());quit;}
