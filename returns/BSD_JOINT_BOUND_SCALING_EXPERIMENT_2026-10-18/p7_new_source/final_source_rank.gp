{alarm(18);OUT=List();for(k=1,3,my(dir=["","mixed_source/","combined_source/"][k],V=read(Str(dir,"DIVISOR_RELATIONS.gp")),W=read(Str(dir,"MERGED_RELATIONS.gp")),D=V[2],K=V[3]);listput(OUT,[dir,matsize(D),matrank(D),matrank(Mod(D,7)),matsize(K),matrank(Mod(K,7)),#W[1],W[3]==matrix(#W[1],matsize(K)[2])]););write("FINAL_SOURCE_RANKS.gp",Vec(OUT));print("FINAL_SOURCE_RANKS=",Vec(OUT));quit;}
