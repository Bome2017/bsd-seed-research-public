{alarm(117);gettime();NF=read("../../../BSD_SMALL_BOUND_CONTINUATION_2026-10-18/p7_arithmetic/nf.gp");LL=read("selected.gp");for(k=1,#LL,my(r=LL[k],l=r[2],v);if(l[1]=="shift",v=nfalgtobasis(NF,Mod(w+l[2],NF.pol)),v=vector(48,j,if(j==l[2],1,0))~;if(l[1]=="pair",v[l[3]]+=l[4]));if(nfeltnorm(NF,v)!=r[3],error("norm source binding"));my(FAC=idealfactor(NF,v));if(idealhnf(NF,v)!=idealfactorback(NF,FAC[,1],FAC[,2]),error("principal reconstruction"));write("factor_records.gp",[k,r[1],v,vector(matsize(FAC)[1],j,idealhnf(NF,FAC[j,1])),Vec(FAC[,2])]);print("PRINCIPAL_FACTOR_SAVED;INDEX=",k,";ORIGINAL=",r[1],";PRIMES=",matsize(FAC)[1]));print("ALL_PRINCIPAL_FACTORS_AUTHENTICATED;COUNT=",#LL,";MS=",gettime());quit;}
