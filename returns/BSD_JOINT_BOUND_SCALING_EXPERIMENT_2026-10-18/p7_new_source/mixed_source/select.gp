{alarm(28);gettime();NF=read("../../../BSD_SMALL_BOUND_CONTINUATION_2026-10-18/p7_arithmetic/nf.gp");AM=read("../../../BSD_SMALL_BOUND_CONTINUATION_2026-10-18/p7_direct_units/basis_scalar_matrix.gp");AA=AM^3;RR=apply(eval,readstr("../../../BSD_SMALL_BOUND_CONTINUATION_2026-10-18/p7_direct_units/norm_rows.gp"));MM=List();PP=0;for(k=1,#RR,my(r=RR[k],l=r[2],v);if(l[1]=="shift",v=nfalgtobasis(NF,Mod(w+l[2],NF.pol)),v=vector(48,j,if(j==l[2],1,0))~;if(l[1]=="pair",v[l[3]]+=l[4]));if(AA*v==v||AA*v==-v,PP++;next);listput(MM,[abs(r[3]),r]));MM=vecsort(Vec(MM),1);write("parity_counts.gp",[#RR,PP,#MM]);for(k=1,min(100,#MM),my(r=MM[k][2],FF=factor(MM[k][1],100000),good=1);for(j=1,matsize(FF)[1],if(!isprime(FF[j,1]),good=0));write("norm_factor_rows.gp",[r,FF[matsize(FF)[1],1],good,FF]););print("MIXED_NORM_SELECTION_COMPLETE;PURE=",PP,";MIXED=",#MM,";FACTORED=",min(100,#MM),";MS=",gettime());quit;}
