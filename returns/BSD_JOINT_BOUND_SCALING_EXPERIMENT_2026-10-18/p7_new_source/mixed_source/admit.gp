{alarm(8);RR=apply(eval,readstr("norm_factor_rows.gp"));GG=select(r->r[3]==1,RR);SS=select(r->r[2]<=10000000,GG);relax=0;if(#SS<10,SS=vecsort(GG,2);relax=1);SS=SS[1..min(40,#SS)];write("selected.gp",vector(#SS,k,SS[k][1]));write("ADMISSION.gp",[#RR,#GG,#SS,relax,vector(#SS,k,[SS[k][1][1],SS[k][2]])]);print("ADMITTED=",#SS,";RELAX=",relax,";PRIME_CERTIFIED=",#GG,";MAX_PRIMES=",vector(#SS,k,SS[k][2]));quit;}
