{alarm(58);gettime();FR=apply(eval,readstr("factor_records.gp"));AM=read("../../BSD_SMALL_BOUND_CONTINUATION_2026-10-18/p7_direct_units/basis_scalar_matrix.gp");KK=read("DIVISOR_RELATIONS.gp")[3];VV=List();for(k=1,#FR,for(j=0,5,my(v=AM^j*FR[k][3],sg=0);for(t=1,#v,if(v[t]!=0,sg=sign(v[t]);break));listput(VV,sg*v)));VV=Vec(VV);SS=Set(VV);MG=matrix(#SS,#VV);for(j=1,#VV,MG[setsearch(SS,VV[j]),j]=1);PT=matrix(#VV,#VV);for(k=0,#FR-1,for(j=0,5,PT[6*k+(j+1)%6+1,6*k+j+1]=1));PJ=6*matid(#VV)+2*PT+3*PT^2+PT^3+5*PT^4+4*PT^5;write("MERGED_RELATIONS.gp",[SS,MG,MG*KK,MG*PJ*KK]);print("EXACT_FACTORS_UP_TO_SIGN=",#SS,";MERGED_KERNEL_RANK_Q=",matrank(MG*KK),";MERGED_CHI_RANK_F7=",matrank(Mod(MG*PJ*KK,7)),";MS=",gettime());quit;}
