pack(a)={my(b=lift(a),den=denominator(b,1));[vector(48,i,polcoef(b*den,i-1,w)),den]};
{alarm(117);gettime();NF=read("../../BSD_SMALL_BOUND_CONTINUATION_2026-10-18/p7_arithmetic/nf.gp");C=read("../../BSD_SMALL_BOUND_CONTINUATION_2026-10-18/p7_arithmetic/field.gp");AM=read("../../BSD_SMALL_BOUND_CONTINUATION_2026-10-18/p7_direct_units/basis_scalar_matrix.gp");if(AM^6!=matid(48),error("scalar order"));FR=apply(eval,readstr("factor_records.gp"));MP=vector(6,j,AM^(j-1));PP=List();CC=List();for(k=1,#FR,my(r=FR[k]);for(j=1,6,my(II=vector(#r[4],h,mathnf(MP[j]*r[4][h])),vv=MP[j]*r[3]);if(idealhnf(NF,vv)!=idealfactorback(NF,II,r[5]),error("orbit principal reconstruction"));listput(CC,[k,j-1,II,r[5]]);for(h=1,#II,listput(PP,II[h]))));PS=Set(Vec(PP));CC=Vec(CC);DV=matrix(#PS,#CC);for(j=1,#CC,my(r=CC[j]);for(h=1,#r[3],DV[setsearch(PS,r[3][h]),j]+=r[4][h]));KK=matkerint(DV);if(DV*KK!=matrix(#PS,matsize(KK)[2]),error("integer divisor kernel"));write("DIVISOR_RELATIONS.gp",[PS,DV,KK,CC]);write("compact_units_eval.json",[vector(49,i,polcoef(C[4],i-1,w)),pack(C[6][1]),pack(C[6][2]),pack(C[7]),vector(#FR,k,pack(nfbasistoalg(NF,FR[k][3]))),vector(matsize(KK)[1],i,Vec(KK[i,]))]);print("ACTUAL_UNIT_RELATIONS_PASS;BASES=",#FR,";ORBIT_COLUMNS=",#CC,";PRIME_ROWS=",#PS,";RELATIONS=",matsize(KK)[2],";DIVISOR_RANK=",matrank(DV),";MS=",gettime());quit;}
