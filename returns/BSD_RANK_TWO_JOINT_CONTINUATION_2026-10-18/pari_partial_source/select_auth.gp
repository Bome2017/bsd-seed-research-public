{alarm(110);gettime();NF=read("../twist_source/nf.gp");C=read("../twist_source/field.gp");AM=read("../twist_source/direct_units/basis_scalar_matrix.gp");RR=readstr("captured_generators.gp");SEEN=Map();SEL=List();pure=0;dups=0;for(k=1,#RR,my(a=Mod(eval(RR[k]),NF.pol),v=nfalgtobasis(NF,a),v3=AM^3*v);if(v3==v || v3==-v,pure++;next);my(orb=vector(12,j,if(j<=6,AM^(j-1)*v,-AM^(j-7)*v)),key=vecsort(orb)[1]);if(mapisdefined(SEEN,key),dups++;next);mapput(SEEN,key,1);my(ff=idealfactor(NF,v),ids=vector(matsize(ff)[1],i,idealhnf(NF,ff[i,1])),ex=Vec(ff[,2]));if(idealhnf(NF,v)!=idealfactorback(NF,ids,ex),error("exact principal ideal mismatch"));write("factor_records.gp",[#SEL+1,k,v,ids,ex]);listput(SEL,[k,v,nfeltnorm(NF,v)]);print("AUTHENTICATED=",#SEL,";CAPTURE_ROW=",k,";PRIMES=",#ids,";MS=",gettime());if(#SEL==48,break));write("selected.gp",Vec(SEL));print("SELECTION_AUTH_DONE;COUNT=",#SEL,";PURE_SKIPPED=",pure,";ORBIT_DUPLICATES=",dups);quit;}
