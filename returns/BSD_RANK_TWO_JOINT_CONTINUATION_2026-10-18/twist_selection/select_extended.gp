{gettime();E=ellinit([0,-1,1,-10,-20]);OUT=List();for(n=41,200,for(s=1,2,my(d=if(s==1,n,-n));if(d==1||!issquarefree(d)||d%7==0,next);my(D=if(d%4==1,d,4*d),F=ellminimalmodel(elltwist(E,D)),RR,ok=1);iferr(alarm(2);RR=ellrank(F),err,ok=0);alarm(0);if(ok,listput(OUT,[d,D,Vec(F)[1..5],factor(F.disc),RR]);print("TWIST=",d,";MODEL=",Vec(F)[1..5],";DISC=",factor(F.disc),";RANK=",RR);if(RR[1]==2&&RR[2]==2,write("SELECTED.gp",[d,D,Vec(F)[1..5],factor(F.disc),RR]);write("PANEL_EXTENDED.gp",Vec(OUT));print("RANK_TWO_TWIST_FOUND;MS=",gettime());quit),print("TWIST_TIMEOUT=",d))));write("PANEL_EXTENDED.gp",Vec(OUT));print("PANEL_DONE_NO_RANK_TWO;MS=",gettime());quit;}
