pline(v)={my(d=denominator(v,1),v1=v*d,c=content(v1));v1/c};
{alarm(57);gettime();NF=read("../nf.gp");C=read("../field.gp");E=C[1];F=C[4];T=C[6];S=C[7];PT=[[1,2],[3,2],elladd(E,[1,2],[3,2]),ellsub(E,[1,2],[3,2])];AA=List();LAB=List();LL=List();for(i=1,4,my(P=PT[i],m=3*P[1]^2-13,n=2*P[2]+1,v=pline([-m,n,m*P[1]-n*P[2]]));listput(LL,v);listput(LAB,["tangent",i,0]));for(i=1,4,for(j=i+1,4,my(P=PT[i],Q=PT[j],v=if(P[1]==Q[1],[1,0,-P[1]],[-(Q[2]-P[2]),Q[1]-P[1],(Q[2]-P[2])*P[1]-(Q[1]-P[1])*P[2]]));listput(LL,pline(v));listput(LAB,["chord",i,j])));for(i=1,4,listput(LL,pline([1,0,-PT[i][1]]));listput(LAB,["vertical",i,0]));LL=Vec(LL);LAB=Vec(LAB);AA=vector(#LL,i,LL[i][1]*T[1]+LL[i][2]*T[2]+LL[i][3]);write("line_sources_rational.gp",[PT,AA,LAB,LL]);for(k=1,#AA,my(a=AA[k],av=nfalgtobasis(NF,a),nn=nfeltnorm(NF,a));print("BEFORE_SOURCE=",k,";LABEL=",LAB[k],";LINE=",LL[k],";NORM=",nn);my(ff=idealfactor(NF,a),ids=vector(matsize(ff)[1],i,idealhnf(NF,ff[i,1])),vv=Vec(ff[,2]));if(idealhnf(NF,a)!=idealfactorback(NF,ids,vv),error("principal factorization"));write("factor_records.gp",[k,k,av,ids,vv]);print("FACTORED_SOURCE=",k,";PRIMES=",#ids,";MS=",gettime()));AC=vector(48,j,nfalgtobasis(NF,nfgaloisapply(NF,S,NF.zk[j])));AM=matrix(48,48,i,j,AC[j][i]);if(AM^6!=matid(48),error("scalar order"));write("basis_scalar_matrix.gp",AM);print("TANGENT_FACTOR_SOURCE_DONE;BASES=",#AA,";MS=",gettime());quit;}
