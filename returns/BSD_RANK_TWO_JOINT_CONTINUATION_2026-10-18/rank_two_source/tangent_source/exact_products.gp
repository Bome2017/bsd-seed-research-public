{alarm(27);gettime();NF=read("../nf.gp");C=read("../field.gp");F=C[4];FR=apply(eval,readstr("factor_records.gp"));AM=read("basis_scalar_matrix.gp");K=read("DIVISOR_RELATIONS.gp")[3];AA=vector(6*#FR,j,nfbasistoalg(NF,AM^((j-1)%6)*FR[(j-1)\6+1][3]));UU=List();for(j=1,matsize(K)[2],my(u=Mod(1,F));for(i=1,#AA,if(K[i,j],u*=AA[i]^K[i,j]));listput(UU,u);write("exact_unit_products.gp",[j,u]);print("EXACT_UNIT=",j,";IS_SIGN=",u==1||u==-1,";DEGREE=",poldegree(lift(u)),";MS=",gettime()));print("ALL_PRODUCTS_DONE");quit;}
