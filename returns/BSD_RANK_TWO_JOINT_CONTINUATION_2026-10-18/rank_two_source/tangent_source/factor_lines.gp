primitive(a)={my(b=lift(a),d=denominator(b,1),c=content(b*d));Mod(b*d/c,F)};
{alarm(57);gettime();NF=read("../nf.gp");C=read("../field.gp");E=C[1];F=C[4];T=C[6];S=C[7];PT=[[1,2],[3,2],elladd(E,[1,2],[3,2]),ellsub(E,[1,2],[3,2])];AA=List();LAB=List();for(i=1,4,my(P=PT[i],a=primitive((2*P[2]+1)*(T[2]-P[2])-(3*P[1]^2-13)*(T[1]-P[1])));listput(AA,a);listput(LAB,["tangent",i,0]));for(i=1,4,for(j=i+1,4,my(P=PT[i],Q=PT[j],a=if(P[1]==Q[1],T[1]-P[1],(Q[1]-P[1])*(T[2]-P[2])-(Q[2]-P[2])*(T[1]-P[1])));listput(AA,primitive(a));listput(LAB,["chord",i,j])));for(i=1,4,listput(AA,primitive(T[1]-PT[i][1]));listput(LAB,["vertical",i,0]));AA=Vec(AA);LAB=Vec(LAB);write("line_sources.gp",[PT,AA,LAB]);for(k=1,#AA,my(a=AA[k],av=nfalgtobasis(NF,a),ff=idealfactor(NF,a),ids=vector(matsize(ff)[1],i,idealhnf(NF,ff[i,1])),vv=Vec(ff[,2]));if(idealhnf(NF,a)!=idealfactorback(NF,ids,vv),error("principal factorization"));write("factor_records.gp",[k,k,av,ids,vv]);print("SOURCE=",k,";LABEL=",LAB[k],";NORM=",nfeltnorm(NF,a),";PRIMES=",#ids,";MS=",gettime()));AC=vector(48,j,nfalgtobasis(NF,nfgaloisapply(NF,S,NF.zk[j])));AM=matrix(48,48,i,j,AC[j][i]);if(AM^6!=matid(48),error("scalar order"));write("basis_scalar_matrix.gp",AM);print("TANGENT_FACTOR_SOURCE_DONE;BASES=",#AA,";MS=",gettime());quit;}
