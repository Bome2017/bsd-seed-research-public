{alarm(57);gettime();E=ellinit([0,0,1,-13,18]);DP=elldivpol(E,7);FY=polresultant(DP,(w^2-1)/4-x^3+13*x-18,x);FY=FY/content(FY);if(poldegree(FY)!=48||!polisirreducible(FY),error("point polynomial"));write("raw_field_data.gp",[E,DP,FY]);print("ACTUAL_RAW_FIELD_SAVED;DEGREE=48;IRREDUCIBLE=1;MS=",gettime());Y2=Mod(w,FY);Q=gcd(DP,(Y2^2-1)/4-x^3+13*x-18);if(poldegree(Q)!=1,error("recover x"));XT=-polcoef(Q,0)/polcoef(Q,1);YT=(Y2-1)/2;T=[XT,YT];if(!ellisoncurve(E,T)||ellmul(E,T,7)!=[0],error("actual torsion point"));T3=ellmul(E,T,3);SIG=2*T3[2]+1;if(subst(FY,w,SIG)!=0,error("scalar field"));if([subst(lift(XT),w,SIG),subst(lift(YT),w,SIG)]!=T3,error("scalar point"));SS=SIG;for(j=2,6,SS=subst(lift(SS),w,SIG));if(SS!=Mod(w,FY),error("scalar sixth power"));write("raw_point_data.gp",[E,DP,FY,FY,Y2,T,SIG]);print("ACTUAL_POINT_AND_SCALAR_PASS;MS=",gettime());quit;}
