{alarm(55);gettime();C=read("/Users/bsm/BSD_RANK_TWO_JOINT_CONTINUATION_2026-10-18/local_pipeline/655_tangent_units/compact_source.json");F=Polrev(C[1],w);den=C[2][2]*C[3][2]*C[4][2]*prod(j=1,#C[5],C[5][j][2]);OUT=List();forprime(q=11,1000000,if(q%7!=1||den%q==0,next);my(rr=polrootsmod(F,q));if(#rr!=48,next);my(ok=1);for(k=1,#C[5],for(j=1,48,if(subst(Polrev(C[5][k][1],w),w,rr[j])==0,ok=0;break));if(!ok,break));if(!ok,next);listput(OUT,[q,lift(Vec(rr))]);if(#OUT==3,break));if(#OUT<3,error("insufficient split primes"));write("split_primes.json",Vec(OUT));print("SPLIT_COMPLETE;MS=",gettime());quit;}
