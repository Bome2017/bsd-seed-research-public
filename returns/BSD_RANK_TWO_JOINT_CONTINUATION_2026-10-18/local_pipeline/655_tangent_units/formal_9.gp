packelt(v,F)={Mod(Polrev(v[1],w)/v[2],F)};
{alarm(55);gettime();NF=read("/Users/bsm/BSD_RANK_TWO_JOINT_CONTINUATION_2026-10-18/rank_two_source/nf.gp");C=read("/Users/bsm/BSD_RANK_TWO_JOINT_CONTINUATION_2026-10-18/local_pipeline/655_tangent_units/compact_source.json");F=Polrev(C[1],w);if(NF.pol!=F,error("field mismatch"));SIG=packelt(C[4],F);B=C[5];KV=C[6];K=matrix(#KV,#KV[1],i,j,KV[i][j]);PR=idealprimedec(NF,7);idx=0;for(i=1,#PR,if(PR[i].e==6&&PR[i].f==1,idx=i));if(idx==0,error("tame prime missing"));P=PR[idx];if(idealhnf(NF,nfgaloisapply(NF,SIG,P))!=idealhnf(NF,P),error("tame prime not scalar fixed"));pi=idealappr(NF,P);if(nfeltval(NF,pi,P)!=1,error("uniformizer valuation"));xp=packelt(C[2],F);yp=packelt(C[3],F);POINTVAL=vector(#PR,i,[nfeltval(NF,xp,PR[i]),nfeltval(NF,yp,PR[i])]);if(POINTVAL[idx][1]>=0,error("tame point not formal"));bid=idealstar(NF,idealpow(NF,P,9),1,7);print("FORMAL_LOCAL_GROUP;CYCLIC=",bid.cyc,";MS=",gettime());testunit=nfeltadd(NF,1,nfeltpow(NF,pi,2));TESTLOG=lift(Mod(ideallog(NF,testunit,bid),7));if(TESTLOG==vector(#TESTLOG)~,error("local nonpower test zero"));if(lift(Mod(ideallog(NF,nfeltpow(NF,testunit,7),bid),7))!=vector(#TESTLOG)~,error("local power test nonzero"));dd=#bid.cyc;LOGS=matrix(dd,6*#B);VALS=vector(6*#B);for(k=1,#B,my(a=packelt(B[k],F));for(j=0,5,my(vv=nfeltval(NF,a,P),aunit=nfeltdiv(NF,a,nfeltpow(NF,pi,vv)),ll=ideallog(NF,aunit,bid),col=6*(k-1)+j+1);if(nfeltval(NF,aunit,P)!=0,error("normalized nonunit"));VALS[col]=vv;LOGS[,col]=ll;a=nfgaloisapply(NF,SIG,a)));if(VALS*K!=vector(#K),error("compact units nonzero tame divisor"));UL=lift(Mod(LOGS*K,7));W=[6,2,3,1,5,4];KP=matrix(#K~,#K);for(k=1,#B,for(j=0,5,for(t=0,5,KP[6*(k-1)+(j+t)%6+1,]+=W[t+1]*K[6*(k-1)+j+1,])));PL=lift(Mod(LOGS*KP,7));write("formal_9.json",[idx,[P.e,P.f],bid.cyc,VALS,vector(#LOGS~,i,Vec(LOGS[i,])),vector(#UL~,i,Vec(UL[i,])),vector(#PL~,i,Vec(PL[i,])),Vec(lift(pi)),POINTVAL,Vec(TESTLOG)]);print("FORMAL_LOCAL_COMPLETE;BASES=",#B,";UNIT_COLUMNS=",#K,";RAW_RANK=",matrank(Mod(UL,7)),";PROJECTED_RANK=",matrank(Mod(PL,7)),";MS=",gettime());quit;}
