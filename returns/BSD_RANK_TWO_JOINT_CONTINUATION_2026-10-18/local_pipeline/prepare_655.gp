pack(a)={my(b=lift(a),den=denominator(b,1));[vector(48,i,polcoef(b*den,i-1,w)),den]};
{alarm(55);gettime();C=read("/Users/bsm/BSD_RANK_TWO_JOINT_CONTINUATION_2026-10-18/rank_two_source/field.gp");NF=read("/Users/bsm/BSD_RANK_TWO_JOINT_CONTINUATION_2026-10-18/rank_two_source/nf.gp");F=C[4];E=ellinit([0,0,1,-13,18]);if(!ellisoncurve(E,C[6])||ellmul(E,C[6],7)!=[0],error("point binding"));if(NF.pol!=F,error("field binding"));if(C[7]^0!=Mod(1,F),error("scalar type"));PR=idealprimedec(NF,7);INFO=vector(#PR,j,[PR[j].e,PR[j].f,nfeltval(NF,C[6][1],PR[j]),nfeltval(NF,C[6][2],PR[j])]);den=denominator(lift(C[6][1]),1)*denominator(lift(C[6][2]),1)*denominator(lift(C[7]),1);OUT=List();forprime(q=11,1000000,if(q%7!=1||den%q==0,next);my(rr=polrootsmod(F,q));if(#rr==48,listput(OUT,[q,lift(Vec(rr))]);if(#OUT==3,break)));if(#OUT!=3,error("split roots missing"));write("655_split_primes.json",Vec(OUT));write("655_field_point.json",[vector(49,i,polcoef(F,i-1,w)),pack(C[6][1]),pack(C[6][2]),pack(C[7])]);write("655_LOCAL_BRANCH.json",INFO);print("655_PREFLIGHT_COMPLETE;POINT_COUNT=",ellcard(ellinit([0,0,1,-13,18],7)),";BRANCHES=",INFO,";SPLIT_PRIMES=",vector(#OUT,j,OUT[j][1]),";MS=",gettime());quit;}
