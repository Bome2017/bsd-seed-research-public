{alarm(57);gettime();NF=read("../nf.gp");AM=read("basis_scalar_matrix.gp");SS=read("mixed_orbit_selected.gp");for(k=1,#SS,my(v=SS[k][2],a=nfbasistoalg(NF,v),ff=idealfactor(NF,v),ids=vector(matsize(ff)[1],i,idealhnf(NF,ff[i,1])),ex=Vec(ff[,2]));if(idealhnf(NF,v)!=idealfactorback(NF,ids,ex),error("exactfactorback"));write("factor_records.gp",[k,SS[k][1],v,ids,ex]);my(eq=idealhnf(NF,v)==idealhnf(NF,AM^3*v));if(eq,write("central_ratio_units.gp",[k,SS[k][1],v]));print("FACTORED=",k,";CANDIDATE=",SS[k][1],";NORMSIZE=",SS[k][3],";PRIME_COUNT=",#ids,";CENTRAL_IDEAL_EQUAL=",eq,";MS=",gettime()));print("FULL_SELECTED_FACTOR_DONE");quit;}
