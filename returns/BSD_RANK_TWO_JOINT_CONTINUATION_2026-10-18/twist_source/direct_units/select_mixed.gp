{alarm(27);gettime();NF=read("../nf.gp");AM=read("basis_scalar_matrix.gp");MM=AM^3;NR=apply(eval,readstr("norm_rows.gp"));ML=List();SL=List();for(k=1,#NR,my(l=NR[k][2],v);if(l[1]=="shift",v=nfalgtobasis(NF,Mod(w+l[2],NF.pol)),v=vector(48,j,if(j==l[2],1,0))~;if(l[1]=="pair",v[l[3]]+=l[4]));if(MM*v!=v&&MM*v!=-v,my(a=abs(NR[k][3]),z=a);listput(ML,[a,k,v]);for(j=1,3,my(q=[7,11,47][j]);while(z%q==0,z/=q));if(z==1,listput(SL,[k,v,NR[k][3]]))));ML=vecsort(Vec(ML),1);write("mixed_norm_order.gp",ML);write("S_supported_mixed.gp",Vec(SL));NN=min(24,#ML);ZZ=vector(NN,i,[ML[i][2],ML[i][3],ML[i][1]]);write("mixed_selected.gp",ZZ);print("MIXED_CANDIDATES=",#ML,";S_SUPPORTED_MIXED=",#SL,";SELECTED=",NN,";MIN_NORM=",ML[1][1],";MS=",gettime());quit;}
