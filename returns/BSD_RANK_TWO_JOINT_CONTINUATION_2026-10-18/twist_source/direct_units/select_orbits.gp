{alarm(27);gettime();AM=read("basis_scalar_matrix.gp");MM=read("mixed_norm_order.gp");MP=vector(6,j,AM^(j-1));KEY=List();SEL=List();for(i=1,#MM,my(v=MM[i][3],vv=vector(6,j,my(u=MP[j]*v,sg=0);for(k=1,48,if(u[k],sg=sign(u[k]);break));sg*u),key=vecsort(vv)[1]);if(!setsearch(Set(Vec(KEY)),key),listput(KEY,key);listput(SEL,[MM[i][2],v,MM[i][1]]);if(#SEL==24,break)));write("mixed_orbit_selected.gp",Vec(SEL));print("SCALAR_ORBIT_DISTINCT_BASES=",#SEL,";LAST_NORM=",SEL[#SEL][3],";MS=",gettime());quit;}
