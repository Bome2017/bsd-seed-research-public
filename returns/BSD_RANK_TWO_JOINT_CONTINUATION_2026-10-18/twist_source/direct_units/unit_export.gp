pack(a)={my(b=lift(a),den=denominator(b,1));[vector(48,i,polcoef(b*den,i-1,w)),den]};
{alarm(27);gettime();C=read("../field.gp");NF=read("../nf.gp");S=C[7];UU=apply(eval,readstr("actual_units.gp"));AC=vector(48,j,nfalgtobasis(NF,nfgaloisapply(NF,S,NF.zk[j])));AM=matrix(48,48,i,j,AC[j][i]);if(AM^6!=matid(48),error("scalarorder"));write("basis_scalar_matrix.gp",AM);for(k=1,#UU,my(v=UU[k][2],a=nfbasistoalg(NF,v));if(nfeltnorm(NF,v)!=UU[k][3]||abs(UU[k][3])!=1,error("unit norm replay"));print("UNIT=",k,";CANDIDATE=",UU[k][1],";CENTRAL_FIXED=",AM^3*v==v,";CENTRAL_NEGATIVE=",AM^3*v==-v));K=matrix(6*#UU,#UU,i,j,if(i==6*(j-1)+1,1,0));write("compact_units_eval.json",[vector(49,i,polcoef(C[4],i-1,w)),pack(C[6][1]),pack(C[6][2]),pack(C[7]),vector(#UU,k,pack(nfbasistoalg(NF,UU[k][2]))),vector(matsize(K)[1],i,Vec(K[i,]))]);print("ACTUAL_UNIT_EXPORT_PASS;COUNT=",#UU,";MS=",gettime());quit;}
