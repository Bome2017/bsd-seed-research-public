{alarm(27);gettime();NF=read("../nf.gp");C=read("../field.gp");L=List();for(i=2,48,listput(L,["basis",i,0,1]));for(a=-10,10,listput(L,["shift",a,0,1]));for(i=2,48,for(j=i+1,48,forstep(s=1,-1,-2,if(#L<2000,listput(L,["pair",i,j,s])))));write("candidates.gp",Vec(L));N=0;UU=0;for(k=1,#L,my(l=L[k],v);if(l[1]=="shift",v=nfalgtobasis(NF,Mod(w+l[2],NF.pol)),v=vector(48,j,if(j==l[2],1,0))~;if(l[1]=="pair",v[l[3]]+=l[4]));my(z=nfeltnorm(NF,v));write("norm_rows.gp",[k,l,z]);N++;if(abs(z)==1,my(a=nfbasistoalg(NF,v));if(a!=1&&a!=-1,write("actual_units.gp",[k,v,z]);UU++;print("UNIT_FOUND;CANDIDATE=",k,";COUNT=",UU)));if(k%100==0,print("SCAN_PROGRESS;N=",N,";UNITS=",UU,";MS=",gettime())));print("SCAN_COMPLETED;CANDIDATES=",N,";UNITS=",UU,";MS=",gettime());quit;}
