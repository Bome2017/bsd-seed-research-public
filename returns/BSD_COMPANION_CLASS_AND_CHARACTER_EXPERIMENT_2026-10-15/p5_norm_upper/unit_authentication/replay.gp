{alarm(35);gettime();NF=read("../../p5_arithmetic/nf.gp");UU=read("../../p5_arithmetic/units_compact.gp")[1];D=read("AUTHENTICATION_DATA.gp");FF=D[1];PP=D[2];DV=D[3];EX=D[4];if(matsize(EX)!=[#FF,13]||matsize(DV)!=[#PP,#FF],error("dimensions"));EX2=matrix(#FF,13);for(j=1,13,for(k=1,matsize(UU[j])[1],ii=setsearch(FF,nfalgtobasis(NF,UU[j][k,1]));if(ii==0,error("missingfactor"));EX2[ii,j]+=UU[j][k,2]));if(EX2!=EX,error("sourceexponents"));DV2=matrix(#PP,#FF);for(i=1,#FF,FAC=idealfactor(NF,FF[i]);if(idealhnf(NF,FF[i])!=idealfactorback(NF,FAC[,1],FAC[,2]),error("factoridealreconstruction"));for(j=1,matsize(FAC)[1],ix=setsearch(PP,idealhnf(NF,FAC[j,1]));if(!ix,error("newideal"));DV2[ix,i]=FAC[j,2]));if(DV2!=DV||DV2*EX2!=matrix(#PP,13)||D[5]!=matrix(#PP,13),error("nonunit"));print("UNIT_IDENTITY_REPLAY_PASS;FREE_UNITS=13;FACTORS=",#FF,";IDEALS=",#PP,";MS=",gettime());quit;}
