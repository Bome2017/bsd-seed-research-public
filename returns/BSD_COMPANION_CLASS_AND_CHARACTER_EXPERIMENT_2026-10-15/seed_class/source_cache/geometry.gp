alarm(30);B=read("/Users/bsm/BSD_P3_LOWER_HALF_3DESCENT_RETURN_OPUS_2026-09-29/work/kb2a_bnf.bin");nf=B.nf;f=nf.pol;x=variable(f);g=polcoef(f,8)*z^4+polcoef(f,6)*z^3+polcoef(f,4)*z^2+polcoef(f,2)*z+polcoef(f,0);nplus=nfinit(g);ps=[2,3,2243,4547,5843];SL=concat(vector(#ps,i,idealprimedec(nf,ps[i])));tau=Mod(-x,f);perm=vector(#SL,j,my(I=nfgaloisapply(nf,tau,SL[j]));select(k->idealhnf(nf,I)==idealhnf(nf,SL[k]),[1..#SL])[1]);print("A_SIGN=",nf.sign,";PLUS_SIGN=",nplus.sign,";ORD_MINUS_UNIT_RANK=",sum(i=1,2,nf.sign[i])-sum(i=1,2,nplus.sign[i]));print("S_PRIMES=",vector(#SL,j,[SL[j][1],SL[j][3],SL[j][4]]));print("S_INVOLUTION=",perm,";S_MINUS_DIVISOR_RANK=",sum(j=1,#SL,perm[j]!=j)/2);print("GEOMETRY_COMPLETE");quit;
