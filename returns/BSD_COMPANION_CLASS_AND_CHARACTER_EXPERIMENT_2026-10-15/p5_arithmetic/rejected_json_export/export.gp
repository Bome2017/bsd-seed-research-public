{C=read("field.gp");NF=read("nf.gp");V=read("divisors.gpout");print("{\"model\":",vector(5,i,C[1][i]),",\"field_polynomial\":",vector(25,i,polcoef(C[4],i-1)),",\"discriminant\":\"",NF.disc,"\",\"signature\":",NF.sign,",\"scalar2\":",vector(24,i,Str(polcoef(lift(C[7]),i-1))),",\"Y2\":",vector(24,i,Str(polcoef(lift(C[5]),i-1))),",\"torsion_point\":",vector(2,j,vector(24,i,Str(polcoef(lift(C[6][j]),i-1)))),",\"primes\":[");for(k=1,#V,print(if(k>1,",",""),"{\"p\":",V[k][1],",\"ef\":",V[k][2],",\"scalar2_permutation\":",V[k][3],",\"chi2_basis\":",vector(#V[k][5],i,lift(V[k][5][i])~),",\"chi3_basis\":",vector(#V[k][6],i,lift(V[k][6][i])~),"}"));print("]}");quit;}
