{alarm(20);gettime();C=read("field.gp");E=C[1];F=C[4];T=C[6];s=C[7];a2=E[2];a4=E[4];a6=E[5];if(E[1]!=0||E[3]!=1,error("manual law scope"));x=T[1];y=T[2];if(y^2+y!=x^3+a2*x^2+a4*x+a6,error("curve equation"));l=(3*x^2+2*a2*x+a4)/(2*y+1);xx=l^2-a2-2*x;yy=-y+l*(x-xx)-1;T2=[xx,yy];l2=(3*xx^2+2*a2*xx+a4)/(2*yy+1);x4=l2^2-a2-2*xx;y4=-yy+l2*(xx-x4)-1;if([x4,y4]!=[x,-y-1],error("manual double twice not negativepoint"));if([subst(lift(x),variable(F),s),subst(lift(y),variable(F),s)]!=T2,error("scalar2 not manual doubling"));ss=s;for(i=1,3,ss=subst(lift(ss),variable(F),s));if(ss!=Mod(variable(F),F),error("scalar fourthpower"));if(!polisirreducible(F)||poldegree(F)!=24,error("field degree"));NF=read("nf.gp");if(NF.pol!=F||NF.sign!=[4,10],error("NF binding"));V=read("divisors.gpout");for(k=1,#V,PR=idealprimedec(NF,V[k][1]);for(j=1,#PR,if(idealhnf(NF,idealhnf(NF,PR[V[k][3][j]]))!=idealhnf(NF,nfgaloisapply(NF,s,PR[j])),error("actualprime image"))));print("INDEPENDENT_EXACT_FIELD_POINT_SCALAR_IDEALS_PASS;MS=",gettime());quit;}
