{alarm(117);gettime();C=read("field.gp");B=bnfinit(C[4],1);writebin("bnf.bin",B);write("class_init.gp",[B.cyc,B.no,B.reg]);print("BNF_INIT_CLASS=",B.cyc,";CLASS_NUMBER=",B.no,";INIT_MS=",gettime());Q=bnfcertify(B,1);if(Q!=1,error("class quotient certification failed"));write("class_quotient_certificate.gp",[Q,B.cyc,B.no]);print("CLASS_GROUP_QUOTIENT_CERTIFIED=",Q,";COMPUTED_CYCLIC=",B.cyc,";FIVE_PRIMARY_TRIVIAL=",(B.no%5!=0),";MS=",gettime());quit;}
