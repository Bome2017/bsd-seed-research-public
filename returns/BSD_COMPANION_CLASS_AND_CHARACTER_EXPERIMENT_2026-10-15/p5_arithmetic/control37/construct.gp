alarm(25);gettime();E=ellinit([0,0,1,-1,0]);DP=elldivpol(E,5);FY=polresultant(DP,(w^2-1)/4-x^3+x,x);FY=FY/content(FY);if(poldegree(FY)!=24||!polisirreducible(FY),error("point polynomial"));
RF=polredbest(FY,1);F=RF[1];Y2=RF[2];if(subst(FY,w,Y2)!=0,error("reduction binding"));Q=gcd(DP,(Y2^2-1)/4-x^3+x);if(poldegree(Q)!=1,error("recover x"));XT=-polcoef(Q,0)/polcoef(Q,1);YT=(Y2-1)/2;T=[XT,YT];if(!ellisoncurve(E,T)||ellmul(E,T,5)!=[0],error("actual torsion point"));
NF=nfinit(F);BT=matrix(24,24,i,j,polcoef(lift(Y2^(j-1)),i-1,w));ww=matsolve(BT,vector(24,i,polcoef(lift(Mod(w,F)),i-1,w))~);T2=ellmul(E,T,2);Y22=2*T2[2]+1;SIG=sum(i=1,24,ww[i]*Y22^(i-1));if(subst(F,w,SIG)!=0,error("scalar automorphism field"));if([subst(lift(XT),w,SIG),subst(lift(YT),w,SIG)]!=T2,error("scalar automorphism point"));S2=subst(lift(SIG),w,SIG);S4=subst(lift(S2),w,S2);if(S4!=Mod(w,F)||S2==Mod(w,F),error("scalar order4"));
write("field.gp",[E,DP,FY,F,Y2,T,SIG]);write("nf.gp",NF);print("FIELD_DEGREE=",poldegree(F),";SIGNATURE=",NF.sign,";DISC=",NF.disc,";A5=",ellap(E,5),";A37=",ellap(E,37),";MS=",gettime());print("ACTUAL_P5_FIELD_AND_SCALAR_AUTOMORPHISM_PASS");quit;
