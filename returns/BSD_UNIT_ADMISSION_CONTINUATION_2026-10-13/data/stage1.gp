alarm(110);
read("cubinv.gp");read("classimg.gp");read("selmer.gp");
setrand(20261013); gettime();
nf=read("/Users/bsm/BSD_STRUCTURAL_DISCOVERY_2026-10-13/seed3/nf_only.gp");
DD=read("/Users/bsm/BSD_P3_LOWER_HALF_3DESCENT_RETURN_OPUS_2026-09-29/work/seed_ctx.bin"); DD=DD[#DD]; G=DD[3];
B0=read("/Users/bsm/BSD_STRUCTURAL_DISCOVERY_2026-10-13/seed3/actual_representatives.gp"); E=ellinit(B0[1]); T=B0[6]; Actual=B0[8]; fL=nf.pol; ps=[2,3,2243,4547,5843];
VD=read("/Users/bsm/BSD_STRUCTURAL_DISCOVERY_2026-10-13/seed3/cached_source_valuation.gp"); V=Mod(VD[2],3); H0=matker(V);
print("G_TYPES=",vector(#G,i,[type(G[i]),#G[i]]));
print("ALL_VALUATION_ZERO_DIM=",#H0);
tau=Mod(-w,fL); GT=vector(#G,i,tauapply(nf,tau,G[i]));
AP=auxprimes(fL,150,ps); All=concat(concat(G,GT),Actual); Ph=phimat(nf,All,AP);
PG=matrix(matsize(Ph)[1],15,i,j,Ph[i,j]); PT=matrix(matsize(Ph)[1],15,i,j,Ph[i,j+15]); PA=matrix(matsize(Ph)[1],4,i,j,Ph[i,j+30]);
if(matrank(PG)!=15,error("source residue evaluation not injective"));
TAU=matsolve(PG,PT); Acoord=matsolve(PG,PA);
if(PG*TAU!=PT || PG*Acoord!=PA,error("residue coordinates mismatch"));
if(TAU^2!=matid(15),error("tau involution"));
if(V*Acoord!=0*(V*Acoord),error("actual class valuations notzero"));
Norm=TAU+matid(15);
print("RESIDUE_ROWS=",matsize(PG)[1],"; rank=",matrank(PG));
print("TAU_MATRIX=",lift(TAU)); print("ACTUAL_COORDINATES=",lift(Acoord));
print("NORM_DIM_FULL=",#matker(Norm),"; NORM_DIM_UNRAMIFIED=",#matker(Norm*H0));
LR=linrows(E,nf,T,G,12,ps);
print("ADDITIVITY_ROWS=",matsize(LR)[1],"; rank=",matrank(LR));
print("GLOBAL_SCREEN_FULL_DIM=",#matker(matconcat([Norm;LR])));
print("GLOBAL_SCREEN_UNRAMIFIED_DIM=",#matker(matconcat([Norm;LR])*H0));
if(Norm*Acoord!=0*(Norm*Acoord) || LR*Acoord!=0*(LR*Acoord),error("positive classes rejected"));
write("stage1_data.gp",[G,V,H0,TAU,LR,Acoord,PG,PT,PA,AP]);
print("STAGE1_MS=",gettime());
print("STAGE1_COMPLETE");quit;
