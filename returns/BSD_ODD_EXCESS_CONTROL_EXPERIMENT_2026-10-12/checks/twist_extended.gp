default(nbthreads,1);default(realprecision,80);
{E0=ellinit([0,-1,1,-10,-20]);k=0;found=0;for(d=2,20000,if(k>=1000 || found,break); if(d%4!=1 || !issquarefree(d) || gcd(d,55)!=1 || kronecker(d,5)!=-1,next);k++;if(k<=60,next);E=ellminimalmodel(elltwist(E0,d));r=ellrank(E,1);print("RANK ",[k,d,r[1..3]]);if(r[1]!=2 || r[2]!=2 || #r[4]!=2,next);P=ellsaturation(E,r[4],7);A=ellisomat(E,5);for(j=2,3,Fs=ellinit(A[1][j][1]);F=ellminimalmodel(Fs,&vv);imgs=vector(2,i,ellchangepoint(ellisogenyapply(A[1][j][2],P[i]),vv));Q=ellsaturation(F,imgs,7);ix=round(sqrt(matdet(ellheightmatrix(F,imgs))/matdet(ellheightmatrix(F,Q))));po=real(F.omega[1]/E.omega[1]);cr=po*ellglobalred(F)[3]/ellglobalred(E)[3];kk=round(log(cr)/log(5));dd=kk+2-2*valuation(ix,5);print("INDEX ",[k,d,j,ix,kk,dd]);if(dd, print("CANDIDATE ",[d,E[1..5],F[1..5],P,Q,imgs]);found=1;break);););print("DONE ",[k,found]);}
quit;
