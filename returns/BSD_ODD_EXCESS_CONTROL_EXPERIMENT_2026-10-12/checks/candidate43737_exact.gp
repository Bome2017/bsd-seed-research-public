default(nbthreads,1); default(realprecision,90);
{E0=ellinit([0,-1,1,-10,-20]);d=43737;E=ellminimalmodel(elltwist(E0,d));rk=ellrank(E,2);P=ellsaturation(E,rk[4],7);iso=ellisomat(E,5);Fs=ellinit(iso[1][2][1]);F=ellminimalmodel(Fs,&cv);imgs=vector(2,i,ellchangepoint(ellisogenyapply(iso[1][2][2],P[i]),cv));Q=ellsaturation(F,imgs,7);H=ellheightmatrix(F,concat(Q,imgs));C=round(H[1..2,1..2]^-1*H[1..2,3..4]);test=vector(2,i,elladd(F,ellmul(F,Q[1],C[1,i]),ellmul(F,Q[2],C[2,i]))==imgs[i]);if(test!=[1,1],error("point coordinates failed"));print("RANK ",rk);print("MODELS ",[E[1..5],F[1..5]]);print("POINTS ",[P,Q]);print("IMAGE_MATRIX ",C);print("DETERMINANT ",matdet(C));print("EXACT_POINT_CHECK ",test);print("SATURATION_REPEAT ",[ellsaturation(E,P,7)==P,ellsaturation(F,Q,7)==Q]);print("GLOBAL ",[ellglobalred(E),ellglobalred(F)]);print("TORSION ",[elltors(E),elltors(F)]);print("AP5 ",[ellap(E,5),ellap(F,5)]);print("ISOGENY_SHORT ",iso[1][2]);print("CHANGE_TO_MINIMAL ",cv);print("BASE_TORSION ",elltors(E0)); ff=iso[1][2][2]; hh=ff[3];gg=polcoef(ff[2],1,y);print("DIFFERENTIAL_IDENTITY ",hh*deriv(ff[1],x)-2*ff[1]*deriv(hh,x)==gg);fr=factor(hh);print("KERNEL_POLYNOMIAL ",fr);roots=vector(2,i,-polcoef(fr[i,1],0)/polcoef(fr[i,1],1));print("REAL_KERNEL_CHECK ",vector(2,i,issquare((1+4*(roots[i]^3+E.a4*roots[i]+E.a6))/d)));tw=elltwist(ellinit([0,-1,1,-7820,-263580]),d);ellminimalmodel(tw,&ct);print("TWIST_TO_MINIMAL ",ct);print("TWIST_PERIOD_CHECK ",sqrt(d)*F.omega[1]/ellinit([0,-1,1,-7820,-263580]).omega[1]);print("DONE");}
quit;
