default(parisizemax,1000000000);alarm(175);
read("../lib/selmer.gp");print("LIBRARY_READ");
CW=read("../class_witness.gp");Z=[CW[1],CW[14][22],[[CW[2],CW[3]]],CW[14][16]];print("INPUT_READ");nf=Z[1];UG=Z[2];CLS=Z[3];LI=Z[4];B=read("/Users/bsm/BSD_CLASS_LIFT_COUPLING_EXPERIMENT_2026-10-13/search/mirror389/bnf.bin");
if(B.cyc!=[3],error("requires certified full classgroup C3"));
Idl=CLS[1][1];bet=CLS[1][2];
PRS=concat(vector(#LI,j,vector(#LI[j][2],i,LI[j][2][i][1])));
VM=matrix(#PRS,2,i,j,if(j==1,PRS[i],-idealval(nf,Idl,PRS[i])));
gm=nfbasistoalg(nf,idealappr(nf,VM));
J=idealmul(nf,Idl,idealhnf(nf,gm));betpr=bet*gm^3;
if(idealpow(nf,J,3)!=idealhnf(nf,betpr),error("exact principalization mismatch"));
if(vector(#PRS,i,idealval(nf,J,PRS[i]))!=vector(#PRS),error("shiftedideal not coprime"));
if(vector(#PRS,i,nfeltval(nf,betpr,PRS[i]))!=vector(#PRS),error("principalization notunit"));
print("EXACT_PRINCIPALIZATION=1;IDEAL_COPRIME=1;BETA_LOCAL_UNIT=1");
QU=List();QB=List();AL=List();MODULUS=matid(8);NROWS=0;
{for(k=1,#LI,my(Dl=LI[k][2],Bl=LI[k][3],idx=List(),vidx=List(),off=0,Sel,Val,Au,Ue,be);
 for(j=1,#Dl,my(nj=1+#select(x->x%3==0,Dl[j][3].cyc));listput(vidx,off+1);for(t=2,nj,listput(idx,off+t));off+=nj;MODULUS=idealmul(nf,MODULUS,idealpow(nf,Dl[j][1],Dl[j][2])));
 idx=Vec(idx);vidx=Vec(vidx);Sel=matrix(#idx,off,i,j,idx[i]==j);Val=matrix(#vidx,off,i,j,vidx[i]==j);
 Au=if(Bl[2],Sel*Bl[1]*matker(Val*Bl[1]),matrix(#idx,0));
 Ue=Mod(matrix(#idx,#UG,i,j,(Sel*concat(vector(#Dl,q,locvec(nf,UG[j],Dl[q])))~)[i]),3);
 be=Mod(Sel*concat(vector(#Dl,q,locvec(nf,betpr,Dl[q])))~,3);
 listput(QU,Ue);listput(QB,be);listput(AL,Au);NROWS+=#idx;
 print("LOCAL=",LI[k][1],";RESIDUE_UNIT_DIM=",#idx,";KUMMER_UNIT_DIM=",#Au);
 )}
UM=matconcat(Vec(QU)~);BC=matconcat(Vec(QB)~);AD=matrix(NROWS,sum(i=1,#AL,#AL[i]));ro=0;co=0;
{for(k=1,#AL,for(i=1,matsize(AL[k])[1],for(j=1,matsize(AL[k])[2],AD[ro+i,co+j]=AL[k][i,j]));ro+=matsize(AL[k])[1];co+=matsize(AL[k])[2]);}
REL=Mod(matconcat([UM,AD]),3);Ann=matker(REL~)~;kap=Ann*BC;t=matsize(Ann)[1];
if(kap!=0*kap,error("positive repair actualraydefect differs"));
P=matrix(t+1,t+1,i,j,if(i==j,3,0));for(i=1,t,P[i,t+1]=-lift(kap[i,1]));SN=matsnf(P);
print("RESIDUE_DIM=",NROWS,";GLOBAL_UNIT_IMAGE_RANK=",matrank(UM),";ALLOWANCE_RANK=",matrank(AD),";QUOTIENT_DIM=",t);
print("CLASS_BOUNDARY=",lift(kap),";PRESENTATION=",P,";SMITH=",SN);
pcols=matindexrank(REL)[2];RP=matrix(NROWS,#pcols,i,j,REL[i,pcols[j]]);rs=matsolve(RP,-BC);if(RP*rs!=-BC,error("repairsolve mismatch"));print("LOCAL_UNIT_RELATION_REPAIR_PIVOTS=",pcols,";COEFFICIENTS=",lift(rs));
write("certificate.gp",[nf,UG,CLS[1],gm,J,betpr,MODULUS,Vec(AL),UM,BC,AD,Ann,kap,P,SN,pcols,rs]);
jm(A)=vector(matsize(A)[1],i,vector(matsize(A)[2],j,lift(A[i,j])));
write("matrices.json","{\"unit_evaluation\":",jm(UM),",\"kummer_unit_allowance\":",jm(AD),",\"class_evaluation\":",jm(BC),",\"annihilator\":",jm(Ann),",\"boundary\":",jm(kap),",\"presentation\":",jm(P),",\"smith\":",SN,",\"repair_pivots\":",Vec(pcols),",\"repair_coefficients\":",jm(rs),"}");
print("MODULUS_NORM=",idealnorm(nf,MODULUS),";CLASS_GENERATOR=",bnfisprincipal(B,J,0));
print("ACTUAL_RAY_PUSHOUT_PRESENTATION_PASS");
gettime();RAY=bnrinit(B,[MODULUS,vector(nf.sign[1])],1);writebin("ray.bin",RAY);print("RAY_CYCLIC=",RAY.cyc,";BNR_MS=",gettime());
RC=bnrisprincipal(RAY,J,0);RB=bnrisprincipal(RAY,betpr,0);if(vector(#RAY.cyc,i,(3*RC[i]-RB[i])%RAY.cyc[i])!=vector(#RAY.cyc),error("ray ideal cube relation"));
RO=1;for(i=1,#RAY.cyc,RO=lcm(RO,RAY.cyc[i]/gcd(RAY.cyc[i],RC[i])));print("RAY_LIFT_COORDINATES=",RC,";RAY_LIFT_ORDER=",RO,";BETA_COORDINATES=",RB);
write("ray_coordinates.gp",[RAY.cyc,RC,RB,RO]);print("ACTUAL_RAY_GROUP_AND_LIFT_PASS");quit;
