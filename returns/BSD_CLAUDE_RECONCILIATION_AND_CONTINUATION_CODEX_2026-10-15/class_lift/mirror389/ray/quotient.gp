default(parisizemax,1000000000);
alarm(150);read("/Users/bsm/BSD_CLAUDE_RECONCILIATION_AND_CONTINUATION_CODEX_2026-10-15/class_lift/mirror389/lib/selmer.gp");C=read("certificate.gp");CW=read("/Users/bsm/BSD_CLAUDE_RECONCILIATION_AND_CONTINUATION_CODEX_2026-10-15/class_lift/mirror389/class_witness.gp");nf=C[1];LI=CW[14][16];RAY=read("ray.bin");RR=read("ray_coordinates.gp");RC=RR[2];
PRS=concat(vector(#LI,j,vector(#LI[j][2],i,LI[j][2][i][1])));DEP=concat(vector(#LI,j,vector(#LI[j][2],i,LI[j][2][i][2])));OLDBID=concat(vector(#LI,j,vector(#LI[j][2],i,LI[j][2][i][3])));
FACT=matrix(#PRS,2,i,j,if(j==1,PRS[i],DEP[i]));KG=List();ELTS=List();SELECT3=List();BASISCHECKS=List();OLDCOLS=List();TOTAL=sum(i=1,#OLDBID,#select(a->a%3==0,OLDBID[i].cyc));
{for(i=1,#PRS,my(BID=idealstar(nf,idealpow(nf,PRS[i],DEP[i]),2));if(BID.cyc!=OLDBID[i].cyc,error("local basis invariant mismatch"));for(j=1,#BID.cyc,my(gen=BID.gen[j],LG=ideallog(nf,gen,OLDBID[i]),target=vector(#BID.cyc,k,k==j)~);my(vold=vector(TOTAL),off=sum(k=1,i-1,#select(a->a%3==0,OLDBID[k].cyc)),ct=0);for(k=1,#LG,if(OLDBID[i].cyc[k]%3==0,ct++;vold[off+ct]=LG[k]%3));listput(OLDCOLS,vold~);my(gg=nfbasistoalg(nf,idealchinese(nf,FACT,vector(#PRS,k,if(k==i,gen,1)))),hh=idealhnf(nf,gg),cc=bnrisprincipal(RAY,hh,0));listput(ELTS,gg);listput(KG,cc);if(BID.cyc[j]%3==0,listput(SELECT3,#KG));));}
KG=matconcat(Vec(KG));SEL=Vec(SELECT3);LC=Mod(matconcat(Vec(OLDCOLS)),3);piv=matindexrank(LC)[2];if(#piv!=TOTAL,error("local log basis deficient"));LP=matrix(TOTAL,TOTAL,i,j,LC[i,piv[j]]);RI=matrix(#KG,TOTAL);for(i=1,TOTAL,for(j=1,TOTAL,RI[piv[i],j]=lift((LP^-1)[i,j])));if(LC*RI!=Mod(matid(TOTAL),3),error("local basis rightinverse"));KS=KG*RI;CY=matdiagonal(RAY.cyc);
KINDEX=matsnf(mathnf(matconcat([CY,KG])));if(select(a->a>1,KINDEX)!=[3],error("residue kernel image index not3"));
RAWREL=mathnf(matconcat([CY,3*KG]));RAWSN=matsnf(RAWREL);ALLOW=KS*lift(C[11]);FINALREL=mathnf(matconcat([CY,3*KG,ALLOW]));FINALSN=matsnf(FINALREL);
if(select(a->a>1,FINALSN)!=[3,3,3,3],error("actual ray quotient differs from pushout"));
SOL1=matsolvemod(matconcat([CY,3*KG,ALLOW]),vector(#RAY.cyc)~,3*RC);if(type(SOL1)=="t_INT"&&SOL1==0,error("3J not killed in final quotient"));
print("RESIDUE_KERNEL_INDEX=",KINDEX,";RAW_CUBE_KERNEL_QUOTIENT=",RAWSN,";LOCAL_ALLOWANCE_QUOTIENT=",FINALSN);
BC=lift(C[10]);BR=KS*BC;RB=RR[3];SOL2=matsolvemod(matconcat([CY,3*KG]),vector(#RAY.cyc)~,RB-BR[,1]);if(type(SOL2)=="t_INT"&&SOL2==0,error("beta ray/residue match fails"));
RAWTRANS=matsnf(RAWREL,1);FINALTRANS=matsnf(FINALREL,1);VRAW=RAWTRANS[1]*RC;VFINAL=FINALTRANS[1]*RC;ORAW=1;OFINAL=1;for(i=1,#RAY.cyc,ORAW=lcm(ORAW,RAWTRANS[3][i,i]/gcd(RAWTRANS[3][i,i],VRAW[i]));OFINAL=lcm(OFINAL,FINALTRANS[3][i,i]/gcd(FINALTRANS[3][i,i],VFINAL[i])));if(ORAW!=9||OFINAL!=3,error("unexpected concrete lift orders"));print("LIFT_ORDER_AFTER_RESIDUE_CUBES=",ORAW,";LIFT_ORDER_AFTER_LOCAL_ALLOWANCE=",OFINAL);
write("quotient_certificate.gp",[FACT,Vec(ELTS),KG,SEL,KS,CY,RAWREL,RAWSN,ALLOW,FINALREL,FINALSN,KINDEX,BR,LC,RI,SOL1,SOL2,RAWTRANS,FINALTRANS,VRAW,VFINAL,ORAW,OFINAL]);
print("ACTUAL_CRT_TO_RAY_QUOTIENT_PASS");quit;
