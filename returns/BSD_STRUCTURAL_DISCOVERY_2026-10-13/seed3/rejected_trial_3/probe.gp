alarm(285);
read("certificate_library.gp");
gettime();
B = read("/Users/bsm/BSD_P3_LOWER_HALF_3DESCENT_RETURN_OPUS_2026-09-29/work/kb2a_bnf.bin");
B = subst(B,y,w); nf = B.nf;
print("CACHE_LOADED_MS=",gettime(),"; CYCLIC=",B.cyc,"; POL=",nf.pol);
if(nf.pol != V_fL,error("field mismatch"));
E = ellinit(V_ai); xs = nfroots(nf, subst(elldivpol(E,3),x,X));
if(#xs != 1,error("torsion x ambiguity"));
xT=xs[1]; T=[xT,nfroots(nf,X^2-(xT^3+V_ai[2]*xT^2+V_ai[4]*xT+V_ai[5]))[1]];
if(!ellisoncurve(E,T) || ellmul(E,T,3)!=[0],error("torsion binding"));
Cim=vector(2,j,V_cubicclass(nf,V_C[j]));
A=[V_kummer(V_ai,T,V_P1),V_kummer(V_ai,T,V_P2),Cim[1][1],Cim[2][1]];
write("actual_representatives.gp",[V_ai,V_P1,V_P2,V_C,V_fL,T,Cim,A]);
print("REP_NORMS=",vector(4,j,nfeltnorm(nf,A[j])));
print("REP_MS=",gettime());
AF=vector(4,j,idealfactor(nf,A[j]));
print("PRINCIPAL_IDEAL_FACTORS=",AF);
print("FACTOR_MS=",gettime());
PP=List();
{for(j=1,4,for(i=1,#AF[j]~,my(pr=AF[j][i,1],found=0);for(k=1,#PP,if(PP[k]==pr,found=1));if(!found,listput(PP,pr))))}
PP=Vec(PP);
V=matrix(#PP,4,i,j,nfeltval(nf,A[j],PP[i]));
print("PRIME_LABELS=",vector(#PP,i,[i,PP[i].p,PP[i].e,PP[i].f]));
print("COMPLETE_VALUATIONS=",V);
print("VALUATION_MOD3=",lift(Mod(V,3)));
U=matker(Mod(V,3));
print("UNRAMIFIED_KERNEL=",lift(U));
print("POINT_UNRAMIFIED_KERNEL=",lift(matker(Mod(V[,1..2],3))));
print("VAL_RANK_ALL=",matrank(Mod(V,3)),"; VAL_RANK_POINTS=",matrank(Mod(V[,1..2],3)));
ps=[2,3,2243,4547,5843];
{for(k=1,#ps,my(ix=select(i->PP[i].p==ps[k],[1..#PP]));print("OMISSION_BLOCK=",ps[k],"; rows=",ix,"; block=",if(#ix,matrix(#ix,4,i,j,V[ix[i],j]),[;]),"; rank=",if(#ix,matrank(Mod(matrix(#ix,4,i,j,V[ix[i],j]),3)),0));)}
C=matrix(#B.cyc,#U); ideals=List();
{for(j=1,#U,my(ev=lift(U[,j]),vv=V*ev,I=matid(8),aa=prod(k=1,4,A[k]^ev[k])); if(vv%3 != 0*vv,error("kernel not divisible")); for(i=1,#PP,I=idealmul(nf,I,idealpow(nf,PP[i],vv[i]/3))); if(idealhnf(nf,idealpow(nf,I,3))!=idealhnf(nf,aa),error("ideal cube equality")); listput(ideals,I); C[,j]=bnfisprincipal(B,I,0); if(vector(#B.cyc,i,(3*C[i,j])%B.cyc[i])!=vector(#B.cyc),error("not 3torsion")); print("CLASS_COLUMN=",j,"; class=",C[,j],"; ideal_cube_check=1");)}
J=select(i->B.cyc[i]%3==0,[1..#B.cyc]);
C3=matrix(#J,#U,i,j,C[J[i],j]/(B.cyc[J[i]]/3));
print("CLASS3_MATRIX=",lift(Mod(C3,3)));
write("ideal_root_data.gp",[PP,V,U,Vec(ideals),B.cyc,C,C3]);
W0=matker(Mod(V[,1..2],3)); W4=matconcat([W0; matrix(2,#W0)]);
WU=if(#W0,matsolve(U,W4),matrix(#U,0));
print("POINT_KERNEL_IN_U=",lift(WU));
print("CLASS_IMAGE_RANK=",matrank(Mod(C3,3)),"; POINT_CLASS_RANK=",if(#W0,matrank(Mod(C3,3)*WU),0));
print("CLASS_QUOTIENT_RANK=",matrank(Mod(C3,3))-if(#W0,matrank(Mod(C3,3)*WU),0));
print("CLASS_MS=",gettime());
D=read("/Users/bsm/BSD_P3_LOWER_HALF_3DESCENT_RETURN_OPUS_2026-09-29/work/seed_ctx.bin"); print("CACHE_OBJECTS=",#D,"; selected_last=1"); D=D[#D]; G=D[3]; Sel=D[2]; if(#G!=15 || #Sel!=4,error("cache dimensions"));
SP=concat(vector(#ps,i,idealprimedec(nf,ps[i])));
gval(a,pr)=if(type(a)=="t_MAT",sum(k=1,#a~,a[k,2]*nfeltval(nf,a[k,1],pr)),nfeltval(nf,a,pr));
VG=matrix(#SP,#G,i,j,gval(G[j],SP[i]));
print("CACHED_SOURCE_NGEN=",#G,"; SEARCH_KERNEL_NCOL=",#Sel);
print("CACHED_SOURCE_VALUATION_MOD3=",lift(Mod(VG,3)));
print("CACHED_SEARCH_KERNEL_VALUATION_MOD3=",lift(Mod(VG,3)*Sel));
write("cached_source_valuation.gp",[SP,VG,Sel]);
write("nf_only.gp",nf);
IU=idealdiv(nf,ideals[3],ideals[4]);
pru=bnfisprincipal(B,IU,5);
if(pru[1]!=0*pru[1],error("candidate unit ideal not principal"));
GF=pru[2];
PM=Map(); POBJ=Map();
{for(i=1,#GF~,my(FF=idealfactor(nf,GF[i,1]));for(j=1,#FF~,my(key=Str(FF[j,1]),old=0);mapisdefined(PM,key,&old);mapput(PM,key,old+GF[i,2]*FF[j,2]);mapput(POBJ,key,FF[j,1])));}
IF=idealfactor(nf,IU);
{for(i=1,#IF~,my(key=Str(IF[i,1]),old=0);mapisdefined(PM,key,&old);mapput(PM,key,old-IF[i,2]);)}
ZZ=Vec(PM);
if(sum(i=1,#ZZ,abs(ZZ[i]))!=0,error("compact generator complete valuation mismatch"));
UF=matconcat([[A[3],1; A[4],-1];matrix(#GF~,2,i,j,if(j==1,nfbasistoalg(nf,GF[i,1]),-3*GF[i,2]))]);
print("COMPACT_GENERATOR_IDEAL_VERIFIED_BY_COMPLETE_FACTORIZATIONS=1; distinct_primes=",#ZZ);
if(idealpow(nf,IU,3)!=idealhnf(nf,A[3]/A[4]),error("root ideal ratio mismatch"));
write("unit_certificate.gp",[A[3],A[4],IU,GF,UF]);
print("COMPACT_UNIT_CERTIFICATE=1; factors=",#UF~, "; representative=C1/C2 divided by generator cubed");
print("UNIT_MS=",gettime());
tau=Mod(-w,V_fL);
if(subst(lift(T[1]),w,tau)!=T[1] || subst(lift(T[2]),w,tau)!=-T[2],error("tau torsion mismatch"));
UT=matrix(#UF~,2,i,j,if(j==1,subst(lift(UF[i,1]),w,tau),-UF[i,2]));
UN=matconcat([UF;UT]);
write("norm_one_unit_certificate.gp",[tau,UN]);
print("NORM_ONE_UNIT=epsilon/tau(epsilon); tau_T=-T; compact_factors=",#UN~);

print("FINAL_MS=",gettime());
print("EXPERIMENT_COMPLETE");
quit;
