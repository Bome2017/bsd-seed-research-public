{main()=alarm(55);C=read("fields.gp");S=read("inputs/seed_field.gp");if(C[1]!=S[4]||C[2]!=S[6]||C[3]!=S[7],error("source binding"));T=C[2];SG=C[3];TH=C[5];ZP=C[7];TA=subst(lift(SG),w,SG);if(subst(C[4],y,TH)!=0||subst(C[6],y,ZP)!=0,error("minimal polynomials"));if(subst(lift(TH),w,SG)!=TH||subst(lift(ZP),w,TA)!=ZP,error("fixed fields"));if(TH!=5*(T[1]+ellmul(S[1],T,2)[1])||ZP!=5*T[1],error("generator meanings"));if(subst(subst(lift(C[8]),y,TH),x,T[1])!=0||subst(subst(C[9],y,ZP),x,T[2])!=0,error("relative equations"));N6=nfinit(C[4]);N12=nfinit(C[6]);if(N6.disc!=read("nf6.gp").disc||N12.disc!=read("nf12.gp").disc||N6.sign!=[2,2]||N12.sign!=[4,4],error("field invariants"));print("RELATIVE_FIELDS_REPLAY_PASS");}
main();quit;
