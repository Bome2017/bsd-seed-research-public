{alarm(8);NF=read("../inputs/nf.gp");TA=read("../inputs/basis_scalar_matrix.gp")^3;AR=apply(eval,readstr("adaptation_checks.gp"));TJ=vector(#AR,j,mathnf(TA*AR[j][4]));count=0;for(i=2,#AR,for(j=1,i-1,for(t=0,1,if(AR[i][4]==if(t,TJ[j],AR[j][4]),my(v=nfeltdiv(NF,AR[i][3],if(t,TA*AR[j][3],AR[j][3])),iv=nfeltdiv(NF,if(t,TA*AR[j][3],AR[j][3]),AR[i][3]));if(denominator(v,1)!=1 || denominator(iv,1)!=1 || abs(nfeltnorm(NF,v))!=1,error("paired unit"));write("PAIR_MATCHES.gp",[i,j,t,v]);count++;print("PAIRED_UNIT_MATCH=",[i,j,t])))));write("PAIR_RESULT.json",[#AR,#AR*(#AR-1)/2,2*#AR*(#AR-1)/2,count]);print("PAIRED_IDEAL_CHECK_DONE=",count);quit;}
