{alarm(25);NF=read("../inputs/nf.gp");AM=read("../inputs/basis_scalar_matrix.gp");TA=AM^3;print("NF_DIMS=",vector(#NF[5],i,if(type(NF[5][i])=="t_MAT",matsize(NF[5][i]),type(NF[5][i]))));MM=precision(NF[5][1],70);rr=NF.sign[1];cc=NF.sign[2];perm=vector(rr+cc);dist=vector(rr+cc);for(i=1,rr+cc,my(row=MM[i,]*TA,ds=vector(rr+cc,j,min(norml2(row-MM[j,]),norml2(row-conj(MM[j,])))),idx=vecsort(vector(#ds,j,[ds[j],j])));perm[i]=idx[1][2];dist[i]=[idx[1][1],idx[2][1]]);print("PLACE_PERM=",perm);print("DISTANCES=",dist);II=List();listput(II,["O",matid(48),1]);for(k=1,3,my(q=[7,11,47][k],pp=idealprimedec(NF,q));for(j=1,#pp,my(HH=idealhnf(NF,pp[j]));if(mathnf(TA*HH)!=HH,error("not stable"));listput(II,[Str(q,"_",j),HH,idealnorm(NF,HH)])));write("setup.gp",[perm,Vec(II)]);print("SETUP_DONE_IDEALS=",#II);quit;}
