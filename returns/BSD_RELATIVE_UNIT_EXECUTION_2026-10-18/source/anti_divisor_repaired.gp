pack(a)={my(b=lift(a),den=denominator(b,1));[vector(48,i,polcoef(b*den,i-1,w)),den]};
{alarm(57);NF=read("../inputs/nf.gp");C=read("../inputs/field.gp");AM=read("../inputs/basis_scalar_matrix.gp");TA=AM^3;AR=apply(eval,readstr("adaptation_checks.gp"));FR=List();PP=List();for(k=1,#AR,my(v=AR[k][3],ff=idealfactor(NF,v),ids=vector(matsize(ff)[1],i,idealhnf(NF,ff[i,1])),ex=Vec(ff[,2]));if(idealhnf(NF,v)!=idealfactorback(NF,ids,ex),error("factor reconstruction"));my(tids=vector(#ids,i,mathnf(TA*ids[i])));if(idealhnf(NF,TA*v)!=idealfactorback(NF,tids,ex),error("tau factor reconstruction"));write("anti_factor_records.gp",[k,v,ids,ex,tids]);listput(FR,[ids,ex,tids]);for(i=1,#ids,listput(PP,ids[i]);listput(PP,tids[i]));print("ANTI_FACTOR_AUTH=",k));FR=Vec(FR);PS=Set(Vec(PP));DD=matrix(#PS,#AR);for(j=1,#AR,for(i=1,#FR[j][1],DD[setsearch(PS,FR[j][1][i]),j]+=FR[j][2][i];DD[setsearch(PS,FR[j][3][i]),j]-=FR[j][2][i]));KK=matkerint(DD);if(DD*KK!=matrix(#PS,matsize(KK)[2]),error("integer anti divisor kernel"));write("ANTI_DIVISOR_DATA.gp",[PS,DD,KK]);m=#AR;nc=matsize(KK)[2];EE=matrix(6*m,nc,i,j,if((i-1)%6==0,KK[(i-1)\6+1,j],if((i-1)%6==3,-KK[(i-1)\6+1,j],0)));if(nc>0,write("anti_compact_units_eval.json",[vector(49,i,polcoef(C[4],i-1,w)),pack(C[6][1]),pack(C[6][2]),pack(C[7]),vector(m,j,pack(nfbasistoalg(NF,AR[j][3]))),vector(6*m,i,Vec(EE[i,]))]));write("ANTI_DIVISOR_RESULT.json",[#AR,#PS,matrank(DD),matrank(Mod(DD,7)),nc]);print("ANTI_DIVISOR_CHECK_COMPLETE=",[#AR,#PS,matrank(DD),matrank(Mod(DD,7)),nc]);quit;}
