pack(a)={my(b=lift(a),den=denominator(b,1));[vector(48,i,polcoef(b*den,i-1,w)),den]};
exportunits(A,C)={my(m=#A,KK=matrix(6*m,m,i,j,if(i==6*j-5,1,if(i==6*j-2,-1,0))));write("compact_units_eval.json",[vector(49,i,polcoef(C[4],i-1,w)),pack(C[6][1]),pack(C[6][2]),pack(C[7]),vector(m,j,pack(nfbasistoalg(NF,A[j][3]))),vector(6*m,i,Vec(KK[i,]))]);};
{alarm(177);default(realprecision,180);NF=read("../inputs/nf.gp");C=read("../inputs/field.gp");AM=read("../inputs/basis_scalar_matrix.gp");TA=AM^3;SU=read("setup.gp");PER=SU[1];IDS=SU[2];MM=precision(NF[5][1],180);r1=NF.sign[1];r2=NF.sign[2];PA=select(i->PER[i]>i,vector(r1+r2,i,i));if(#PA!=12,error("pair count"));GG=matrix(48,48,i,j,if(i<=r1,real(MM[i,j]),if((i-r1)%2,sqrt(2)*real(MM[r1+(i-r1+1)/2,j]),sqrt(2)*imag(MM[r1+(i-r1)/2,j]))));dirs=vector(16,d,vector(27,i,0));for(d=1,16,for(h=1,12,my(a=PA[h],v=if(d<=12,if(d==h,1,0),if(bittest(h-1,d-13),-1,1)));dirs[d][a]=v;dirs[d][PER[a]]=-v));for(d=1,16,for(i=1,27,if(dirs[d][PER[i]]!=-dirs[d][i],error("weight parity"))));write("WEIGHT_DIRECTIONS.gp",[PA,dirs]);SEEN=Map();USEEN=Map();ADS=List();stages=0;trials=0;pure=0;dups=0;levels=[2,4,8,16,32,64];start=getwalltime();for(lev=1,#levels,for(d=1,16,my(ww=levels[lev]*dirs[d],WG=matrix(48,48,i,j,2^ww[if(i<=r1,i,r1+(i-r1+1)\2)]*GG[i,j]),IG=round(2^192*WG));for(id=1,#IDS,my(HH=IDS[id][2],NN=IDS[id][3],TT=qflll(IG*HH),BB=HH*TT,L=List());if(abs(matdet(TT))!=1,error("LLL non-unimodular"));for(i=1,12,listput(L,BB[,i]));for(i=2,4,for(j=1,i-1,listput(L,BB[,i]+BB[,j]);listput(L,BB[,i]-BB[,j])));stages++;for(c=1,#L,my(v=L[c],tv=TA*v);if(v==tv || v==-tv,pure++;next);my(key=vecsort([v,-v])[1]);if(mapisdefined(SEEN,key),dups++;next);mapput(SEEN,key,1);trials++;my(nm=nfeltnorm(NF,v));write("norm_trials.gp",[stages,lev,d,id,c,nm]);if(abs(nm)==NN,my(mem=matsolve(HH,v));if(denominator(mem,1)!=1,error("membership"));if(mathnf(TA*HH)!=HH,error("ideal stability"));if(idealhnf(NF,v)!=HH,error("principal ideal equality"));my(ep=nfeltdiv(NF,v,tv),ei=nfeltdiv(NF,tv,v));if(denominator(ep,1)!=1 || denominator(ei,1)!=1 || nfeltnorm(NF,ep)!=1,error("unit acceptance"));if(!mapisdefined(USEEN,ep),mapput(USEEN,ep,1);listput(ADS,[stages,IDS[id][1],v,HH,NN,ep]);write("admissions.gp",ADS[#ADS]);print("RELATIVE_UNIT_ADMITTED=",#ADS,";STAGE=",stages,";IDEAL=",IDS[id][1],";TRIALS=",trials,";WALL_MS=",getwalltime()-start);if(#ADS>=8,exportunits(Vec(ADS),C);print("SEARCH_STOP_UNIT_CAP");quit))));print("CHECKPOINT stage=",stages," amplitude=",levels[lev]," direction=",d," ideal=",id," exact_norms=",trials," pure_skips=",pure," duplicates=",dups," admitted=",#ADS," wall_ms=",getwalltime()-start))));exportunits(Vec(ADS),C);print("SEARCH_SCHEDULE_COMPLETE");quit;}
