pack(a)={my(b=lift(a),den=denominator(b,1));[vector(48,i,polcoef(b*den,i-1,w)),den]};
exportunits(A,C)={my(m=#A,KK=matrix(6*m,m,i,j,if(i==6*j-5,1,if(i==6*j-2,-1,0))));write("compact_units_eval.json",[vector(49,i,polcoef(C[4],i-1,w)),pack(C[6][1]),pack(C[6][2]),pack(C[7]),vector(m,j,pack(nfbasistoalg(NF,A[j][3]))),vector(6*m,i,Vec(KK[i,]))]);};
{alarm(57);default(realprecision,180);NF=read("../inputs/nf.gp");C=read("../inputs/field.gp");AM=read("../inputs/basis_scalar_matrix.gp");TA=AM^3;SU=read("setup.gp");IDS=SU[2];DD=read("WEIGHT_DIRECTIONS.gp")[2];MM=precision(NF[5][1],180);r1=NF.sign[1];r2=NF.sign[2];GG=matrix(48,48,i,j,if(i<=r1,real(MM[i,j]),if((i-r1)%2,sqrt(2)*real(MM[r1+(i-r1+1)/2,j]),sqrt(2)*imag(MM[r1+(i-r1)/2,j]))));levels=[2,4,8,16,32,64];SR=read("DIAGNOSTIC_TOP20.json");CACHE=Map();for(k=1,#SR,my(z=SR[k],stage=z[2],lev=z[3],d=z[4],id=z[5],c=z[6],BB);if(!mapisdefined(CACHE,stage,&BB),my(ww=levels[lev]*DD[d],WG=matrix(48,48,i,j,2^ww[if(i<=r1,i,r1+(i-r1+1)\2)]*GG[i,j]),TT=qflll(round(2^192*WG)*IDS[id][2]));if(abs(matdet(TT))!=1,error("LLL non-unimodular"));BB=IDS[id][2]*TT;mapput(CACHE,stage,BB));my(L=List());for(i=1,12,listput(L,BB[,i]));for(i=2,4,for(j=1,i-1,listput(L,BB[,i]+BB[,j]);listput(L,BB[,i]-BB[,j])));my(v=L[c],tv=TA*v,nm=nfeltnorm(NF,v));if(nm!=z[7],error("reconstruction norm mismatch"));if(v==tv || v==-tv,error("not mixed"));my(JJ=idealhnf(NF,v),stable=mathnf(TA*JJ)==JJ);write("adaptation_checks.gp",[k,z,v,JJ,stable]);print("ACTUAL_IDEAL_CHECK=",k,";STABLE=",stable);if(stable,if(idealnorm(NF,JJ)!=abs(nm) || denominator(matsolve(JJ,v),1)!=1,error("exact ideal norm/membership"));my(ep=nfeltdiv(NF,v,tv),ei=nfeltdiv(NF,tv,v));if(denominator(ep,1)!=1 || denominator(ei,1)!=1 || nfeltnorm(NF,ep)!=1,error("unit acceptance"));my(A=[stage,Str("actual_principal_",k),v,JJ,abs(nm),ep]);write("admissions.gp",A);exportunits([A],C);print("RELATIVE_UNIT_ADMITTED_FROM_ACTUAL_IDEAL=",k);quit));print("ADAPTATION_PANEL_COMPLETE_NO_STABLE_IDEAL");quit;}
