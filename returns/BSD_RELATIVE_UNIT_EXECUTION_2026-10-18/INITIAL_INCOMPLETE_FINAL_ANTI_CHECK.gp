{alarm(15);NF=read("inputs/nf.gp");TA=read("inputs/basis_scalar_matrix.gp")^3;AR=apply(eval,readstr("source/adaptation_checks.gp"));FR=apply(eval,readstr("source/anti_factor_records.gp"));A=read("source/ANTI_DIVISOR_DATA.gp");if(#FR!=20 || #AR!=20,error("recordcount"));PS=A[1];D=matrix(#PS,20);for(k=1,20,my(fr=FR[k],v=fr[2]);if(fr[1]!=k || v!=AR[k][3],error("candidatebinding"));if(idealhnf(NF,v)!=idealfactorback(NF,fr[3],fr[4]),error("factor reconstruction"));for(j=1,#fr[3],if(mathnf(TA*fr[3][j])!=fr[5][j],error("tau HNF mismatch")));if(idealhnf(NF,TA*v)!=idealfactorback(NF,fr[5],fr[4]),error("tau factor reconstruction"));for(j=1,#fr[3],D[setsearch(PS,fr[3][j]),k]+=fr[4][j];D[setsearch(PS,fr[5][j]),k]-=fr[4][j]));if(D!=A[2],error("matrix mismatch"));if(matsize(D)!=[127,20] || matrank(Mod(D,7))!=20 || matsize(A[3])!=[20,0],error("rank/kernel mismatch"));write("FINAL_ANTI_MATRIX.json",vector(127,i,Vec(D[i,])));print("ANTI_FACTORS_AND_MATRIX_REPLAY_PASS=[20,127,20,0]");quit;}
