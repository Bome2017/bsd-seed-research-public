{alarm(20);default(realprecision,180);NF=read("../inputs/nf.gp");AM=read("../inputs/basis_scalar_matrix.gp");TA=AM^3;SU=read("../source/setup.gp");WW=read("../source/WEIGHT_DIRECTIONS.gp");DD=WW[2];PP=SU[1];for(d=1,#DD,if(DD[d]==vector(27),error("zero direction"));for(i=1,27,if(DD[d][PP[i]]!=-DD[d][i],error("parity"))));MM=precision(NF[5][1],180);r1=NF.sign[1];GG=matrix(48,48,i,j,if(i<=r1,real(MM[i,j]),if((i-r1)%2,sqrt(2)*real(MM[r1+(i-r1+1)/2,j]),sqrt(2)*imag(MM[r1+(i-r1)/2,j]))));RR=vector(#DD);for(d=1,#DD,my(IG=round(2^192*matrix(48,48,i,j,2^(2*DD[d][if(i<=r1,i,r1+(i-r1+1)\2)])*GG[i,j])),G=IG~*IG,H=TA~*G*TA-G);if(H==matrix(48,48),error("commuting metric"));RR[d]=1.*vecmax(abs(Vec(H)))/vecmax(abs(Vec(G))));print("WEIGHT_PARITY_AND_METRIC_ASYMMETRY_PASS=",#DD);print("METRIC_RATIOS=",RR);quit;}
