{alarm(20);NF=read("../inputs/nf.gp");AM=read("../inputs/basis_scalar_matrix.gp");TA=AM^3;SS=read("../source/setup.gp");if(TA^2!=matid(48),error("not involution"));II=SS[2];for(j=1,#II,my(I=II[j][2]);if(mathnf(TA*I)!=I,error("not stable"));if(denominator(I)!=1,error("nonintegral ideal"));if(idealhnf(NF,I)!=I,error("not ideal HNF"));if(idealnorm(NF,I)!=II[j][3],error("norm mismatch")));PP=SS[1];if(vecsort(PP)!=vector(#PP,j,j),error("place map not permutation"));for(j=1,#PP,if(PP[PP[j]]!=j,error("place map not involution")));print("STABLE_IDEALS_INDEPENDENT_PASS=",#II);print("PLACE_PAIR_COUNTS=",[#select(j->PP[j]==j,vector(#PP,j,j)),sum(j=1,#PP,PP[j]>j)]);quit;}
