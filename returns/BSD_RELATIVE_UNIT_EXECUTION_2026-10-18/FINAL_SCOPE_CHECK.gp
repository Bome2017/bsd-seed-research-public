{alarm(12);NF=read("inputs/nf.gp");TA=read("inputs/basis_scalar_matrix.gp")^3;AR=apply(eval,readstr("source/adaptation_checks.gp"));if(#AR!=20,error("panel count"));JJ=vector(20);TJ=vector(20);for(k=1,20,my(v=AR[k][3]);if(denominator(v,1)!=1,error("nonintegral"));if(v==TA*v || v==-TA*v,error("not mixed"));if(nfeltnorm(NF,v)!=AR[k][2][7],error("norm mismatch"));JJ[k]=idealhnf(NF,v);if(JJ[k]!=AR[k][4],error("ideal mismatch"));TJ[k]=mathnf(TA*JJ[k]);if(JJ[k]==TJ[k] || AR[k][5]!=0,error("stable discrepancy")));count=0;for(i=2,20,for(j=1,i-1,count+=(JJ[i]==JJ[j])+(JJ[i]==TJ[j])));if(count!=0,error("pair found"));print("PANEL_EXACT_REPLAY_PASS=20");print("PAIRED_COMPARISONS=380;MATCHES=",count);quit;}
