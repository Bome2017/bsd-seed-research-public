alarm(90);read("inputs/lib/cubinv.gp");read("inputs/lib/classimg.gp");read("inputs/lib/selmer.gp");D=read("inputs/data.gp");nf=read("inputs/nf.gp");E=D[1];ps=D[4];T=D[5];G=D[6];ng=#G;LI=D[16];LPRECLOG=List();setrand(20261015);Rows=[;];
{for(i=1,#ps,my(l=ps[i],Dl=[locdata(nf,pr)|pr<-idealprimedec(nf,l)],Bl=lockummer(E,nf,T,l,Dl,45),Ml=matconcat(vector(ng,j,Mod(concat(vector(#Dl,q,locvec(nf,G[j],Dl[q]))),3)~)),Rr=if(Bl[2]==0,Ml,matker(Bl[1]~)~*Ml));if(matrank(matconcat([Rr;LI[i][5]]))!=matrank(Rr)||matrank(Rr)!=matrank(LI[i][5]),error("local rowspace changed"));Rows=if(#Rows,matconcat([Rows;Rr]),Rr);print("GUARDED_LOCAL_ROWSPACE_MATCH=",l));}
LC=Vec(LPRECLOG);CERTS=List();MINM=10^9;
{for(i=1,#LC,my(l=LC[i][1],xx=LC[i][2],yy=LC[i][3],F=yy^2+E.a1*xx*yy+E.a3*yy-xx^3-E.a2*xx^2-E.a4*xx-E.a6,Fp=2*yy+E.a1*xx+E.a3,Nc=LC[i][4],mar=LC[i][5]);if(F!=0,if(valuation(F,l)<=2*valuation(Fp,l),error("Hensel inequality fails"));Nc=valuation(F,l)-valuation(Fp,l));for(j=1,#mar,my(margin=mar[j][1]*Nc-mar[j][2]-mar[j][3]);if(margin<0,error("local cubeclass precision fails"));MINM=min(MINM,margin));listput(CERTS,[l,xx,yy,F,Fp,Nc,mar]));}
write("local_precision.gp",[LC,Vec(CERTS)]);write("local_precision.json","[");
{for(i=1,#CERTS,my(c=CERTS[i]);write("local_precision.json","{\"prime\":",c[1],",\"x\":\"",c[2],"\",\"y\":\"",c[3],"\",\"F\":\"",c[4],"\",\"Fp\":\"",c[5],"\",\"certified_precision\":",c[6],",\"prime_ideal_data\":",c[7],"}",if(i<#CERTS,",","")));}
write("local_precision.json","]");print("EXACT_HENSEL_LOCAL_SAMPLES=",#CERTS,";MINIMUM_CUBE_PRECISION_MARGIN=",MINM);write("local_authenticated.gp",[Rows,LC,Vec(CERTS)]);print("LOCAL_CERTIFICATION_COMPLETE");quit;
