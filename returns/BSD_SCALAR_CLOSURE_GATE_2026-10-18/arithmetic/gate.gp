rows(M,n,m)=vector(n,i,vector(m,j,lift(M[i,j])));
push(M,P)={my(n=#P,m=matsize(M)[2],B=matrix(n,m));for(i=1,n,for(j=1,m,B[P[i],j]=M[i,j]));B};
{alarm(57);gettime();NF=read("../inputs/nf.gp");C=read("../inputs/field.gp");AM=read("../inputs/basis_scalar_matrix.gp");FR=apply(eval,readstr("../inputs/anti_factor_records.gp"));if(#FR!=20,error("source count"));if(NF.pol!=C[4],error("field polynomial"));if(AM^6!=matid(48),error("matrix order"));for(j=1,48,if(nfalgtobasis(NF,nfgaloisapply(NF,C[7],NF.zk[j]))!=AM[,j],error("basis scalar mismatch")));T=C[6];T3=ellmul(C[1],T,3);if(nfgaloisapply(NF,C[7],T[1])!=T3[1] || nfgaloisapply(NF,C[7],T[2])!=T3[2],error("scalar point mismatch"));print("FIELD_SCALAR_BINDING_PASS;MS=",gettime());PP=List();POW=vector(6,j,AM^(j-1));for(k=1,#FR,for(h=1,#FR[k][3],for(j=1,6,listput(PP,mathnf(POW[j]*FR[k][3][h])))));PS=Set(Vec(PP));n=#PS;PER=vector(n,i,setsearch(PS,mathnf(AM*PS[i])));if(vecmin(PER)==0 || Set(PER)!=vector(n,i,i),error("closed support permutation"));for(i=1,n,my(j=i);for(k=1,6,j=PER[j]);if(j!=i,error("permutation order")));DA=matrix(n,20);for(k=1,20,for(h=1,#FR[k][3],DA[setsearch(PS,FR[k][3][h]),k]+=FR[k][4][h]));DB=DA;for(j=1,3,DB=push(DB,PER));DB=DA-DB;DTA=DB;for(j=1,3,DTA=push(DTA,PER));if(DTA!=-DB,error("tau inverse"));TR=vector(6);TR[1]=DB;for(j=2,6,TR[j]=push(TR[j-1],PER));if(push(TR[6],PER)!=DB,error("translate order"));FULL=matrix(n,120,i,j,TR[(j-1)%6+1][i,(j-1)\6+1]);CH=[3,5,6];WW=vector(3,h,vector(6,j,lift(6*Mod(CH[h],7)^(-(j-1)))));PROJ=vector(3);KER=vector(3);RK=vector(3);for(h=1,3,PROJ[h]=Mod(sum(j=1,6,WW[h][j]*TR[j]),7);if(push(PROJ[h],PER)!=CH[h]*PROJ[h],error("projector eigenvalue"));KER[h]=matker(PROJ[h]);RK[h]=matrank(PROJ[h]);if(PROJ[h]*KER[h]!=matrix(n,matsize(KER[h])[2]),error("nullspace")));if(PROJ[1]+PROJ[2]+PROJ[3]!=Mod(DB,7),error("odd character decomposition"));write("GATE_DATA.gp",[PS,PER,DA,DB,FULL,CH,WW,PROJ,KER,RK]);write("GATE_CORE.json",[vector(n,k,rows(PS[k],48,48)),PER,rows(DA,n,20),rows(DB,n,20),rows(FULL,n,120),CH,WW,vector(3,h,rows(PROJ[h],n,20)),vector(3,h,rows(KER[h],20,20-RK[h])),RK]);write("GATE_RESULT.json",[n,20,120,matrank(FULL),matrank(Mod(FULL,7)),CH,RK,vector(3,h,20-RK[h])]);print("SCALAR_CLOSURE_GATE_COMPLETE=",[n,20,120,matrank(FULL),matrank(Mod(FULL,7)),CH,RK,vector(3,h,20-RK[h])],";MS=",gettime());quit;}
