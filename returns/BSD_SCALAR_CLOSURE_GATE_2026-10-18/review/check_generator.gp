{alarm(15);NF=read("../inputs/nf.gp");AM=read("../inputs/basis_scalar_matrix.gp");C=read("../inputs/field.gp");F=C[4];if(NF.pol!=F,error("field mismatch"));if(AM^6!=matid(48) || AM^3==matid(48),error("scalarorder"));vv=nfalgtobasis(NF,Mod(w,F));if(nfbasistoalg(NF,AM*vv)!=C[7],error("matrixgenerator mismatch"));P=C[6];E=ellinit(C[1]);Q=ellmul(E,P,3);for(j=1,2,if(nfgaloisapply(NF,C[7],P[j])!=Q[j],error("not scalar3")));print("ACTUAL_SCALAR_GENERATOR_PASS=3;ORDER=6");quit;}
