mkmat(V)=matrix(#V,#V[1],i,j,V[i][j]);
{alarm(15);AM=read("../inputs/basis_scalar_matrix.gp");J=read("../arithmetic/GATE_CORE.json");FR=apply(eval,readstr("../inputs/anti_factor_records.gp"));PS=apply(mkmat,J[1]);PER=J[2];if(#PS!=331 || Set(PS)!=PS || Set(PER)!=vector(331,i,i),error("supportschema"));for(i=1,331,if(mathnf(AM*PS[i])!=PS[PER[i]],error("actualscalarprime mismatch")));DA=matrix(331,20);for(k=1,20,for(h=1,#FR[k][3],my(ix=setsearch(PS,FR[k][3][h]));if(ix==0,error("supportmissing"));DA[ix,k]+=FR[k][4][h]));if(DA!=mkmat(J[3]),error("actualdivisor mismatch"));print("ACTUAL_PRIME_ACTION_AND_BASE_DIVISORS_PASS=[331,20]");quit;}
